{
  "comments": {
    "lineComment": "#"
  },
  "colorizedBracketPairs": [
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:-\\s+)?[^#\\s][^:]*:\\s*$|^\\s*node\\s+\\S+\\s+\\S+.*$|^\\s*var\\s+\\S+.*$|^\\s*(?:group|comment|decorator)\\s+.*$",
    "decreaseIndentPattern": "^\\s*[\\]}](?!.*[\\[{])"
  },
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*.*:\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*-\\s+.*$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\s#\"':,\\[\\]{}]+)"
}
