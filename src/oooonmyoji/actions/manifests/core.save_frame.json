{
  "schema_version": 2,
  "name": "core.save_frame",
  "version": "1.0.0",
  "entry": "builtin:SaveFrameAction",
  "description": "把最近一帧保存到当前运行的产物目录。输出 { path }。",
  "parameters": {
    "name": {
      "type": "string",
      "required": true,
      "min_length": 1,
      "description": "保存到产物目录的文件名，如 01-launcher.png"
    }
  },
  "outputs": {
    "type": "object",
    "properties": {
      "path": { "type": "string" }
    },
    "additionalProperties": false
  },
  "effects": { "side_effect": false, "retry": "safe" }
}
