{
  "schema_version": 2,
  "name": "input.dismiss_template_until_text",
  "version": "1.0.0",
  "entry": "builtin:DismissTemplateUntilTextAction",
  "description": "持续点击重复出现的模板提示，直到目标页面文本稳定出现。适合多层奖励和结算覆盖层。",
  "parameters": {
    "match": { "type": "object", "required": true },
    "template": { "type": "asset", "required": true },
    "template_roi": { "type": "rect" },
    "done_texts": { "type": "array", "default": [], "items": { "type": "string", "min_length": 1 } },
    "done_roi": { "type": "rect" },
    "done_states": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "required": true, "min_length": 1 },
          "template": { "type": "asset" },
          "roi": { "type": "rect" },
          "threshold": { "type": "number", "default": 0.85, "min": 0, "max": 1 },
          "scale_search": { "type": "boolean", "default": false },
          "texts": { "type": "array", "items": { "type": "string", "min_length": 1 }, "default": [] },
          "text_roi": { "type": "rect" },
          "min_confidence": { "type": "number", "default": 0, "min": 0, "max": 1 }
        }
      }
    },
    "allow_ocr": { "type": "boolean", "default": true },
    "timeout_seconds": { "type": "duration", "default": 30, "min": 0.1 },
    "max_clicks": { "type": "integer", "default": 6, "min": 1 },
    "threshold": { "type": "number", "default": 0.85, "min": 0, "max": 1 },
    "post_click_delay": { "type": "duration", "default": 0.8, "min": 0 },
    "stable_seconds": { "type": "duration", "default": 0.5, "min": 0 },
    "hold_ms": { "type": "integer", "default": 0, "min": 0 },
    "random_offset": { "type": "integer", "default": 0, "min": 0 },
    "random_interval": { "type": "array", "items": { "type": "duration", "min": 0 }, "min_items": 2, "max_items": 2, "default": [0, 0] }
  },
  "card": {
    "rows": [
      { "param": "match", "label": "匹配配置", "control": "inspector" },
      { "param": "template", "label": "模板" },
      { "param": "timeout_seconds", "label": "超时" },
      { "param": "threshold", "label": "匹配阈值" },
      { "param": "max_clicks", "label": "最大点击次数" },
      { "param": "allow_ocr", "label": "允许 OCR", "on_label": "允许", "off_label": "不允许" },
      { "param": "post_click_delay", "label": "点击后延迟（秒）" },
      { "param": "done_texts", "label": "完成文字", "control": "inspector" }
    ]
  },
  "outputs": {
    "type": "object",
    "properties": {
      "click_count": { "type": "integer" },
      "clicks": { "type": "array", "items": { "type": "object" } },
      "matched_text": { "type": "string" },
      "final_state": { "type": "string" },
      "source": { "type": "string" },
      "confidence": { "type": "number" }
    },
    "additionalProperties": false
  },
  "effects": { "side_effect": true, "retry": "unsafe" }
}
