{
  "schema_version": 2,
  "name": "input.recover_state",
  "version": "1.0.0",
  "entry": "builtin:RecoverStateAction",
  "description": "从已识别页面执行有限且逐步确认的恢复动作；覆盖层点击与返回次数分别限流，失败保存现场图。",
  "parameters": {
    "states": {
      "type": "array",
      "required": true,
      "min_items": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "required": true, "min_length": 1 },
          "template": { "type": "asset" },
          "roi": { "type": "rect" },
          "threshold": { "type": "number", "default": 0.85, "min": 0, "max": 1 },
          "scale_search": { "type": "boolean", "default": false },
          "texts": { "type": "array", "items": { "type": "string", "min_length": 1 }, "default": [] },
          "text_roi": { "type": "rect" },
          "min_confidence": { "type": "number", "default": 0, "min": 0, "max": 1 }
        }
      }
    },
    "target_states": { "type": "array", "required": true, "min_items": 1, "items": { "type": "string", "min_length": 1 } },
    "overlay_states": { "type": "array", "default": [], "items": { "type": "string", "min_length": 1 } },
    "transitions": {
      "type": "array",
      "required": true,
      "items": {
        "type": "object",
        "properties": {
          "from": { "type": "string", "required": true, "min_length": 1 },
          "type": { "type": "string", "required": true, "enum": ["tap_match", "tap_template", "tap", "key"] },
          "template": { "type": "asset" },
          "roi": { "type": "rect" },
          "threshold": { "type": "number", "default": 0.85, "min": 0, "max": 1 },
          "scale_search": { "type": "boolean", "default": false },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "keycode": { "type": "string" },
          "expected_states": { "type": "array", "default": [], "items": { "type": "string", "min_length": 1 } },
          "retry_if_unchanged_seconds": { "type": "number", "min": 0, "description": "页面保持不变达到该时长后，按有限转移次数重试" },
          "return_action": { "type": "boolean", "default": false }
        }
      }
    },
    "allow_ocr": { "type": "boolean", "default": true },
    "timeout_seconds": { "type": "number", "default": 15, "min": 0.1 },
    "initial_state_timeout_seconds": { "type": "number", "default": 0, "min": 0, "description": "初始加载画面的模板轮询时间，结束后才尝试一次 OCR" },
    "confirm_timeout_seconds": { "type": "number", "default": 5, "min": 0.1 },
    "poll_interval_seconds": { "type": "number", "default": 0.1, "min": 0 },
    "post_action_delay": { "type": "number", "default": 0.35, "min": 0 },
    "max_return_attempts": { "type": "integer", "default": 3, "min": 1 },
    "max_overlay_clicks": { "type": "integer", "default": 6, "min": 1 },
    "max_transitions": { "type": "integer", "default": 12, "min": 1 },
    "failure_frame_name": { "type": "string", "default": "recovery-failure.png", "min_length": 1 },
    "hold_ms": { "type": "integer", "default": 0, "min": 0 },
    "random_offset": { "type": "integer", "default": 0, "min": 0 },
    "random_interval": { "type": "array", "items": { "type": "number", "min": 0 }, "min_items": 2, "max_items": 2, "default": [0, 0] }
  },
  "outputs": {
    "type": "object",
    "properties": {
      "state": { "type": "string" },
      "source": { "type": "string" },
      "confidence": { "type": "number" },
      "match": { "type": "object" },
      "actions": { "type": "array", "items": { "type": "object" } },
      "return_attempts": { "type": "integer" },
      "overlay_clicks": { "type": "integer" },
      "elapsed_seconds": { "type": "number" },
      "failure_frame": { "type": "string" }
    },
    "required": ["state", "source", "confidence", "match", "actions", "return_attempts", "overlay_clicks", "elapsed_seconds", "failure_frame"],
    "additionalProperties": false
  },
  "effects": { "side_effect": true, "retry": "unsafe" }
}
