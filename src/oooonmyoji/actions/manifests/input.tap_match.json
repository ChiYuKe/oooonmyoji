{
  "schema_version": 2,
  "name": "input.tap_match",
  "version": "1.0.0",
  "entry": "builtin:TapMatchAction",
  "description": "点击匹配结果中心，可配置随机偏移和随机点击前等待。开启重新校验后，每次执行都会先重新确认模板仍在画面中；开启 verify_gone 后，点击节点会在自身内部确认原模板消失，确认失败时由 Retry 只重试当前点击节点。输出实际点击坐标、偏移量和等待间隔。",
  "parameters": {
    "match": {
      "type": "object",
      "required": true,
      "description": "匹配对象，通常引用 nodes.<node>.output.0"
    },
    "revalidate": {
      "type": "boolean",
      "default": true,
      "description": "点击前重新截图验证匹配是否仍在，默认 true"
    },
    "disappeared_states": {
      "type": "array",
      "default": [],
      "description": "复核时原模板已消失后允许确认的下一状态；命中时不点击并返回成功",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "required": true, "min_length": 1 },
          "template": { "type": "asset" },
          "roi": { "type": "rect" },
          "threshold": { "type": "number", "default": 0.85, "min": 0, "max": 1 }
        }
      }
    },
    "disappeared_state_timeout_seconds": {
      "type": "duration",
      "default": 0,
      "min": 0,
      "description": "原模板消失后等待允许下一状态的最长时间"
    },
    "hold_ms": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "description": "按住毫秒数，默认 0"
    },
    "random_offset": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "description": "在匹配中心 X/Y 方向分别随机偏移的最大像素数，默认 0"
    },
    "random_interval": {
      "type": "array",
      "items": { "type": "duration", "min": 0 },
      "min_items": 2,
      "max_items": 2,
      "default": [0, 0],
      "description": "点击前随机等待区间 [最小秒数, 最大秒数]，默认 [0, 0]"
    },
    "verify_gone": {
      "type": "boolean",
      "default": false,
      "description": "点击后在当前节点内部确认原模板消失；失败时当前节点可由 Retry 重试"
    },
    "verify_timeout_seconds": {
      "type": "duration",
      "default": 8,
      "min": 0,
      "description": "确认原模板消失的最长等待时间，默认 8 秒"
    }
  },
  "card": {
    "rows": [
      { "param": "match", "label": "匹配配置", "control": "inspector" },
      { "param": "revalidate", "label": "重新校验", "on_label": "校验", "off_label": "跳过" },
      { "param": "verify_gone", "label": "确认模板消失", "on_label": "校验", "off_label": "跳过" },
      { "param": "verify_timeout_seconds", "label": "确认消失超时（秒）" },
      { "param": "disappeared_state_timeout_seconds", "label": "消失状态超时（秒）" },
      { "param": "hold_ms", "label": "按压时长（毫秒）" },
      { "param": "random_offset", "label": "随机偏移（px）" },
      { "param": "random_interval", "label": "随机间隔（秒）" },
      { "param": "disappeared_states", "label": "消失状态列表", "control": "inspector" }
    ]
  },
  "outputs": {
    "type": "object",
    "properties": {
      "origin_x": { "type": "integer" },
      "origin_y": { "type": "integer" },
      "x": { "type": "integer" },
      "y": { "type": "integer" },
      "offset_x": { "type": "integer" },
      "offset_y": { "type": "integer" },
      "interval_seconds": { "type": "number" },
      "revalidated": { "type": "boolean" },
      "skipped": { "type": "boolean" },
      "final_state": { "type": "string" },
      "verified_gone": { "type": "boolean" }
    },
    "additionalProperties": false
  },
  "effects": { "side_effect": true, "retry": "safe" }
}
