{
  "schema_version": 2,
  "name": "input.tap_match",
  "version": "1.0.0",
  "entry": "builtin:TapMatchAction",
  "description": "点击匹配结果中心，可配置随机偏移和随机点击前等待。有输入副作用，默认不可自动重试。输出实际点击坐标、偏移量和等待间隔。",
  "parameters": {
    "match": {
      "type": "object",
      "required": true,
      "description": "匹配对象，通常引用 nodes.<node>.output.0"
    },
    "revalidate": {
      "type": "boolean",
      "default": true,
      "description": "点击前重新截图验证匹配是否仍在，默认 true"
    },
    "disappeared_states": {
      "type": "array",
      "default": [],
      "description": "复核时原模板已消失后允许确认的下一状态；命中时不点击并返回成功",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "required": true, "min_length": 1 },
          "template": { "type": "asset" },
          "roi": { "type": "rect" },
          "threshold": { "type": "number", "default": 0.85, "min": 0, "max": 1 }
        }
      }
    },
    "disappeared_state_timeout_seconds": {
      "type": "number",
      "default": 0,
      "min": 0,
      "description": "原模板消失后等待允许下一状态的最长时间"
    },
    "hold_ms": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "description": "按住毫秒数，默认 0"
    },
    "random_offset": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "description": "在匹配中心 X/Y 方向分别随机偏移的最大像素数，默认 0"
    },
    "random_interval": {
      "type": "array",
      "items": { "type": "number", "min": 0 },
      "min_items": 2,
      "max_items": 2,
      "default": [0, 0],
      "description": "点击前随机等待区间 [最小秒数, 最大秒数]，默认 [0, 0]"
    }
  },
  "outputs": {
    "type": "object",
    "properties": {
      "origin_x": { "type": "integer" },
      "origin_y": { "type": "integer" },
      "x": { "type": "integer" },
      "y": { "type": "integer" },
      "offset_x": { "type": "integer" },
      "offset_y": { "type": "integer" },
      "interval_seconds": { "type": "number" },
      "revalidated": { "type": "boolean" },
      "skipped": { "type": "boolean" },
      "final_state": { "type": "string" }
    },
    "additionalProperties": false
  },
  "effects": { "side_effect": true, "retry": "unsafe" }
}
