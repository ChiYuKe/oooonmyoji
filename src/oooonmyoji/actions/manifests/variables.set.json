{
  "schema_version": 2,
  "name": "variables.set",
  "version": "1.0.0",
  "entry": "builtin:AssignAction",
  "description": "更新工作流运行变量，并将名称和值作为节点输出返回。",
  "parameters": { "name": { "type": "string", "required": true, "min_length": 1 }, "value": { "type": "any", "required": true } },
  "outputs": { "type": "object", "properties": { "name": { "type": "string" }, "value": {} }, "required": ["name", "value"], "additionalProperties": false },
  "effects": { "side_effect": false, "retry": "safe" }
}
