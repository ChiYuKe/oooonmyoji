{
  "schema_version": 2,
  "name": "vision.detect_state",
  "version": "1.0.0",
  "entry": "builtin:DetectStateAction",
  "description": "在同一张截图上按独立 ROI 和阈值识别多个页面状态，模板全部未命中后才降级 OCR。",
  "parameters": {
    "states": {
      "type": "array",
      "required": true,
      "min_items": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "required": true, "min_length": 1 },
          "template": { "type": "asset" },
          "roi": { "type": "rect" },
          "threshold": { "type": "number", "default": 0.85, "min": 0, "max": 1 },
          "scale_search": { "type": "boolean", "default": false },
          "texts": { "type": "array", "items": { "type": "string", "min_length": 1 }, "default": [] },
          "text_roi": { "type": "rect" },
          "min_confidence": { "type": "number", "default": 0, "min": 0, "max": 1 }
        }
      }
    },
    "allow_ocr": { "type": "boolean", "default": true }
  },
  "outputs": {
    "type": "object",
    "properties": {
      "state": { "type": "string" },
      "source": { "type": "string" },
      "confidence": { "type": "number" },
      "match": { "type": "object" },
      "elapsed_seconds": { "type": "number" }
    },
    "required": ["state", "source", "confidence", "match", "elapsed_seconds"],
    "additionalProperties": false
  },
  "effects": { "side_effect": false, "retry": "safe" }
}
