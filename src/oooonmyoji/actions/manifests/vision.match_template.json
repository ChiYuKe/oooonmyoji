{
  "schema_version": 2,
  "name": "vision.match_template",
  "version": "1.0.0",
  "entry": "builtin:MatchTemplateAction",
  "description": "在画面中匹配模板图（不等待）。命中时成功并返回匹配对象数组；0 命中时以 not_matched 失败，便于 Selector 回退或由 workflow.run 向主流程报告。",
  "parameters": {
    "template": {
      "type": "asset",
      "required": true,
      "editor": "asset",
      "description": "模板图路径，如 assets/templates/xxx.png"
    },
    "roi": {
      "type": "rect",
      "description": "裁剪区域 [x, y, w, h]"
    },
    "threshold": {
      "type": "number",
      "default": 0.85,
      "min": 0,
      "max": 1,
      "description": "匹配置信度阈值，默认 0.85"
    },
    "max_results": {
      "type": "integer",
      "default": 20,
      "min": 1,
      "description": "最多返回的匹配数，默认 20"
    },
    "scale_search": {
      "type": "boolean",
      "default": false,
      "description": "是否启用多尺度搜索"
    }
  },
  "outputs": {
    "type": "array",
    "minItems": 1,
    "items": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height",
        "confidence",
        "reference",
        "center",
        "template",
        "threshold"
      ],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reference": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "center": {
          "type": "array",
          "prefixItems": [
            { "type": "integer" },
            { "type": "integer" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "template": { "type": "string" },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "roi": {
          "type": "array",
          "prefixItems": [
            { "type": "integer" },
            { "type": "integer" },
            { "type": "integer" },
            { "type": "integer" }
          ],
          "minItems": 4,
          "maxItems": 4
        }
      },
      "additionalProperties": false
    }
  },
  "effects": { "side_effect": false, "retry": "safe" }
}
