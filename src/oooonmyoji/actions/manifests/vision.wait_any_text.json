{
  "schema_version": 2,
  "name": "vision.wait_any_text",
  "version": "1.0.0",
  "entry": "builtin:WaitAnyTextAction",
  "description": "轮询 OCR，直到任一候选文本出现或全部消失。",
  "parameters": {
    "texts": {
      "type": "array",
      "required": true,
      "min_items": 1,
      "items": { "type": "string", "min_length": 1 }
    },
    "timeout_seconds": { "type": "duration", "required": true, "min": 0 },
    "present": { "type": "boolean", "default": true },
    "allow_timeout": { "type": "boolean", "default": false },
    "roi": { "type": "rect" },
    "min_confidence": { "type": "number", "default": 0, "min": 0, "max": 1 }
  },
  "card": {
    "rows": [
      { "param": "texts", "label": "文字列表", "control": "inspector" },
      { "param": "timeout_seconds", "label": "超时" },
      { "param": "present", "label": "存在性", "on_label": "等待出现", "off_label": "等待消失" },
      { "param": "allow_timeout", "label": "允许超时", "on_label": "允许", "off_label": "不允许" },
      { "param": "roi", "label": "识别区域" },
      { "param": "min_confidence", "label": "最小置信度" }
    ]
  },
  "outputs": {
    "type": "object",
    "properties": {
      "matched_text": { "type": "string" },
      "confidence": { "type": "number" },
      "present": { "type": "boolean" },
      "timed_out": { "type": "boolean" }
    },
    "additionalProperties": false
  },
  "effects": { "side_effect": false, "retry": "safe" }
}
