{
  "schema_version": 2,
  "name": "vision.wait_text",
  "version": "1.0.0",
  "entry": "builtin:WaitTextAction",
  "description": "轮询 OCR 直到指定文本出现（或消失，present=false），如“等待花牌结算字样出现”。输出 { matched, text, present }。OCR 未启用时判定失败。",
  "parameters": {
    "text": {
      "type": "string",
      "required": true,
      "min_length": 1,
      "description": "要等待出现的文本子串（OCR 识别结果包含即命中）"
    },
    "timeout_seconds": {
      "type": "number",
      "required": true,
      "min": 0,
      "description": "等待超时秒数，超时则失败"
    },
    "present": {
      "type": "boolean",
      "default": true,
      "description": "true 等待出现；false 等待消失。默认 true"
    },
    "roi": {
      "type": "rect",
      "description": "裁剪区域 [x, y, w, h]"
    },
    "min_confidence": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 1,
      "description": "OCR 置信度下限，默认 0"
    }
  },
  "outputs": {
    "type": "object",
    "properties": {
      "matched": { "type": "integer" },
      "text": { "type": "string" },
      "present": { "type": "boolean" }
    },
    "additionalProperties": false
  },
  "effects": { "side_effect": false, "retry": "safe" }
}
