{
  "schema_version": 2,
  "name": "workflow.run",
  "version": "1.0.0",
  "entry": "builtin:RunWorkflowAction",
  "description": "同步运行另一个工作流。子流程结束后返回完整回执 { workflow, status, output, error, error_category }；失败和取消也会把回执写入运行事件。递归调用会被拦截。",
  "parameters": {
    "workflow": {
      "type": "string",
      "required": true,
      "min_length": 1,
      "description": "子工作流 ID、JSON 文件名或 workflows/ 下的路径"
    },
    "inputs": {
      "type": "object",
      "description": "传给子工作流的输入（按子工作流 inputs 定义校验），可含绑定引用"
    }
  },
  "outputs": {
    "type": "object",
    "properties": {
      "workflow": { "type": "string" },
      "status": { "enum": ["succeeded", "failed", "cancelled"] },
      "output": {},
      "error": { "type": ["string", "null"] },
      "error_category": { "type": ["string", "null"] }
    },
    "required": ["workflow", "status", "output", "error", "error_category"],
    "additionalProperties": false
  },
  "effects": { "side_effect": true, "retry": "unsafe" }
}
