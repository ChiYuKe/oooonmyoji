{
  "description": "两端共同的工作流校验规则样例：Python 是权威实现，TypeScript 提供编辑时诊断。cases 中 python_error 为主进程错误信息匹配（正则），desktop_codes 为编辑器诊断必须包含的 code。",
  "actions": {
    "test.echo": {
      "retry_safe": true,
      "input_schema": { "type": "object" },
      "output_schema": { "type": "object" }
    },
    "test.produce": {
      "retry_safe": true,
      "input_schema": {
        "type": "object",
        "properties": { "value": { "type": "integer" } },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": { "value": { "type": "integer" } },
        "additionalProperties": false
      }
    },
    "test.consume": {
      "retry_safe": false,
      "input_schema": {
        "type": "object",
        "properties": { "count": { "type": "integer" } },
        "additionalProperties": false
      },
      "output_schema": { "type": "object", "additionalProperties": false }
    }
  },
  "cases": [
    {
      "name": "valid-minimal",
      "valid": true,
      "workflow": {
        "schema_version": 4,
        "id": "rules",
        "version": "4.0.0",
        "resolution": [1920, 1080],
        "root": "root",
        "inputs": {},
        "variables": {},
        "nodes": [
          { "id": "root", "type": "root", "children": ["work"] },
          { "id": "work", "type": "task", "action": "test.echo", "params": {} }
        ]
      }
    },
    {
      "name": "valid-sequence-output-binding",
      "valid": true,
      "workflow": {
        "schema_version": 4,
        "id": "rules",
        "version": "4.0.0",
        "resolution": [1920, 1080],
        "root": "root",
        "inputs": {},
        "variables": {},
        "nodes": [
          { "id": "root", "type": "root", "children": ["seq"] },
          { "id": "seq", "type": "sequence", "children": ["producer", "consumer"] },
          { "id": "producer", "type": "task", "action": "test.produce", "params": { "value": 1 } },
          { "id": "consumer", "type": "task", "action": "test.consume", "params": { "count": { "ref": "nodes.producer.output.value" } } }
        ]
      }
    },
    {
      "name": "valid-selector-exists-check",
      "valid": true,
      "workflow": {
        "schema_version": 4,
        "id": "rules",
        "version": "4.0.0",
        "resolution": [1920, 1080],
        "root": "root",
        "inputs": {},
        "variables": {},
        "nodes": [
          { "id": "root", "type": "root", "children": ["seq"] },
          { "id": "seq", "type": "sequence", "children": ["choice", "check"] },
          { "id": "choice", "type": "selector", "children": ["producer", "fallback"] },
          { "id": "producer", "type": "task", "action": "test.produce", "params": { "value": 1 } },
          { "id": "fallback", "type": "task", "action": "test.echo", "params": {} },
          {
            "id": "check",
            "type": "task",
            "action": "test.echo",
            "params": {},
            "decorators": [{ "type": "condition", "expression": { "exists": { "ref": "nodes.producer.output.value" } } }]
          }
        ]
      }
    },
    {
      "name": "valid-repeat-until-body-output",
      "valid": true,
      "workflow": {
        "schema_version": 4,
        "id": "rules",
        "version": "4.0.0",
        "resolution": [1920, 1080],
        "root": "root",
        "inputs": {},
        "variables": {},
        "nodes": [
          { "id": "root", "type": "root", "children": ["loop"] },
          {
            "id": "loop",
            "type": "repeat_until",
            "condition": { "exists": { "ref": "nodes.body.output.value" } },
            "children": ["body"]
          },
          { "id": "body", "type": "task", "action": "test.produce", "params": { "value": 1 } }
        ]
      }
    },
    {
