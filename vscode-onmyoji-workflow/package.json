{
  "name": "onmyoji-workflow-helper",
  "displayName": "Onmyoji Workflow Helper",
  "description": "为 oooonmyoji 自动化项目编写 Behavior Tree schema v3 工作流：智能补全、校验、悬停提示与可视化编辑器（支持内置与自定义 Action）",
  "version": "0.2.2",
  "publisher": "oooonmyoji",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "onmyoji",
    "workflow",
    "json",
    "visual",
    "automation"
  ],
  "activationEvents": [
    "workspaceContains:workflows/*.json",
    "workspaceContains:plugins/actions/*/action.json",
    "onCommand:onmyoji.openWorkflowEditor",
    "onCommand:onmyoji.createWorkflow",
    "onCommand:onmyoji.runWorkflow",
    "onCommand:onmyoji.validateCurrentWorkflow",
    "onCommand:onmyoji.runEngineValidate",
    "onCommand:onmyoji.reloadActionCatalog"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "onmyoji.openWorkflowEditor",
        "title": "Onmyoji: 打开工作流可视化编辑器",
        "category": "Onmyoji",
        "shortTitle": "打开工作流编辑器",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "onmyoji.createWorkflow",
        "title": "Onmyoji: 新建工作流",
        "category": "Onmyoji",
        "icon": "$(new-file)"
      },
      {
        "command": "onmyoji.runWorkflow",
        "title": "Onmyoji: 执行当前工作流",
        "category": "Onmyoji",
        "icon": "$(play)"
      },
      {
        "command": "onmyoji.validateCurrentWorkflow",
        "title": "Onmyoji: 校验当前工作流 JSON",
        "category": "Onmyoji"
      },
      {
        "command": "onmyoji.runEngineValidate",
        "title": "Onmyoji: 用自动化引擎校验 (CLI validate)",
        "category": "Onmyoji"
      },
      {
        "command": "onmyoji.reloadActionCatalog",
        "title": "Onmyoji: 重新加载 Action 目录",
        "category": "Onmyoji"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "onmyoji.createWorkflow"
        },
        {
          "command": "onmyoji.runWorkflow",
          "when": "onmyoji.workflowFile"
        },
        {
          "command": "onmyoji.validateCurrentWorkflow",
          "when": "editorLangId == json"
        },
        {
          "command": "onmyoji.openWorkflowEditor",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title": [
        {
          "command": "onmyoji.openWorkflowEditor",
          "when": "onmyoji.workflowFile",
          "group": "navigation@1"
        },
        {
          "command": "onmyoji.runWorkflow",
          "when": "onmyoji.workflowFile",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "onmyoji.validateCurrentWorkflow",
          "when": "onmyoji.workflowFile",
          "group": "navigation@100"
        },
        {
          "command": "onmyoji.openWorkflowEditor",
          "when": "onmyoji.workflowFile",
          "group": "navigation@101"
        },
        {
          "command": "onmyoji.runWorkflow",
          "when": "onmyoji.workflowFile",
          "group": "navigation@102"
        }
      ],
      "explorer/context": [
        {
          "command": "onmyoji.openWorkflowEditor",
          "when": "resourceFilename =~ /^.*\\.json$/",
          "group": "navigation@100"
        }
      ]
    },
    "snippets": [
      {
        "language": "json",
        "path": "./snippets/workflow.code-snippets"
      }
    ],
    "configuration": {
      "title": "Onmyoji Workflow Helper",
      "properties": {
        "onmyoji.projectRoot": {
          "type": "string",
          "default": "",
          "description": "oooonmyoji 项目根目录。留空时自动向上查找 src/oooonmyoji/actions/builtin.py 与 plugins/actions。"
        },
        "onmyoji.workflowFiles": {
          "type": "string",
          "default": "**/workflows/*.json",
          "description": "匹配工作流 JSON 文件的 glob，用于启用智能提示。"
        },
        "onmyoji.pythonExecutable": {
          "type": "string",
          "default": "",
          "description": "引擎校验用的 Python 可执行文件。留空时自动使用项目 .venv/Scripts/python.exe。"
        },
        "onmyoji.configPath": {
          "type": "string",
          "default": "config/config.json",
          "description": "引擎 CLI validate 使用的配置文件路径（相对项目根目录）。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "jsonc-parser": "^3.3.1",
    "vscode-json-languageservice": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
