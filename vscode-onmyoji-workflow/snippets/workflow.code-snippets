{
  "Onmyoji Behavior Tree 骨架 (v3)": {
    "prefix": "owf-tree",
    "body": [
      "{",
      "  \"schema_version\": 3,",
      "  \"id\": \"${1:my_behavior_tree}\",",
      "  \"version\": \"3.0.0\",",
      "  \"description\": \"${2:工作流用途说明}\",",
      "  \"resolution\": [1920, 1080],",
      "  \"root\": \"root\",",
      "  \"limits\": { \"timeout_seconds\": 300, \"max_steps\": 1000 },",
      "  \"blackboard\": {},",
      "  \"nodes\": [",
      "    { \"id\": \"root\", \"type\": \"root\", \"children\": [\"main\"] },",
      "    { \"id\": \"main\", \"type\": \"sequence\", \"children\": [\"capture\"] },",
      "    { \"id\": \"capture\", \"type\": \"task\", \"action\": \"core.capture\", \"params\": {} }",
      "  ]",
      "}"
    ],
    "description": "生成 v3 Behavior Tree：Root + Sequence + Task"
  },
  "BT 节点：Task": {
    "prefix": "owf-task",
    "body": [
      "{",
      "  \"id\": \"${1:task}\",",
      "  \"type\": \"task\",",
      "  \"action\": \"${2:core.capture}\",",
      "  \"params\": {}",
      "}"
    ],
    "description": "插入 Behavior Tree Task 叶子节点"
  },
  "BT 节点：Selector": {
    "prefix": "owf-selector",
    "body": [
      "{ \"id\": \"${1:selector}\", \"type\": \"selector\", \"children\": [\"${2:branch_a}\", \"${3:branch_b}\"] }"
    ],
    "description": "失败时尝试下一个子节点，首个成功即返回"
  },
  "BT 节点：Sequence": {
    "prefix": "owf-sequence",
    "body": [
      "{ \"id\": \"${1:sequence}\", \"type\": \"sequence\", \"children\": [\"${2:first}\", \"${3:second}\"] }"
    ],
    "description": "成功时执行下一个子节点，首个失败即返回"
  },
  "BT 节点：Simple Parallel": {
    "prefix": "owf-parallel",
    "body": [
      "{",
      "  \"id\": \"${1:parallel}\",",
      "  \"type\": \"simple_parallel\",",
      "  \"finish_mode\": \"${2|abort_background,wait_for_background|}\",",
      "  \"children\": [\"${3:main_task}\", \"${4:background}\"]",
      "}"
    ],
    "description": "第一个子节点是主 Task，第二个是后台分支"
  },
  "BT 节点：Instance Parallel": {
    "prefix": "owf-instance-parallel",
    "body": [
      "{",
      "  \"id\": \"${1:run_all_instances}\",",
      "  \"type\": \"instance_parallel\",",
      "  \"wait_for\": \"all\",",
      "  \"cancel_on_failure\": true,",
      "  \"runs\": [",
      "    { \"instance\": \"${2:mumu-0}\", \"workflow\": \"${3:entrypoints/account_0.json}\", \"inputs\": {} },",
      "    { \"instance\": \"${4:mumu-1}\", \"workflow\": \"${5:entrypoints/account_1.json}\", \"inputs\": {} }",
      "  ]",
      "}"
    ],
    "description": "Supervisor 同时启动多个实例工作流（只能作为 Root 的唯一子节点）"
  },
  "BT 装饰器：Condition": {
    "prefix": "owf-decorator-condition",
    "body": [
      "{ \"type\": \"condition\", \"expression\": { \"${1:exists}\": { \"ref\": \"${2:blackboard.flag}\" } } }"
    ],
    "description": "插入条件装饰器"
  },
  "BT 装饰器：Cooldown": {
    "prefix": "owf-decorator-cooldown",
    "body": ["{ \"type\": \"cooldown\", \"seconds\": ${1:5} }"],
    "description": "分支停用后进入冷却"
  },
  "BT 装饰器：Time Limit": {
    "prefix": "owf-decorator-timeout",
    "body": ["{ \"type\": \"timeout\", \"seconds\": ${1:10} }"],
    "description": "限制节点或子树执行时间"
  }
}
