{
  "schema_version": 4,
  "id": "mumu_0_souls_party_leader",
  "version": "5.4.0",
  "description": "MuMu-0 队长入口：恢复页面、创建私密协战房间、邀请队员，并按运行轮次执行组队御魂。",
  "resolution": [
    1920,
    1080
  ],
  "root": "root",
  "limits": {
    "timeout_seconds": 1209600,
    "max_steps": 2200
  },
  "inputs": {
    "运行轮数": {
      "type": "integer",
      "default": 9999,
      "min": 1,
      "max": 9999
    },
    "队员离开宽限时间": {
      "type": "number",
      "default": 5,
      "min": 0,
      "max": 30
    },
    "队员已在场模板": {
      "type": "asset",
      "default": "assets/templates/souls/party/member-present.png",
      "description": "用于确认目标队友已经进入协战房间"
    },
    "邀请目标模板": {
      "type": "asset",
      "default": "assets/templates/souls/party/member-invite-target.png",
      "description": "好友邀请列表中的目标队友名字模板"
    },
    "队员加入超时时间": {
      "type": "number",
      "default": 30,
      "min": 5,
      "max": 120,
      "description": "每次发送邀请后等待目标队友入房的秒数"
    }
  },
  "variables": {},
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "name": "mumu0 御魂组队队长",
      "children": [
        "main"
      ]
    },
    {
      "id": "main",
      "type": "sequence",
      "name": "建队、邀请并按配置轮数执行",
      "children": [
        "ensure_party_room",
        "ensure_initial_member",
        "battle_plan",
        "final_recovery"
      ]
    },
    {
      "id": "final_recovery",
      "type": "task",
      "name": "末轮后退出队伍并确认御魂挑战页",
      "action": "workflow.run",
      "params": {
        "workflow": "shared/recover_to_souls.json",
        "inputs": {
          "庭院入口模板": "assets/templates/souls/courtyard-explore/mumu-0.png"
        }
      }
    },
    {
      "id": "wake_hidden_ui",
      "type": "task",
      "name": "确认庭院后唤醒隐藏界面",
      "action": "input.tap",
      "params": {
        "x": 1300,
        "y": 800,
        "random_offset": 3,
        "random_interval": [
          0.2,
          0.4
        ]
      }
    },
    {
      "id": "ensure_party_room",
      "type": "selector",
      "name": "恢复或创建协战房间",
      "children": [
        "already_in_party_room",
        "create_party_room"
      ]
    },
    {
      "id": "already_in_party_room",
      "type": "sequence",
      "name": "已经在协战房间",
      "children": [
        "detect_party_room"
      ]
    },
    {
      "id": "detect_party_room",
      "type": "task",
      "name": "检测协战房间",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/lobby-title.png",
        "timeout_seconds": 1,
        "roi": [
          80,
          0,
          350,
          120
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "create_party_room",
      "type": "sequence",
      "name": "进入悲鸣并创建仅邀请队伍",
      "children": [
        "enter_souls_floor",
        "wait_party_button",
        "tap_party_button",
        "retry_create_dialog",
        "wait_create_confirm",
        "tap_private_permission",
        "tap_create_confirm",
        "wait_party_room_after_create"
      ]
    },
    {
      "id": "enter_souls_floor",
      "type": "selector",
      "name": "恢复到御魂悲鸣页面",
      "children": [
        "task_in_souls_1",
        "from_courtyard"
      ]
    },
    {
      "id": "from_courtyard",
      "type": "sequence",
      "name": "从庭院进入悲鸣",
      "children": [
        "ensure_courtyard_ui_visible",
        "wait_courtyard_explore",
        "tap_courtyard_explore",
        "wait_map_from_courtyard",
        "tap_map_from_courtyard",
        "wait_orochi_from_courtyard",
        "tap_orochi_from_courtyard",
        "wait_floor_from_courtyard"
      ]
    },
    {
      "id": "ensure_courtyard_ui_visible",
      "type": "selector",
      "name": "确认庭院探索入口可见",
      "children": [
        "detect_courtyard_explore",
        "wake_hidden_courtyard"
      ]
    },
    {
      "id": "detect_courtyard_explore",
      "type": "task",
      "name": "快速检测庭院探索入口",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/courtyard-explore/mumu-0.png",
        "timeout_seconds": 1,
        "roi": [
          0,
          0,
          1920,
          500
        ],
        "threshold": 0.4,
        "scale_search": false
      }
    },
    {
      "id": "wake_hidden_courtyard",
      "type": "sequence",
      "name": "唤醒并确认隐藏的庭院界面",
      "children": [
