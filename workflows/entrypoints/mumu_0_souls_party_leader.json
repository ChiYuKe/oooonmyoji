        "ensure_member_invited",
        "round_selector"
      ],
      "decorators": [
        {
          "type": "repeat",
          "count": {
            "ref": "inputs.运行轮数"
          }
        },
        {
          "type": "timeout",
          "seconds": 1209000
        }
      ]
    },
    {
      "id": "wait_member_departure_window",
      "type": "task",
      "name": "等待队员完成奖励复核并决定是否离队",
      "action": "core.sleep",
      "params": {
        "seconds": {
          "ref": "inputs.队员离开宽限时间"
        }
      }
    },
    {
      "id": "round_selector",
      "type": "selector",
      "name": "末轮停止续邀，其余轮保持自动续邀",
      "children": [
        "final_round",
        "automatic_round"
      ]
    },
    {
      "id": "final_round",
      "type": "task",
      "name": "最后一轮完成后取消续邀",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/party/leader_round.json",
        "inputs": {
          "执行阶段": "finish",
          "队员已在场模板": {
            "ref": "inputs.队员已在场模板"
          }
        }
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "eq": [
              {
                "ref": "runtime.repeat.final"
              },
              true
            ]
          }
        }
      ]
    },
    {
      "id": "automatic_round",
      "type": "task",
      "name": "非末轮启用或沿用自动续邀",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/party/leader_round.json",
        "inputs": {
          "执行阶段": "setup_auto_invite",
          "队员已在场模板": {
            "ref": "inputs.队员已在场模板"
          }
        }
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "eq": [
              {
                "ref": "runtime.repeat.final"
              },
              false
            ]
          }
        }
      ]
    },
    {
      "id": "task_in_souls_1",
      "type": "task",
      "action": "workflow.run",
      "params": {
        "workflow": "shared/recover_to_souls.json",
        "inputs": {
          "庭院入口模板": "assets/templates/souls/courtyard-explore/mumu-0.png"
        }
      },
      "name": "优先使用统一多状态恢复流程"
    }
  ],
