{
  "schema_version": 3,
  "id": "mumu_0_souls_party_leader",
  "version": "5.4.0",
  "description": "MuMu-0 队长入口：恢复页面、创建私密协战房间、邀请队员，并按运行轮次执行组队御魂。",
  "resolution": [
    1920,
    1080
  ],
  "root": "root",
  "limits": {
    "timeout_seconds": 1209600,
    "max_steps": 2200
  },
  "blackboard": {
    "rounds": {
      "type": "integer",
      "public": true,
      "default": 9999,
      "min": 1,
      "max": 9999
    },
    "member_present_template": {
      "type": "asset",
      "public": true,
      "default": "assets/templates/souls/party/member-present.png",
      "description": "用于确认目标队友已经进入协战房间"
    },
    "invite_target_template": {
      "type": "asset",
      "public": true,
      "default": "assets/templates/souls/party/member-invite-target.png",
      "description": "好友邀请列表中的目标队友名字模板"
    },
    "member_join_timeout": {
      "type": "number",
      "public": true,
      "default": 30,
      "min": 5,
      "max": 120,
      "description": "每次发送邀请后等待目标队友入房的秒数"
    },
    "enable_realm_raid": { "type": "boolean", "public": true, "default": false },
    "realm_threshold": { "type": "integer", "public": true, "default": 30, "min": 1 },
    "realm_pass_roi": { "type": "rect", "public": true, "default": [1450, 0, 470, 180] },
    "realm_entry_point": { "type": "rect", "public": true, "default": [450, 1000, 0, 0] },
    "realm_target_points": { "type": "array", "public": true, "default": [[500, 275, 0, 0], [1000, 275, 0, 0], [1500, 275, 0, 0], [500, 475, 0, 0], [1000, 475, 0, 0], [1500, 475, 0, 0], [500, 675, 0, 0], [1000, 675, 0, 0], [1500, 675, 0, 0]], "items": { "type": "rect" } }
    ,
    "realm_target_rois": { "type": "array", "public": true, "default": [[220, 220, 500, 190], [720, 220, 500, 190], [1220, 220, 500, 190], [220, 420, 500, 190], [720, 420, 500, 190], [1220, 420, 500, 190], [220, 620, 500, 190], [720, 620, 500, 190], [1220, 620, 500, 190]], "items": { "type": "rect" } },
    "realm_completed_texts": { "type": "array", "public": true, "default": ["已挑战", "已击败", "胜利", "占领"], "items": { "type": "string", "min_length": 1 } },
    "realm_completed_templates": { "type": "array", "public": true, "default": [], "items": { "type": "asset", "min_length": 1 } }
  },
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "name": "mumu0 御魂组队队长",
      "children": [
        "main"
      ]
    },
    {
      "id": "main",
      "type": "sequence",
      "name": "建队、邀请并按配置轮数执行",
      "children": [
        "ensure_party_room",
        "ensure_member_invited",
        "battle_plan",
        "final_recovery"
      ]
    },
    {
      "id": "final_recovery",
      "type": "task",
      "name": "末轮后退出队伍并确认御魂挑战页",
      "action": "workflow.run",
      "params": {
        "workflow": "shared/recover_to_souls.json",
        "inputs": {
          "courtyard_template": "assets/templates/souls/courtyard-explore/mumu-0.png"
        }
      }
    },
    {
      "id": "wake_hidden_ui",
      "type": "task",
      "name": "确认庭院后唤醒隐藏界面",
      "action": "input.tap",
      "params": {
        "x": 1300,
        "y": 800,
        "random_offset": 3,
        "random_interval": [
          0.2,
          0.4
        ]
      }
    },
    {
      "id": "ensure_party_room",
      "type": "selector",
      "name": "恢复或创建协战房间",
      "children": [
        "already_in_party_room",
        "create_party_room"
      ]
    },
    {
      "id": "already_in_party_room",
      "type": "sequence",
      "name": "已经在协战房间",
      "children": [
        "detect_party_room"
      ]
    },
    {
      "id": "detect_party_room",
      "type": "task",
      "name": "检测协战房间",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/lobby-title.png",
        "timeout_seconds": 1,
        "roi": [
          80,
          0,
          350,
          120
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "create_party_room",
      "type": "sequence",
      "name": "进入悲鸣并创建仅邀请队伍",
      "children": [
        "enter_souls_floor",
        "realm_scheduler",
        "wait_party_button",
        "tap_party_button",
        "retry_create_dialog",
        "wait_create_confirm",
        "tap_private_permission",
        "tap_create_confirm",
        "wait_party_room_after_create"
      ]
    },
    {
      "id": "enter_souls_floor",
      "type": "selector",
      "name": "恢复到御魂悲鸣页面",
      "children": [
        "task_in_souls_1",
        "from_courtyard"
      ]
    },
    {
      "id": "from_courtyard",
      "type": "sequence",
      "name": "从庭院进入悲鸣",
      "children": [
        "ensure_courtyard_ui_visible",
        "wait_courtyard_explore",
        "tap_courtyard_explore",
        "wait_map_from_courtyard",
        "tap_map_from_courtyard",
        "wait_orochi_from_courtyard",
        "tap_orochi_from_courtyard",
        "wait_floor_from_courtyard"
      ]
    },
    {
      "id": "ensure_courtyard_ui_visible",
      "type": "selector",
      "name": "确认庭院探索入口可见",
      "children": [
        "detect_courtyard_explore",
        "wake_hidden_courtyard"
      ]
    },
    {
      "id": "detect_courtyard_explore",
      "type": "task",
      "name": "快速检测庭院探索入口",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/courtyard-explore/mumu-0.png",
        "timeout_seconds": 1,
        "roi": [
          0,
          0,
          1920,
          500
        ],
        "threshold": 0.4,
        "scale_search": false
      }
    },
    {
      "id": "wake_hidden_courtyard",
      "type": "sequence",
      "name": "唤醒并确认隐藏的庭院界面",
      "children": [
        "wake_hidden_ui",
        "detect_courtyard_explore_after_wake"
      ]
    },
    {
      "id": "detect_courtyard_explore_after_wake",
      "type": "task",
      "name": "确认唤醒后的庭院探索入口",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/courtyard-explore/mumu-0.png",
        "timeout_seconds": 5,
        "roi": [
          0,
          0,
          1920,
          500
        ],
        "threshold": 0.4,
        "scale_search": false
      }
    },
    {
      "id": "wait_courtyard_explore",
      "type": "task",
      "name": "等待庭院探索入口",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/courtyard-explore/mumu-0.png",
        "timeout_seconds": 5,
        "roi": [
          0,
          0,
          1920,
          500
        ],
        "threshold": 0.4,
        "scale_search": false
      }
    },
    {
      "id": "tap_courtyard_explore",
      "type": "task",
      "name": "点击探索入口",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_courtyard_explore.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_map_from_courtyard",
      "type": "task",
      "name": "等待地图御魂入口",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/map-souls.png",
        "timeout_seconds": 20,
        "roi": [
          150,
          850,
          250,
          230
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "tap_map_from_courtyard",
      "type": "task",
      "name": "点击地图御魂入口",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_map_from_courtyard.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_orochi_from_courtyard",
      "type": "task",
      "name": "等待八岐大蛇入口",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-orochi.png",
        "timeout_seconds": 20,
        "roi": [
          0,
          80,
          600,
          850
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "tap_orochi_from_courtyard",
      "type": "task",
      "name": "进入八岐大蛇",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_orochi_from_courtyard.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_floor_from_courtyard",
      "type": "task",
      "name": "等待御魂副本页",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-challenge.png",
        "timeout_seconds": 20,
        "roi": [
          1550,
          750,
          370,
          330
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "wait_party_button",
      "type": "task",
      "name": "等待组队按钮",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/floor-party-button.png",
        "timeout_seconds": 10,
        "roi": [
          1350,
          820,
          300,
          240
        ],
        "threshold": 0.9,
        "scale_search": false
      }
    },
    {
      "id": "tap_party_button",
      "type": "task",
      "name": "进入组队页面",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_party_button.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_create_team",
      "type": "task",
      "name": "等待创建队伍按钮",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/create-team-button.png",
        "timeout_seconds": 20,
        "roi": [
          1400,
          840,
          400,
          180
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "tap_create_team",
      "type": "task",
      "name": "打开创建队伍弹窗",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_create_team.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "retry_create_dialog",
      "type": "sequence",
      "name": "重试打开创建队伍弹窗",
      "children": [
        "wait_create_team",
        "tap_create_team",
        "wait_create_confirm_after_retry"
      ],
      "decorators": [
        {
          "type": "retry",
          "attempts": 3,
          "delay_seconds": 0.5
        }
      ]
    },
    {
      "id": "wait_create_confirm_after_retry",
      "type": "task",
      "name": "确认重试后弹窗已打开",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/create-confirm-button.png",
        "timeout_seconds": 3,
        "roi": [
          1150,
          780,
          350,
          220
        ],
        "threshold": 0.9,
        "scale_search": false
      }
    },
    {
      "id": "wait_create_confirm",
      "type": "task",
      "name": "等待创建确认按钮",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/create-confirm-button.png",
        "timeout_seconds": 20,
        "roi": [
          1150,
          780,
          350,
          220
        ],
        "threshold": 0.9,
        "scale_search": false
      }
    },
    {
      "id": "tap_private_permission",
      "type": "task",
      "name": "选择不公开仅邀请",
      "action": "input.tap",
      "params": {
        "x": 1148,
        "y": 765,
        "random_offset": 3,
        "random_interval": [
          0.2,
          0.5
        ]
      }
    },
    {
      "id": "tap_create_confirm",
      "type": "task",
      "name": "创建悲鸣队伍",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_create_confirm.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_party_room_after_create",
      "type": "task",
      "name": "等待协战房间",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/lobby-title.png",
        "timeout_seconds": 30,
        "roi": [
          80,
          0,
          350,
          120
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "ensure_member_invited",
      "type": "selector",
      "name": "确认目标队友已加入或发送邀请",
      "children": [
        "member_already_present",
        "send_initial_invite"
      ],
      "decorators": [
        {
          "type": "retry",
          "attempts": 180,
          "delay_seconds": 0.5
        },
        {
          "type": "timeout",
          "seconds": 7200
        }
      ]
    },
    {
      "id": "member_already_present",
      "type": "sequence",
      "name": "目标队友已在房间",
      "children": [
        "detect_member_present"
      ]
    },
    {
      "id": "detect_member_present",
      "type": "task",
      "name": "检测目标队友账号条",
      "action": "vision.wait_template",
      "params": {
        "template": {
          "ref": "blackboard.member_present_template"
        },
        "timeout_seconds": 2,
        "roi": [
          700,
          100,
          450,
          180
        ],
        "threshold": 0.8,
        "scale_search": false,
        "present": true
      }
    },
    {
      "id": "send_initial_invite",
      "type": "sequence",
      "name": "邀请目标队友",
      "children": [
        "tap_empty_member_slot",
        "wait_invite_target",
        "tap_invite_target",
        "wait_invite_button",
        "tap_invite_button",
        "wait_member_after_invite"
      ]
    },
    {
      "id": "tap_empty_member_slot",
      "type": "task",
      "name": "打开好友邀请列表",
      "action": "input.tap",
      "params": {
        "x": 970,
        "y": 385,
        "random_offset": 5,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_invite_target",
      "type": "task",
      "name": "等待目标队友好友项",
      "action": "vision.wait_template",
      "params": {
        "template": {
          "ref": "blackboard.invite_target_template"
        },
        "timeout_seconds": 30,
        "roi": [
          500,
          220,
          500,
          230
        ],
        "threshold": 0.9,
        "scale_search": false
      }
    },
    {
      "id": "tap_invite_target",
      "type": "task",
      "name": "选择目标队友",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_invite_target.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.5
        ]
      }
    },
    {
      "id": "wait_invite_button",
      "type": "task",
      "name": "等待邀请按钮",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/invite-button.png",
        "timeout_seconds": 10,
        "roi": [
          950,
          760,
          400,
          220
        ],
        "threshold": 0.9,
        "scale_search": false
      }
    },
    {
      "id": "tap_invite_button",
      "type": "task",
      "name": "发送御魂悲鸣邀请",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_invite_button.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_member_after_invite",
      "type": "task",
      "name": "确认目标队友接受邀请并进入房间",
      "action": "vision.wait_template",
      "params": {
        "template": {
          "ref": "blackboard.member_present_template"
        },
        "timeout_seconds": {
          "ref": "blackboard.member_join_timeout"
        },
        "roi": [
          700,
          100,
          450,
          180
        ],
        "threshold": 0.8,
        "scale_search": false,
        "present": true
      }
    },
    {
      "id": "battle_plan",
      "type": "selector",
      "name": "按公开轮数执行并在末轮停止续邀",
      "children": ["final_round", "automatic_round"],
      "decorators": [
        {
          "type": "repeat",
          "count": { "ref": "blackboard.rounds" }
        },
        {
          "type": "timeout",
          "seconds": 1209000
        }
      ]
    },
    {
      "id": "final_round",
      "type": "task",
      "name": "最后一轮完成后取消续邀",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/party/leader_round.json",
        "inputs": {
          "phase": "finish",
          "member_present_template": {
            "ref": "blackboard.member_present_template"
          }
        }
      },
      "decorators": [
        {
          "type": "condition",
          "expression": { "eq": [{ "ref": "runtime.repeat.final" }, true] }
        }
      ]
    },
    {
      "id": "automatic_round",
      "type": "task",
      "name": "非末轮启用或沿用自动续邀",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/party/leader_round.json",
        "inputs": {
          "phase": "setup_auto_invite",
          "member_present_template": {
            "ref": "blackboard.member_present_template"
          }
        }
      }
    },
    {
      "id": "realm_scheduler",
      "type": "task",
      "name": "组队御魂启动前检查结界券",
      "action": "workflow.run",
      "params": {
        "workflow": "realm/shared/schedule_from_souls.json",
        "inputs": {
          "enable_realm_raid": { "ref": "blackboard.enable_realm_raid" },
          "realm_threshold": { "ref": "blackboard.realm_threshold" },
          "pass_roi": { "ref": "blackboard.realm_pass_roi" },
          "entry_point": { "ref": "blackboard.realm_entry_point" },
          "target_points": { "ref": "blackboard.realm_target_points" },
          "target_rois": { "ref": "blackboard.realm_target_rois" },
          "completed_texts": { "ref": "blackboard.realm_completed_texts" },
          "completed_templates": { "ref": "blackboard.realm_completed_templates" },
          "leave_current_screen": false,
          "souls_courtyard_template": "assets/templates/souls/courtyard-explore/mumu-0.png"
        }
      }
    },
    {
      "id": "task_in_souls_1",
      "type": "task",
      "action": "workflow.run",
      "params": {
        "workflow": "shared/recover_to_souls.json",
        "inputs": {
          "courtyard_template": "assets/templates/souls/courtyard-explore/mumu-0.png"
        }
      },
      "name": "优先使用统一多状态恢复流程"
    }
  ],
  "_layout": {
    "detect_party_room": {
      "x": 0,
      "y": 832
    },
    "already_in_party_room": {
      "x": 0,
      "y": 624
    },
    "detect_courtyard_explore": {
      "x": 664,
      "y": 1456
    },
    "wake_hidden_ui": {
      "x": 996,
      "y": 1664
    },
    "detect_courtyard_explore_after_wake": {
      "x": 1328,
      "y": 1664
    },
    "wake_hidden_courtyard": {
      "x": 1162,
