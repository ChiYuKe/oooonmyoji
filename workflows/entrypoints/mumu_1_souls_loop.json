{
  "schema_version": 3,
  "id": "mumu_1_souls_loop",
  "version": "3.1.0",
  "resolution": [
    1920,
    1080
  ],
  "root": "root",
  "limits": {
    "timeout_seconds": 7200,
    "max_steps": 1000
  },
  "blackboard": {},
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "name": "御魂循环入口",
      "children": [
        "main"
      ]
    },
    {
      "id": "main",
      "type": "sequence",
      "name": "进入副本并循环战斗",
      "children": [
        "prepare_entry",
        "enter_souls",
        "battle_loop"
      ]
    },
    {
      "id": "prepare_entry",
      "type": "selector",
      "name": "检查并恢复入口页面",
      "children": [
        "entry_page_supported",
        "return_to_courtyard"
      ]
    },
    {
      "id": "entry_page_supported",
      "type": "selector",
      "name": "当前页面可直接进入御魂",
      "children": [
        "preflight_floor",
        "preflight_souls_type",
        "preflight_explore_map",
        "preflight_courtyard"
      ]
    },
    {
      "id": "preflight_floor",
      "type": "task",
      "name": "预检御魂副本页",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-challenge.png",
        "timeout_seconds": 0.5,
        "roi": [
          1550,
          750,
          370,
          330
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "preflight_souls_type",
      "type": "task",
      "name": "预检御魂类型页",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-orochi.png",
        "timeout_seconds": 0.5,
        "roi": [
          0,
          80,
          600,
          850
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "preflight_explore_map",
      "type": "task",
      "name": "预检探索地图",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/map-souls.png",
        "timeout_seconds": 0.5,
        "roi": [
          150,
          850,
          250,
          230
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "preflight_courtyard",
      "type": "task",
      "name": "预检庭院",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/courtyard-explore/mumu-1.png",
        "timeout_seconds": 0.5,
        "roi": [
          450,
          80,
          650,
          350
        ],
        "threshold": 0.65,
        "scale_search": false
      }
    },
    {
      "id": "return_to_courtyard",
      "type": "sequence",
      "name": "点击快捷按钮返回庭院",
      "children": [
        "detect_return_courtyard",
        "tap_return_courtyard",
        "wait_courtyard_after_return"
      ]
    },
    {
      "id": "detect_return_courtyard",
      "type": "task",
      "name": "检测返回庭院按钮",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/return-courtyard.png",
        "timeout_seconds": 2,
        "roi": [
          100,
          0,
          140,
          120
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "tap_return_courtyard",
      "type": "task",
      "name": "返回庭院",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.detect_return_courtyard.output.0"
        },
        "revalidate": true,
        "random_offset": 3,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_courtyard_after_return",
      "type": "task",
      "name": "等待返回庭院",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/courtyard-explore/mumu-1.png",
        "timeout_seconds": 20,
        "roi": [
          450,
          80,
          650,
          350
        ],
        "threshold": 0.65,
        "scale_search": false
      }
    },
    {
      "id": "enter_souls",
      "type": "selector",
      "name": "恢复到御魂副本页",
      "children": [
        "already_at_floor",
        "from_souls_type",
        "from_explore_map",
        "from_courtyard"
      ]
    },
    {
      "id": "already_at_floor",
      "type": "sequence",
      "name": "已经在御魂副本页",
      "children": [
        "detect_floor"
      ]
    },
    {
      "id": "detect_floor",
      "type": "task",
      "name": "检测挑战按钮",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-challenge.png",
        "timeout_seconds": 1,
        "roi": [
          1550,
          750,
          370,
          330
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "from_souls_type",
      "type": "sequence",
      "name": "从御魂类型页进入",
      "children": [
        "detect_orochi_type",
        "tap_orochi_type",
        "wait_floor_from_type"
      ]
    },
    {
      "id": "detect_orochi_type",
      "type": "task",
      "name": "检测大蛇副本",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-orochi.png",
        "timeout_seconds": 1,
        "roi": [
          0,
          80,
          600,
          850
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "tap_orochi_type",
      "type": "task",
      "name": "进入大蛇副本",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.detect_orochi_type.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_floor_from_type",
      "type": "task",
      "name": "等待御魂副本页",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-challenge.png",
        "timeout_seconds": 20,
        "roi": [
          1550,
          750,
          370,
          330
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "from_explore_map",
      "type": "sequence",
      "name": "从探索地图进入",
      "children": [
        "detect_map_souls",
        "tap_map_souls",
        "wait_orochi_from_map",
        "tap_orochi_from_map",
        "wait_floor_from_map"
      ]
    },
    {
      "id": "detect_map_souls",
      "type": "task",
      "name": "检测地图御魂入口",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/map-souls.png",
        "timeout_seconds": 1,
        "roi": [
          150,
          850,
          250,
          230
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "tap_map_souls",
      "type": "task",
      "name": "点击地图御魂入口",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.detect_map_souls.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_orochi_from_map",
      "type": "task",
      "name": "等待大蛇副本入口",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-orochi.png",
        "timeout_seconds": 20,
        "roi": [
          0,
          80,
          600,
          850
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "tap_orochi_from_map",
      "type": "task",
      "name": "进入大蛇副本",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_orochi_from_map.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_floor_from_map",
      "type": "task",
      "name": "等待御魂副本页",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-challenge.png",
        "timeout_seconds": 20,
        "roi": [
          1550,
          750,
          370,
          330
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "from_courtyard",
      "type": "sequence",
      "name": "从庭院进入",
      "children": [
        "wait_courtyard_explore",
        "tap_courtyard_explore",
        "wait_map_from_courtyard",
        "tap_map_from_courtyard",
        "wait_orochi_from_courtyard",
        "tap_orochi_from_courtyard",
        "wait_floor_from_courtyard"
      ]
    },
    {
      "id": "wait_courtyard_explore",
      "type": "task",
      "name": "等待庭院探索入口",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/courtyard-explore/mumu-1.png",
        "timeout_seconds": 5,
        "roi": [
          450,
          80,
          650,
          350
        ],
        "threshold": 0.65,
        "scale_search": false
      }
    },
    {
      "id": "tap_courtyard_explore",
      "type": "task",
      "name": "点击探索入口",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_courtyard_explore.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_map_from_courtyard",
      "type": "task",
      "name": "等待地图御魂入口",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/map-souls.png",
        "timeout_seconds": 20,
        "roi": [
          150,
          850,
          250,
          230
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "tap_map_from_courtyard",
      "type": "task",
      "name": "点击地图御魂入口",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_map_from_courtyard.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_orochi_from_courtyard",
      "type": "task",
      "name": "等待大蛇副本入口",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-orochi.png",
        "timeout_seconds": 20,
        "roi": [
          0,
          80,
          600,
          850
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "tap_orochi_from_courtyard",
      "type": "task",
      "name": "进入大蛇副本",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_orochi_from_courtyard.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_floor_from_courtyard",
      "type": "task",
      "name": "等待御魂副本页",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-challenge.png",
        "timeout_seconds": 20,
        "roi": [
          1550,
          750,
          370,
          330
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "battle_loop",
      "type": "sequence",
      "name": "循环战斗 30 次",
      "children": [
        "wait_challenge",
        "tap_challenge",
        "prepare_lineup",
        "await_victory",
        "settlement"
      ],
      "decorators": [
        {
          "type": "repeat",
          "count": 30
        },
        {
          "type": "timeout",
          "seconds": 7000
        }
      ]
    },
    {
      "id": "wait_challenge",
      "type": "task",
      "name": "等待挑战按钮",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-challenge.png",
        "timeout_seconds": 30,
        "roi": [
          1550,
          750,
          370,
          330
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "tap_challenge",
      "type": "task",
      "name": "点击挑战",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_challenge.output.0"
        },
        "revalidate": true,
        "random_offset": 5,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "prepare_lineup",
      "type": "task",
      "name": "等待并点击编队准备",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/shared/prepare_lineup.json",
        "inputs": {
          "timeout_seconds": 30
        }
      }
    },
    {
      "id": "await_victory",
      "type": "task",
      "name": "等待战斗胜利并继续",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/shared/await_victory.json",
        "inputs": {
          "timeout_seconds": 180
        }
      }
    },
    {
      "id": "settlement",
      "type": "selector",
      "name": "兼容普通结算与奖励弹层",
      "children": [
        "settled_direct",
        "settled_one_tap",
        "settled_more_taps"
      ]
    },
    {
      "id": "settled_direct",
      "type": "sequence",
      "name": "结算直接返回",
      "children": [
        "wait_floor_direct"
      ]
    },
    {
      "id": "wait_floor_direct",
      "type": "task",
      "name": "短暂等待副本页",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-challenge.png",
        "timeout_seconds": 3,
        "roi": [
          1550,
          750,
          370,
          330
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "settled_one_tap",
      "type": "sequence",
      "name": "关闭一层奖励",
      "children": [
        "stats_reward_layer_1",
        "dismiss_reward_once",
        "wait_floor_after_one"
      ]
    },
    {
      "id": "stats_reward_layer_1",
      "type": "task",
      "name": "后台统计第一层奖励",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/shared/reward_statistics.json",
        "inputs": {
          "category": "souls",
          "layer": 1
        }
      }
    },
    {
      "id": "dismiss_reward_once",
      "type": "task",
      "name": "关闭奖励弹层",
      "action": "input.tap",
      "params": {
        "x": 1500,
        "y": 850,
        "random_offset": 12,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_floor_after_one",
      "type": "task",
      "name": "等待副本页返回",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-challenge.png",
        "timeout_seconds": 6,
        "roi": [
          1550,
          750,
          370,
          330
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "settled_more_taps",
      "type": "sequence",
      "name": "关闭多层奖励",
      "children": [
        "stats_reward_layer_2",
        "dismiss_reward_twice_a",
        "settlement_pause",
        "stats_reward_layer_3",
        "dismiss_reward_twice_b",
        "wait_floor_after_more"
      ]
    },
    {
      "id": "stats_reward_layer_2",
      "type": "task",
      "name": "后台统计第二层奖励",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/shared/reward_statistics.json",
        "inputs": {
          "category": "souls",
          "layer": 2
        }
      }
    },
    {
      "id": "dismiss_reward_twice_a",
      "type": "task",
      "name": "关闭第一层奖励",
      "action": "input.tap",
      "params": {
        "x": 1500,
        "y": 850,
        "random_offset": 12,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "settlement_pause",
      "type": "task",
      "name": "等待奖励动画",
      "action": "core.sleep",
      "params": {
        "seconds": 1
      }
    },
    {
      "id": "stats_reward_layer_3",
      "type": "task",
      "name": "后台统计第三层奖励",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/shared/reward_statistics.json",
        "inputs": {
          "category": "souls",
          "layer": 3
        }
      }
    },
    {
      "id": "dismiss_reward_twice_b",
      "type": "task",
      "name": "关闭第二层奖励",
      "action": "input.tap",
      "params": {
        "x": 1500,
        "y": 850,
        "random_offset": 12,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_floor_after_more",
      "type": "task",
      "name": "等待副本页返回",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-challenge.png",
        "timeout_seconds": 10,
        "roi": [
          1550,
          750,
          370,
          330
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    }
  ]
}
