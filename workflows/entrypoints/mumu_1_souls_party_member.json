{
  "schema_version": 4,
  "id": "mumu_1_souls_party_member",
  "version": "4.2.0",
  "description": "MuMu-1 队员入口：等待并接受队长邀请，按配置轮数完成组队御魂，达到券数阈值后执行结界突破。",
  "resolution": [
    1920,
    1080
  ],
  "root": "root",
  "limits": {
    "timeout_seconds": 1209600,
    "max_steps": 1000
  },
  "inputs": {
    "运行轮数": {
      "type": "integer",
      "default": 9999,
      "min": 1,
      "max": 9999
    },
    "启用结界突破": {
      "type": "boolean",
      "default": true
    },
    "结界突破阈值": {
      "type": "integer",
      "default": 30,
      "min": 1
    },
    "结界通关识别区域": {
      "type": "rect",
      "default": [
        1450,
        0,
        470,
        180
      ]
    },
    "结界突破入口位置": {
      "type": "rect",
      "default": [
        450,
        1000,
        0,
        0
      ]
    },
    "结界目标点击位置列表": {
      "type": "array",
      "default": [
        [
          500,
          275,
          0,
          0
        ],
        [
          1000,
          275,
          0,
          0
        ],
        [
          1500,
          275,
          0,
          0
        ],
        [
          500,
          475,
          0,
          0
        ],
        [
          1000,
          475,
          0,
          0
        ],
        [
          1500,
          475,
          0,
          0
        ],
        [
          500,
          675,
          0,
          0
        ],
        [
          1000,
          675,
          0,
          0
        ],
        [
          1500,
          675,
          0,
          0
        ]
      ],
      "items": {
        "type": "rect"
      }
    },
    "结界目标识别区域列表": {
      "type": "array",
      "default": [
        [
          220,
          220,
          500,
          190
        ],
        [
          720,
          220,
          500,
          190
        ],
        [
          1220,
          220,
          500,
          190
        ],
        [
          220,
          420,
          500,
          190
        ],
        [
          720,
          420,
          500,
          190
        ],
        [
          1220,
          420,
          500,
          190
        ],
        [
          220,
          620,
          500,
          190
        ],
        [
          720,
          620,
          500,
          190
        ],
        [
          1220,
          620,
          500,
          190
        ]
      ],
      "items": {
        "type": "rect"
      }
    },
    "结界完成文字列表": {
      "type": "array",
      "default": [
        "已挑战",
        "已击败",
        "胜利",
        "占领"
      ],
      "items": {
        "type": "string",
        "min_length": 1
      }
    },
    "结界完成模板列表": {
      "type": "array",
      "default": [],
      "items": {
        "type": "asset",
        "min_length": 1
      }
    }
  },
  "variables": {},
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "name": "mumu1 御魂组队队员",
      "children": [
        "main"
      ]
    },
    {
      "id": "main",
      "type": "sequence",
      "name": "启动调度后执行组队御魂",
      "children": [
        "entry_recovery",
        "battle_plan",
        "final_recovery"
      ]
    },
    {
      "id": "entry_recovery",
      "type": "task",
      "name": "清理残留页面并保留可接受邀请状态",
      "action": "workflow.run",
      "params": {
        "workflow": "shared/recover_to_souls.json",
        "inputs": {
          "庭院入口模板": "assets/templates/souls/courtyard-explore/mumu-1.png",
          "目标状态列表": [
            "party_room",
            "invite_popup",
            "souls_challenge"
          ]
        }
      }
    },
    {
      "id": "final_recovery",
      "type": "task",
      "name": "末轮后退出队伍并确认御魂挑战页",
      "action": "workflow.run",
      "params": {
        "workflow": "shared/recover_to_souls.json",
        "inputs": {
          "庭院入口模板": "assets/templates/souls/courtyard-explore/mumu-1.png"
        }
      }
    },
    {
      "id": "battle_plan",
      "type": "selector",
      "name": "按配置轮数执行并在末轮停止自动准备",
      "children": [
        "final_round",
        "automatic_round"
      ],
      "decorators": [
        {
          "type": "repeat",
          "count": {
            "ref": "inputs.运行轮数"
          }
        },
        {
          "type": "timeout",
          "seconds": 1209000
        }
      ]
    },
    {
      "id": "final_round",
      "type": "task",
      "name": "最后一轮完成后停止等待续邀",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/party/member_round.json",
        "inputs": {
          "执行阶段": "finish",
          "启用结界突破": {
            "ref": "inputs.启用结界突破"
          },
          "结界突破阈值": {
            "ref": "inputs.结界突破阈值"
          },
          "结界通关识别区域": {
            "ref": "inputs.结界通关识别区域"
          },
          "结界突破入口位置": {
            "ref": "inputs.结界突破入口位置"
          },
          "结界目标点击位置列表": {
            "ref": "inputs.结界目标点击位置列表"
          },
          "结界目标识别区域列表": {
            "ref": "inputs.结界目标识别区域列表"
          },
          "结界完成文字列表": {
            "ref": "inputs.结界完成文字列表"
          },
          "结界完成模板列表": {
            "ref": "inputs.结界完成模板列表"
          }
        }
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "eq": [
              {
                "ref": "runtime.repeat.final"
              },
              true
            ]
          }
        }
      ]
    },
    {
      "id": "automatic_round",
      "type": "task",
      "name": "非末轮启用或沿用自动准备",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/party/member_round.json",
        "inputs": {
          "执行阶段": "setup_auto_ready",
          "启用结界突破": {
            "ref": "inputs.启用结界突破"
          },
          "结界突破阈值": {
            "ref": "inputs.结界突破阈值"
          },
          "结界通关识别区域": {
            "ref": "inputs.结界通关识别区域"
          },
          "结界突破入口位置": {
            "ref": "inputs.结界突破入口位置"
          },
          "结界目标点击位置列表": {
            "ref": "inputs.结界目标点击位置列表"
          },
          "结界目标识别区域列表": {
            "ref": "inputs.结界目标识别区域列表"
          },
          "结界完成文字列表": {
            "ref": "inputs.结界完成文字列表"
          },
          "结界完成模板列表": {
            "ref": "inputs.结界完成模板列表"
          }
        }
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "eq": [
              {
                "ref": "runtime.repeat.final"
              },
              false
            ]
          }
        }
      ]
    }
  ]
}
