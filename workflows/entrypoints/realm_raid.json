{
  "schema_version": 4,
  "id": "realm_raid",
  "version": "1.1.0",
  "description": "单独运行结界突破；支持按实例覆盖入口坐标、券区域、九个目标坐标和 OCR 文本。",
  "resolution": [1920, 1080],
  "root": "root",
  "limits": { "timeout_seconds": 7200, "max_steps": 3000 },
  "inputs": {
    "入口点击位置": { "type": "rect", "default": [450, 1000, 0, 0] },
    "结界突破地图入口模板": { "type": "asset", "default": "assets/templates/realm/map-entry.png" },
    "通关状态识别区域": { "type": "rect", "default": [1450, 0, 470, 180] },
    "目标数量上限": { "type": "integer", "default": 9, "min": 1, "max": 9 },
    "恢复御魂任务": { "type": "boolean", "default": false },
    "页面识别文字列表": { "type": "array", "default": ["结界突破"], "items": { "type": "string", "min_length": 1 } },
    "页面识别区域": { "type": "rect", "default": [0, 0, 1920, 260] },
    "战斗页面识别文字": { "type": "array", "default": ["战斗", "退出", "点击屏幕继续", "点击屏幕", "继续"], "items": { "type": "string", "min_length": 1 } },
    "胜利页面识别文字": { "type": "array", "default": ["胜利", "结算", "奖励", "获得", "点击屏幕继续", "点击屏幕", "继续"], "items": { "type": "string", "min_length": 1 } },
    "结算页面模板": { "type": "asset", "default": "assets/templates/souls/souls-victory-continue.png" },
    "结算识别区域": { "type": "rect", "default": [650, 900, 650, 180] },
    "战斗识别区域": { "type": "rect", "default": [0, 0, 1920, 1080] },
    "目标点击位置列表": { "type": "array", "default": [[450, 275, 0, 0], [960, 275, 0, 0], [1500, 275, 0, 0], [450, 475, 0, 0], [960, 475, 0, 0], [1500, 475, 0, 0], [450, 675, 0, 0], [960, 675, 0, 0], [1500, 675, 0, 0]], "items": { "type": "rect" } },
    "攻击目标位置列表": { "type": "array", "default": [[580, 580, 0, 0], [1080, 580, 0, 0], [1570, 580, 0, 0], [580, 780, 0, 0], [1080, 780, 0, 0], [1570, 780, 0, 0], [580, 950, 0, 0], [1080, 950, 0, 0], [1570, 950, 0, 0]], "items": { "type": "rect" } },
    "准备按钮点击位置": { "type": "rect", "default": [1780, 900, 0, 0] },
    "退出确认文字列表": { "type": "array", "default": ["确认退出战斗吗", "确认退出战斗", "确认退出"], "items": { "type": "string", "min_length": 1 } },
    "退出确认识别区域": { "type": "rect", "default": [600, 350, 720, 380] },
    "退出确认点击位置": { "type": "rect", "default": [1110, 635, 0, 0] },
    "再次挑战点击位置": { "type": "rect", "default": [1300, 760, 0, 0] },
    "再次挑战确认文字列表": { "type": "array", "default": ["是否再次挑战", "再次挑战"], "items": { "type": "string", "min_length": 1 } },
    "再次挑战确认区域": { "type": "rect", "default": [600, 350, 720, 380] },
    "再次挑战确认位置": { "type": "rect", "default": [1135, 650, 0, 0] },
    "再次挑战复选框位置": { "type": "rect", "default": [810, 540, 0, 0] },
    "攻击点击位置": { "type": "rect", "default": [1570, 580, 0, 0] },
    "目标识别区域列表": { "type": "array", "default": [[220, 220, 500, 190], [720, 220, 500, 190], [1220, 220, 500, 190], [220, 420, 500, 190], [720, 420, 500, 190], [1220, 420, 500, 190], [220, 620, 500, 190], [720, 620, 500, 190], [1220, 620, 500, 190]], "items": { "type": "rect" } },
    "完成状态文字列表": { "type": "array", "default": ["已挑战", "已击败", "胜利", "占领"], "items": { "type": "string", "min_length": 1 } },
    "完成状态模板列表": { "type": "array", "default": [], "items": { "type": "asset", "min_length": 1 } },
    "离开当前页面": { "type": "boolean", "default": true },
    "御魂庭院入口模板": { "type": "asset", "default": "assets/templates/souls/courtyard-explore/mumu-1.png" }
  },
  "variables": {},
  "nodes": [
    { "id": "root", "type": "root", "name": "单独运行结界突破", "children": ["run"] },
    { "id": "run", "type": "task", "name": "按目标上限执行结界突破", "action": "workflow.run", "params": { "workflow": "realm/shared/realm_raid_loop.json", "inputs": { "入口点击位置": { "ref": "inputs.入口点击位置" }, "结界突破地图入口模板": { "ref": "inputs.结界突破地图入口模板" }, "通关状态识别区域": { "ref": "inputs.通关状态识别区域" }, "目标数量上限": { "ref": "inputs.目标数量上限" }, "页面识别文字列表": { "ref": "inputs.页面识别文字列表" }, "页面识别区域": { "ref": "inputs.页面识别区域" }, "战斗页面识别文字": { "ref": "inputs.战斗页面识别文字" }, "胜利页面识别文字": { "ref": "inputs.胜利页面识别文字" }, "结算页面模板": { "ref": "inputs.结算页面模板" }, "结算识别区域": { "ref": "inputs.结算识别区域" }, "战斗识别区域": { "ref": "inputs.战斗识别区域" }, "目标点击位置列表": { "ref": "inputs.目标点击位置列表" }, "目标识别区域列表": { "ref": "inputs.目标识别区域列表" }, "完成状态文字列表": { "ref": "inputs.完成状态文字列表" }, "完成状态模板列表": { "ref": "inputs.完成状态模板列表" }, "攻击目标位置列表": { "ref": "inputs.攻击目标位置列表" }, "准备按钮点击位置": { "ref": "inputs.准备按钮点击位置" }, "退出确认文字列表": { "ref": "inputs.退出确认文字列表" }, "退出确认识别区域": { "ref": "inputs.退出确认识别区域" }, "退出确认点击位置": { "ref": "inputs.退出确认点击位置" }, "再次挑战点击位置": { "ref": "inputs.再次挑战点击位置" }, "再次挑战确认文字列表": { "ref": "inputs.再次挑战确认文字列表" }, "再次挑战确认区域": { "ref": "inputs.再次挑战确认区域" }, "再次挑战确认位置": { "ref": "inputs.再次挑战确认位置" }, "再次挑战复选框位置": { "ref": "inputs.再次挑战复选框位置" }, "离开当前页面": { "ref": "inputs.离开当前页面" }, "恢复御魂任务": { "ref": "inputs.恢复御魂任务" }, "御魂庭院入口模板": { "ref": "inputs.御魂庭院入口模板" } } } }
  ]
}
