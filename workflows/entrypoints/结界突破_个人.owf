workflow 结界突破_个人
  version: 5.0.0
  description: "个人结界突破挂机（不点刷新）：每轮用 selector 从卡 1 到卡 9 逐个试——点卡片后调 结界突破_单场，弹窗里 3 秒内出现「进攻」按钮就打完整场（该卡未破），没出现（卡已破）就换下一张；9 张全破时游戏自动刷新，下一轮扫描自然从卡 1 重新开始。轮数默认 30，对应打满 30/30 张突破符。"
  resolution: [1920, 1080]
  root: root_1
  inputs:
    突破轮数:
      type: integer
      default: 30
      min: 1
      description: "共进攻多少次；每次进攻消耗 1 张突破符，30 = 一次打满 30/30。突破符耗尽后整轮扫描全部落空，重试耗尽即失败退出（约 3 分钟）。"
  variables: {}
  node root_1 root 入口
    at: [600, -136]
  node sequence_1 sequence "主循环：repeat 轮数 × 逐卡扫描"
    at: [600, 240]
    decorator repeat
    decorator retry
      attempts: 2
      delay_seconds: 2
  node selector_1 selector "逐卡试打：点卡片 → 弹窗有「进攻」就打完整场；没弹换下一张"
    at: [600, 560]
    decorator retry
      attempts: 3
      delay_seconds: 2
  node sequence_2 sequence 卡1
    at: [168, 856]
  node task_1 task 点卡片1（行1列1）
    at: [-96, 1016]
    action: input.tap
    params:
      x: 459
      y: 308
      random_interval: [0.3, 0.6]
      random_offset: 12
  node task_2 task 调单场进攻
    at: [160, 1016]
    action: workflow.run
    params:
      workflow: 结界突破_单场.owf
      inputs: {}
  node sequence_3 sequence 卡2
    at: [328, 856]
  node task_3 task 点卡片2（行1列2）
