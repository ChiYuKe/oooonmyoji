{
  "schema_version": 3,
  "id": "three_instance_parallel",
  "version": "2.0.1",
  "description": "同时启动三个 MuMu 实例，各自执行指定入口工作流",
  "resolution": [
    1920,
    1080
  ],
  "limits": {
    "timeout_seconds": 1209600,
    "max_steps": 1000
  },
  "blackboard": {
    "rounds": {
      "type": "integer",
      "public": true,
      "required": false,
      "default": 9999,
      "enum": [
        1,
        9999
      ]
    },
    "enable_realm_raid": { "type": "boolean", "public": true, "default": false },
    "realm_threshold": { "type": "integer", "public": true, "default": 30, "min": 1 },
    "realm_pass_roi": { "type": "rect", "public": true, "default": [1450, 0, 470, 180] },
    "realm_entry_point": { "type": "rect", "public": true, "default": [1760, 900, 0, 0] },
    "realm_target_points": { "type": "array", "public": true, "default": [[450, 380, 0, 0], [960, 380, 0, 0], [1470, 380, 0, 0], [450, 610, 0, 0], [960, 610, 0, 0], [1470, 610, 0, 0], [450, 840, 0, 0], [960, 840, 0, 0], [1470, 840, 0, 0]], "items": { "type": "rect" } }
  },
  "root": "root",
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "name": "三实例并行入口",
      "children": [
        "run_all_instances"
      ]
    },
    {
      "id": "run_all_instances",
      "type": "instance_parallel",
      "name": "同时启动 MuMu-0、1、2",
      "wait_for": "all",
      "cancel_on_failure": true,
      "runs": [
        {
          "instance": "mumu-0",
          "workflow": "entrypoints/mumu_0_souls_party_leader.json",
          "inputs": {
            "rounds": {
              "ref": "blackboard.rounds"
            },
            "enable_realm_raid": { "ref": "blackboard.enable_realm_raid" },
            "realm_threshold": { "ref": "blackboard.realm_threshold" },
            "realm_pass_roi": { "ref": "blackboard.realm_pass_roi" },
            "realm_entry_point": { "ref": "blackboard.realm_entry_point" },
            "realm_target_points": { "ref": "blackboard.realm_target_points" }
          }
        },
        {
          "instance": "mumu-1",
          "workflow": "entrypoints/mumu_1_souls_party_member.json",
          "inputs": {
            "rounds": {
              "ref": "blackboard.rounds"
            },
            "enable_realm_raid": { "ref": "blackboard.enable_realm_raid" },
            "realm_threshold": { "ref": "blackboard.realm_threshold" },
            "realm_pass_roi": { "ref": "blackboard.realm_pass_roi" },
            "realm_entry_point": { "ref": "blackboard.realm_entry_point" },
            "realm_target_points": { "ref": "blackboard.realm_target_points" }
          }
        },
        {
          "instance": "mumu-2",
          "workflow": "entrypoints/mumu_1_souls_loop.json",
          "inputs": {
            "enable_realm_raid": { "ref": "blackboard.enable_realm_raid" },
            "realm_threshold": { "ref": "blackboard.realm_threshold" },
            "realm_pass_roi": { "ref": "blackboard.realm_pass_roi" },
            "realm_entry_point": { "ref": "blackboard.realm_entry_point" },
            "realm_target_points": { "ref": "blackboard.realm_target_points" }
          }
        }
      ]
    }
  ],
  "_layout": {
    "run_all_instances": {
      "x": 0,
      "y": 208
    },
    "root": {
      "x": 0,
      "y": 0
    }
  },
  "_variableCards": {}
}
