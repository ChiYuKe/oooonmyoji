{
  "schema_version": 4,
  "id": "three_instance_parallel",
  "version": "2.0.1",
  "description": "同时启动三个 MuMu 实例，各自执行指定入口工作流",
  "resolution": [
    1920,
    1080
  ],
  "limits": {
    "timeout_seconds": 1209600,
    "max_steps": 1000
  },
  "inputs": {
    "运行轮数": {
      "type": "integer",
      "required": false,
      "default": 9999,
      "enum": [
        1,
        9999
      ]
    },
    "启用结界突破": {
      "type": "boolean",
      "default": true
    },
    "结界突破阈值": {
      "type": "integer",
      "default": 30,
      "min": 1
    },
    "结界通关识别区域": {
      "type": "rect",
      "default": [
        1450,
        0,
        470,
        180
      ]
    },
    "结界突破入口位置": {
      "type": "rect",
      "default": [
        1760,
        900,
        0,
        0
      ]
    },
    "结界目标点击位置列表": {
      "type": "array",
      "default": [
        [
          450,
          380,
          0,
          0
        ],
        [
          960,
          380,
          0,
          0
        ],
        [
          1470,
          380,
          0,
          0
        ],
        [
          450,
          610,
          0,
          0
        ],
        [
          960,
          610,
          0,
          0
        ],
        [
          1470,
          610,
          0,
          0
        ],
        [
          450,
          840,
          0,
          0
        ],
        [
          960,
          840,
          0,
          0
        ],
        [
          1470,
          840,
          0,
          0
        ]
      ],
      "items": {
        "type": "rect"
      }
    }
  },
  "root": "root",
  "variables": {},
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "name": "三实例并行入口",
      "children": [
        "run_all_instances"
      ]
    },
    {
      "id": "run_all_instances",
      "type": "instance_parallel",
      "name": "同时启动 MuMu-0、1、2",
      "wait_for": "all",
      "cancel_on_failure": true,
      "runs": [
        {
          "instance": "mumu-0",
          "workflow": "entrypoints/mumu_0_souls_party_leader.json",
          "inputs": {
            "运行轮数": {
              "ref": "inputs.运行轮数"
            }
          }
        },
        {
          "instance": "mumu-1",
          "workflow": "entrypoints/mumu_1_souls_party_member.json",
          "inputs": {
            "运行轮数": {
              "ref": "inputs.运行轮数"
            },
            "启用结界突破": {
              "ref": "inputs.启用结界突破"
            },
            "结界突破阈值": {
              "ref": "inputs.结界突破阈值"
            },
            "结界通关识别区域": {
              "ref": "inputs.结界通关识别区域"
            },
            "结界突破入口位置": {
              "ref": "inputs.结界突破入口位置"
            },
            "结界目标点击位置列表": {
              "ref": "inputs.结界目标点击位置列表"
            }
          }
        },
        {
          "instance": "mumu-2",
          "workflow": "entrypoints/mumu_1_souls_loop.json",
          "inputs": {
            "启用结界突破": {
              "ref": "inputs.启用结界突破"
            },
            "结界突破阈值": {
              "ref": "inputs.结界突破阈值"
            },
            "结界通关识别区域": {
              "ref": "inputs.结界通关识别区域"
            },
            "结界突破入口位置": {
              "ref": "inputs.结界突破入口位置"
            },
            "结界目标点击位置列表": {
              "ref": "inputs.结界目标点击位置列表"
            }
          }
        }
      ]
    }
  ],
  "_layout": {
    "run_all_instances": {
      "x": 0,
      "y": 208
    },
    "root": {
      "x": 0,
      "y": 0
    }
  },
  "_variableCards": {}
}
