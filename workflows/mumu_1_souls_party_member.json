{
  "schema_version": 3,
  "id": "mumu_1_souls_party_member",
  "version": "3.0.1",
  "resolution": [1920, 1080],
  "root": "root",
  "limits": {
    "timeout_seconds": 1209600,
    "max_steps": 1000
  },
  "blackboard": {
    "rounds": {
      "type": "integer",
      "required": true,
      "default": 9999,
      "enum": [1, 9999]
    }
  },
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "name": "mumu1 御魂组队队员",
      "children": ["battle_plan"]
    },
    {
      "id": "battle_plan",
      "type": "selector",
      "name": "选择单轮验证或 9999 轮运行",
      "children": ["single_round", "long_run_plan"]
    },
    {
      "id": "single_round",
      "type": "task",
      "name": "接受邀请并完成 1 轮",
      "action": "workflow.run",
      "params": {
        "workflow": "souls_party_member_round.json",
        "inputs": {"phase": "finish"}
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {"eq": [{"ref": "blackboard.rounds"}, 1]}
        }
      ]
    },
    {
      "id": "long_run_plan",
      "type": "sequence",
      "name": "首轮启用自动准备后连续运行 9999 轮",
      "children": ["setup_auto_ready_round", "repeat_auto_ready_rounds"],
      "decorators": [
        {
          "type": "condition",
          "expression": {"eq": [{"ref": "blackboard.rounds"}, 9999]}
        }
      ]
    },
    {
      "id": "setup_auto_ready_round",
      "type": "task",
      "name": "首轮接受限时邀请并启用不再提示",
      "action": "workflow.run",
      "params": {
        "workflow": "souls_party_member_round.json",
        "inputs": {"phase": "setup_auto_ready"}
      }
    },
    {
      "id": "repeat_auto_ready_rounds",
      "type": "task",
      "name": "自动接受邀请并完成后 9998 轮",
      "action": "workflow.run",
      "params": {
        "workflow": "souls_party_member_round.json",
        "inputs": {"phase": "auto_ready"}
      },
      "decorators": [
        {"type": "repeat", "count": 9998},
        {"type": "timeout", "seconds": 1209000}
      ]
    }
  ]
}
