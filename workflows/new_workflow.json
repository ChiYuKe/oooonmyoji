{
  "schema_version": 3,
  "id": "new_workflow",
  "version": "3.0.0",
  "resolution": [
    1920,
    1080
  ],
  "root": "root",
  "limits": {
    "timeout_seconds": 300,
    "max_steps": 1000
  },
  "blackboard": {},
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "children": [
        "sequence_1"
      ]
    },
    {
      "id": "sequence_1",
      "type": "sequence",
      "children": [
        "task_1",
        "task_2",
        "task_3"
      ],
      "decorators": []
    },
    {
      "id": "task_2",
      "type": "task",
      "action": "vision.match_template",
      "params": {
        "template": "assets/templates/task_2-template.png",
        "roi": [
          1669,
          823,
          235,
          237
        ]
      },
      "name": "识别模板"
    },
    {
      "id": "task_3",
      "type": "task",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.task_2.output.0"
        },
        "revalidate": true,
        "random_offset": 10,
        "hold_ms": 0,
        "random_interval": [
          0.2,
          0.4
        ]
      },
      "decorators": [],
      "name": "点击模板"
    },
    {
      "id": "task_1",
      "type": "task",
      "action": "core.capture",
      "params": {},
      "name": "截屏"
    }
  ],
  "_layout": {
    "root": {
      "x": 332,
      "y": 0
    },
    "sequence_1": {
      "x": 332,
      "y": 208
    },
    "task_2": {
      "x": 332,
      "y": 416
    },
    "task_3": {
      "x": 664,
      "y": 416
    },
    "task_1": {
      "x": 0,
      "y": 416
    }
  }
}
