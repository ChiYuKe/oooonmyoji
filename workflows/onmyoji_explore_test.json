{
  "schema_version": 1,
  "id": "onmyoji_explore_test",
  "version": "1.0.0",
  "reference_resolution": [1920, 1080],
  "entry": "capture_launcher",
  "limits": {
    "timeout_seconds": 120,
    "max_steps": 40
  },
  "inputs_schema": {
    "type": "object",
    "properties": {
      "launch_x": {"type": "integer", "minimum": 0, "default": 1204},
      "launch_y": {"type": "integer", "minimum": 0, "default": 557},
      "enter_x": {"type": "integer", "minimum": 0, "default": 955},
      "enter_y": {"type": "integer", "minimum": 0, "default": 895},
      "explore_x": {"type": "integer", "minimum": 0, "default": 975},
      "explore_y": {"type": "integer", "minimum": 0, "default": 220},
      "target_x": {"type": "integer", "minimum": 0, "default": 173},
      "target_y": {"type": "integer", "minimum": 0, "default": 54},
      "hold_ms": {"type": "integer", "minimum": 0, "default": 50},
      "wait_after_launch": {"type": "number", "minimum": 0, "default": 8},
      "wait_after_enter": {"type": "number", "minimum": 0, "default": 5},
      "wait_after_explore": {"type": "number", "minimum": 0, "default": 5},
      "wait_after_target": {"type": "number", "minimum": 0, "default": 2}
    },
    "additionalProperties": false
  },
  "steps": [
    {
      "id": "capture_launcher",
      "action": "core.capture",
      "on_success": "save_launcher"
    },
    {
      "id": "save_launcher",
      "action": "core.save_frame",
      "with": {"name": "01-launcher-before.png"},
      "on_success": "tap_launch"
    },
    {
      "id": "tap_launch",
      "action": "input.tap",
      "with": {
        "x": {"$ref": "inputs.launch_x"},
        "y": {"$ref": "inputs.launch_y"},
        "hold_ms": {"$ref": "inputs.hold_ms"}
      },
      "on_success": "wait_after_launch"
    },
    {
      "id": "wait_after_launch",
      "action": "core.sleep",
      "with": {"seconds": {"$ref": "inputs.wait_after_launch"}},
      "on_success": "capture_login"
    },
    {
      "id": "capture_login",
      "action": "core.capture",
      "on_success": "save_login"
    },
    {
      "id": "save_login",
      "action": "core.save_frame",
      "with": {"name": "02-login-before.png"},
      "on_success": "tap_enter"
    },
    {
      "id": "tap_enter",
      "action": "input.tap",
      "with": {
        "x": {"$ref": "inputs.enter_x"},
        "y": {"$ref": "inputs.enter_y"},
        "hold_ms": {"$ref": "inputs.hold_ms"}
      },
      "on_success": "wait_after_enter"
    },
    {
      "id": "wait_after_enter",
      "action": "core.sleep",
      "with": {"seconds": {"$ref": "inputs.wait_after_enter"}},
      "on_success": "capture_home"
    },
    {
      "id": "capture_home",
      "action": "core.capture",
      "on_success": "save_home"
    },
    {
      "id": "save_home",
      "action": "core.save_frame",
      "with": {"name": "03-home-before-explore.png"},
      "on_success": "tap_explore"
    },
    {
      "id": "tap_explore",
      "action": "input.tap",
      "with": {
        "x": {"$ref": "inputs.explore_x"},
        "y": {"$ref": "inputs.explore_y"},
        "hold_ms": {"$ref": "inputs.hold_ms"}
      },
      "on_success": "wait_after_explore"
    },
    {
      "id": "wait_after_explore",
      "action": "core.sleep",
      "with": {"seconds": {"$ref": "inputs.wait_after_explore"}},
      "on_success": "capture_map"
    },
    {
      "id": "capture_map",
      "action": "core.capture",
      "on_success": "save_map"
    },
    {
      "id": "save_map",
      "action": "core.save_frame",
      "with": {"name": "04-explore-before-target.png"},
      "on_success": "tap_target"
    },
    {
      "id": "tap_target",
      "action": "input.tap",
      "with": {
        "x": {"$ref": "inputs.target_x"},
        "y": {"$ref": "inputs.target_y"},
        "hold_ms": {"$ref": "inputs.hold_ms"}
      },
      "on_success": "wait_after_target"
    },
    {
      "id": "wait_after_target",
      "action": "core.sleep",
      "with": {"seconds": {"$ref": "inputs.wait_after_target"}},
      "on_success": "capture_result"
    },
    {
      "id": "capture_result",
      "action": "core.capture",
      "on_success": "save_result"
    },
    {
      "id": "save_result",
      "action": "core.save_frame",
      "with": {"name": "05-after-target.png"},
      "on_success": "log_result"
    },
    {
      "id": "log_result",
      "action": "core.log",
      "with": {
        "message": "阴阳师探索点击流程完成，已保存 5 张阶段截图"
      },
      "on_success": "$success"
    }
  ]
}
