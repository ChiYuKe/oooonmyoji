{
  "schema_version": 1,
  "id": "onmyoji_start_icon_click",
  "version": "1.0.0",
  "reference_resolution": [
    1920,
    1080
  ],
  "entry": "caoture",
  "limits": {
    "timeout_seconds": 60,
    "max_steps": 20
  },
  "inputs_schema": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "minLength": 1,
        "default": "assets/templates/start/omg_icon.png"
      },
      "threshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.85
      },
      "roi": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "minItems": 4,
        "maxItems": 4,
        "default": [
          0,
          0,
          1920,
          1080
        ]
      },
      "hold_ms": {
        "type": "integer",
        "minimum": 0,
        "default": 50
      },
      "random_offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "random_interval": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "number",
            "minimum": 0
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "default": [
          0,
          0
        ]
      },
      "wait_seconds": {
        "type": "number",
        "minimum": 0,
        "default": 1
      },
      "screenshot_after": {
        "type": "string",
        "minLength": 1,
        "default": "onmyoji-start-icon-after.png"
      }
    },
    "additionalProperties": false
  },
  "steps": [
    {
      "id": "caoture",
      "action": "core.capture",
      "on_success": "find_icon"
    },
    {
      "id": "find_icon",
      "action": "vision.match_template",
      "with": {
        "roi": {
          "$ref": "inputs.roi"
        }
      },
      "on_success": "click_if_found"
    },
    {
      "id": "click_if_found",
      "action": "input.tap_match",
      "when": {
        "exists": {
          "$ref": "steps.find_icon.output.0"
        }
      },
      "with": {
        "match": {
          "$ref": "steps.find_icon.output.0"
        },
        "revalidate": true,
        "hold_ms": {
          "$ref": "inputs.hold_ms"
        },
        "random_offset": {
          "$ref": "inputs.random_offset"
        },
        "random_interval": {
          "$ref": "inputs.random_interval"
        }
      },
      "on_success": "wait_after_click"
    },
    {
      "id": "wait_after_click",
      "action": "core.sleep",
      "with": {
        "seconds": 1
      },
      "on_success": "step_1"
    },
    {
      "id": "step_1",
      "action": "workflow.run",
      "with": {},
      "on_success": "$success"
    }
  ],
  "_layout": {
    "find_icon": {
      "x": 420,
      "y": 36
    },
    "click_if_found": {
      "x": 780,
      "y": 36
    },
    "caoture": {
      "x": 60,
      "y": 36
    },
    "wait_after_click": {
      "x": 1176,
      "y": 36
    },
    "$success": {
      "x": 1920,
      "y": 0
    },
    "step_1": {
      "x": 1536,
      "y": 36
    }
  }
}
