{
  "schema_version": 3,
  "id": "realm_enter",
  "version": "2.0.0",
  "description": "统一识别已知页面并有限恢复到结界突破列表；模板优先，OCR 仅降级。",
  "resolution": [1920, 1080],
  "root": "root",
  "limits": { "timeout_seconds": 45, "max_steps": 10 },
  "blackboard": {
    "entry_point": { "type": "rect", "public": true, "default": [450, 1000, 0, 0] },
    "map_realm_template": { "type": "asset", "public": true, "default": "assets/templates/realm/map-entry.png" },
    "courtyard_template": { "type": "asset", "public": true, "default": "assets/templates/souls/courtyard-explore/mumu-0.png" },
    "page_texts": { "type": "array", "public": true, "default": ["结界突破"], "items": { "type": "string", "min_length": 1 } },
    "page_roi": { "type": "rect", "public": true, "default": [0, 0, 1920, 260] },
    "realm_template": { "type": "asset", "public": true, "default": "assets/templates/realm/realm-title.png" },
    "settlement_template": { "type": "asset", "public": true, "default": "assets/templates/souls/souls-victory-continue.png" },
    "bounty_reject_template": { "type": "asset", "public": true, "default": "assets/templates/shared/bounty-reject.png" },
    "treasure_template": { "type": "asset", "public": true, "default": "assets/templates/shared/treasure-title.png" },
    "treasure_close_point": { "type": "rect", "public": true, "default": [960, 1025, 0, 0] },
    "settlement_roi": { "type": "rect", "public": true, "default": [650, 900, 650, 180] },
    "recovery_timeout": { "type": "number", "public": true, "default": 30, "min": 1, "max": 60 },
    "max_return_attempts": { "type": "integer", "public": true, "default": 3, "min": 1, "max": 3 },
    "max_settlement_clicks": { "type": "integer", "public": true, "default": 6, "min": 1, "max": 6 },
    "leave_current_screen": { "type": "boolean", "public": true, "default": false }
  },
  "nodes": [
    { "id": "root", "type": "root", "name": "进入结界突破", "children": ["recover"] },
    {
      "id": "recover", "type": "task", "name": "识别、恢复并确认结界突破页", "action": "input.recover_state",
      "params": {
        "states": [
          { "name": "realm_raid", "template": { "ref": "blackboard.realm_template" }, "roi": [700, 70, 520, 160], "threshold": 0.88, "texts": { "ref": "blackboard.page_texts" }, "text_roi": { "ref": "blackboard.page_roi" }, "min_confidence": 0.45 },
          { "name": "settlement", "template": { "ref": "blackboard.settlement_template" }, "roi": { "ref": "blackboard.settlement_roi" }, "threshold": 0.86 },
          { "name": "bounty_popup", "template": { "ref": "blackboard.bounty_reject_template" }, "roi": [1150, 680, 260, 190], "threshold": 0.9 },
          { "name": "treasure_popup", "template": { "ref": "blackboard.treasure_template" }, "roi": [650, 150, 620, 230], "threshold": 0.9 },
          { "name": "souls_challenge", "template": "assets/templates/souls/souls-challenge.png", "roi": [1550, 750, 370, 330], "threshold": 0.88 },
          { "name": "souls_type", "template": "assets/templates/souls/souls-type-title.png", "roi": [100, 0, 320, 130], "threshold": 0.88 },
          { "name": "explore_map", "template": "assets/templates/souls/map-souls.png", "roi": [150, 850, 250, 230], "threshold": 0.88 },
          { "name": "courtyard", "template": { "ref": "blackboard.courtyard_template" }, "roi": [0, 0, 1920, 500], "threshold": 0.4 },
          { "name": "party_room", "template": "assets/templates/souls/party/lobby-title.png", "roi": [80, 0, 350, 120], "threshold": 0.88 },
          { "name": "invite_popup", "template": "assets/templates/souls/party/accept-invite-button.png", "roi": [100, 280, 220, 220], "threshold": 0.9 }
        ],
        "target_states": ["realm_raid"],
        "overlay_states": ["settlement", "bounty_popup", "treasure_popup"],
        "transitions": [
          { "from": "settlement", "type": "tap_match", "expected_states": ["settlement", "bounty_popup", "treasure_popup", "realm_raid", "souls_challenge", "souls_type", "explore_map", "courtyard", "party_room"] },
          { "from": "bounty_popup", "type": "tap_match", "expected_states": ["realm_raid", "souls_challenge", "souls_type", "explore_map", "courtyard", "party_room"] },
          { "from": "treasure_popup", "type": "tap", "x": { "ref": "blackboard.treasure_close_point.0" }, "y": { "ref": "blackboard.treasure_close_point.1" }, "expected_states": ["settlement", "realm_raid", "souls_challenge", "souls_type", "explore_map", "courtyard", "party_room"] },
          { "from": "souls_challenge", "type": "key", "keycode": "KEYCODE_BACK", "return_action": true, "expected_states": ["bounty_popup", "souls_type", "explore_map", "courtyard"] },
          { "from": "souls_type", "type": "key", "keycode": "KEYCODE_BACK", "return_action": true, "expected_states": ["bounty_popup", "explore_map", "courtyard"] },
          { "from": "party_room", "type": "key", "keycode": "KEYCODE_BACK", "return_action": true, "expected_states": ["bounty_popup", "souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "invite_popup", "type": "key", "keycode": "KEYCODE_BACK", "return_action": true, "expected_states": ["bounty_popup", "party_room", "souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "courtyard", "type": "tap_match", "expected_states": ["explore_map"] },
          { "from": "explore_map", "type": "tap_template", "template": { "ref": "blackboard.map_realm_template" }, "roi": [220, 500, 300, 390], "threshold": 0.88, "expected_states": ["realm_raid"] }
        ],
        "allow_ocr": true,
        "timeout_seconds": { "ref": "blackboard.recovery_timeout" },
        "confirm_timeout_seconds": 12,
        "max_return_attempts": { "ref": "blackboard.max_return_attempts" },
        "max_overlay_clicks": { "ref": "blackboard.max_settlement_clicks" },
        "max_transitions": 10,
        "failure_frame_name": "recovery/recover-to-realm-failure.png",
        "post_action_delay": 0.35,
        "poll_interval_seconds": 0.1,
        "random_offset": 6,
        "random_interval": [0.15, 0.35]
      }
    }
  ]
}
