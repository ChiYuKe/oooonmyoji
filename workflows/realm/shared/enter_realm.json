{
  "schema_version": 4,
  "id": "realm_enter",
  "version": "2.0.0",
  "description": "统一识别已知页面并有限恢复到结界突破列表；模板优先，OCR 仅降级。",
  "resolution": [
    1920,
    1080
  ],
  "root": "root",
  "limits": {
    "timeout_seconds": 45,
    "max_steps": 10
  },
  "inputs": {
    "入口点击位置": {
      "type": "rect",
      "default": [
        450,
        1000,
        0,
        0
      ]
    },
    "结界突破地图入口模板": {
      "type": "asset",
      "default": "assets/templates/realm/map-entry.png"
    },
    "庭院入口模板": {
      "type": "asset",
      "default": "assets/templates/souls/courtyard-explore/mumu-0.png"
    },
    "页面识别文字列表": {
      "type": "array",
      "default": [
        "结界突破"
      ],
      "items": {
        "type": "string",
        "min_length": 1
      }
    },
    "页面识别区域": {
      "type": "rect",
      "default": [
        0,
        0,
        1920,
        260
      ]
    },
    "结界突破页面模板": {
      "type": "asset",
      "default": "assets/templates/realm/realm-title.png"
    },
    "结算页面模板": {
      "type": "asset",
      "default": "assets/templates/souls/souls-victory-continue.png"
    },
    "悬赏拒绝按钮模板": {
      "type": "asset",
      "default": "assets/templates/shared/bounty-reject.png"
    },
    "宝箱页面模板": {
      "type": "asset",
      "default": "assets/templates/shared/treasure-title.png"
    },
    "退出队伍确认模板": {
      "type": "asset",
      "default": "assets/templates/souls/party/exit-party-prompt.png"
    },
    "退出队伍按钮模板": {
      "type": "asset",
      "default": "assets/templates/souls/party/continue-confirm-button.png"
    },
    "组队界面模板": {
      "type": "asset",
      "default": "assets/templates/souls/party/create-team-button.png"
    },
    "宝箱关闭位置": {
      "type": "rect",
      "default": [
        960,
        1025,
        0,
        0
      ]
    },
    "结算识别区域": {
      "type": "rect",
      "default": [
        650,
        900,
        650,
        180
      ]
    },
    "页面恢复超时时间": {
      "type": "number",
      "default": 30,
      "min": 1,
      "max": 60
    },
    "最大返回尝试次数": {
      "type": "integer",
      "default": 3,
      "min": 1,
      "max": 3
    },
    "最大结算点击次数": {
      "type": "integer",
      "default": 6,
      "min": 1,
      "max": 6
    },
    "离开当前页面": {
      "type": "boolean",
      "default": false
    }
  },
  "variables": {},
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "name": "进入结界突破",
      "children": [
        "recover"
      ]
    },
    {
      "id": "recover",
      "type": "task",
      "name": "识别、恢复并确认结界突破页",
      "action": "input.recover_state",
      "params": {
        "states": [
          {
            "name": "realm_raid",
            "template": {
              "ref": "inputs.结界突破页面模板"
            },
            "roi": [
              700,
              70,
              520,
              160
            ],
            "threshold": 0.88,
            "texts": {
              "ref": "inputs.页面识别文字列表"
            },
            "text_roi": {
              "ref": "inputs.页面识别区域"
            },
            "min_confidence": 0.45
          },
          {
            "name": "settlement",
            "template": {
              "ref": "inputs.结算页面模板"
            },
            "roi": {
              "ref": "inputs.结算识别区域"
            },
            "threshold": 0.86
          },
          {
            "name": "bounty_popup",
            "template": {
              "ref": "inputs.悬赏拒绝按钮模板"
            },
            "roi": [
              1150,
              680,
              260,
              190
            ],
            "threshold": 0.9
          },
          {
            "name": "treasure_popup",
            "template": {
              "ref": "inputs.宝箱页面模板"
            },
            "roi": [
              650,
              150,
              620,
              230
            ],
            "threshold": 0.9
          },
          {
            "name": "souls_challenge",
            "template": "assets/templates/souls/souls-challenge.png",
            "roi": [
              1550,
              750,
              370,
              330
            ],
            "threshold": 0.88
          },
          {
            "name": "souls_type",
            "template": "assets/templates/souls/souls-type-title.png",
            "roi": [
              100,
              0,
              320,
              130
            ],
            "threshold": 0.88
          },
          {
            "name": "explore_map",
            "template": "assets/templates/souls/map-souls.png",
            "roi": [
              150,
              850,
              250,
              230
            ],
            "threshold": 0.88
          },
          {
            "name": "courtyard",
            "template": {
              "ref": "inputs.庭院入口模板"
            },
            "roi": [
              0,
              0,
              1920,
              500
            ],
            "threshold": 0.4,
            "required_texts": [
              "探索"
            ],
            "required_text_roi": [
              700,
              80,
              500,
              300
            ],
            "required_text_min_confidence": 0.25
          },
          {
            "name": "party_room",
            "template": "assets/templates/souls/party/lobby-title.png",
            "roi": [
              80,
              0,
              350,
              120
            ],
            "threshold": 0.88
          },
          {
            "name": "party_exit_confirm",
            "template": {
              "ref": "inputs.退出队伍确认模板"
            },
            "roi": [
              690,
              405,
              540,
              115
            ],
            "threshold": 0.9
          },
          {
            "name": "party_browser",
            "template": {
              "ref": "inputs.组队界面模板"
            },
            "roi": [
              1400,
              840,
              400,
              180
            ],
            "threshold": 0.88
          },
          {
            "name": "invite_popup",
            "template": "assets/templates/souls/party/accept-invite-button.png",
            "roi": [
              100,
              280,
              220,
              220
            ],
            "threshold": 0.9
          }
        ],
        "target_states": [
          "realm_raid"
        ],
        "overlay_states": [
          "settlement",
          "bounty_popup",
          "treasure_popup"
        ],
        "transitions": [
          {
            "from": "settlement",
            "type": "tap_match",
            "expected_states": [
              "settlement",
              "bounty_popup",
              "treasure_popup",
              "realm_raid",
              "souls_challenge",
              "souls_type",
              "explore_map",
              "courtyard",
              "party_room"
            ]
          },
          {
            "from": "bounty_popup",
            "type": "tap_match",
            "expected_states": [
              "realm_raid",
              "souls_challenge",
              "souls_type",
              "explore_map",
              "courtyard",
              "party_room"
            ]
          },
          {
            "from": "treasure_popup",
            "type": "tap",
            "x": {
              "ref": "inputs.宝箱关闭位置.0"
            },
            "y": {
              "ref": "inputs.宝箱关闭位置.1"
            },
            "expected_states": [
              "settlement",
              "realm_raid",
              "souls_challenge",
              "souls_type",
              "explore_map",
              "courtyard",
              "party_room"
            ]
          },
          {
            "from": "souls_challenge",
            "type": "key",
            "keycode": "KEYCODE_BACK",
            "return_action": true,
            "expected_states": [
              "bounty_popup",
              "souls_type",
              "explore_map",
              "courtyard"
            ]
          },
          {
            "from": "souls_type",
            "type": "key",
            "keycode": "KEYCODE_BACK",
            "return_action": true,
            "expected_states": [
              "bounty_popup",
              "explore_map",
              "courtyard"
            ]
          },
          {
            "from": "party_room",
            "type": "key",
            "keycode": "KEYCODE_BACK",
            "return_action": true,
            "expected_states": [
              "party_exit_confirm",
              "party_browser",
              "bounty_popup",
              "souls_challenge",
              "souls_type",
              "explore_map",
              "courtyard"
            ]
          },
          {
            "from": "party_exit_confirm",
            "type": "tap_template",
            "template": {
              "ref": "inputs.退出队伍按钮模板"
            },
            "roi": [
              950,
              520,
              400,
              220
            ],
            "threshold": 0.9,
            "return_action": true,
            "expected_states": [
              "party_browser",
              "souls_challenge",
              "souls_type",
              "explore_map",
              "courtyard"
            ]
          },
          {
            "from": "party_browser",
            "type": "key",
            "keycode": "KEYCODE_BACK",
            "return_action": true,
            "expected_states": [
              "souls_challenge",
              "souls_type",
              "explore_map",
              "courtyard"
            ]
          },
          {
            "from": "invite_popup",
            "type": "key",
            "keycode": "KEYCODE_BACK",
            "return_action": true,
            "expected_states": [
              "bounty_popup",
              "party_room",
              "souls_challenge",
              "souls_type",
              "explore_map",
              "courtyard"
            ]
          },
          {
            "from": "courtyard",
            "type": "tap_match",
            "expected_states": [
              "explore_map"
            ]
          },
          {
            "from": "explore_map",
            "type": "tap_template",
            "template": {
              "ref": "inputs.结界突破地图入口模板"
            },
            "roi": [
              220,
              500,
              300,
              390
            ],
            "threshold": 0.88,
            "expected_states": [
              "realm_raid"
            ]
          }
        ],
        "allow_ocr": true,
        "timeout_seconds": {
          "ref": "inputs.页面恢复超时时间"
        },
        "confirm_timeout_seconds": 12,
        "max_return_attempts": {
          "ref": "inputs.最大返回尝试次数"
        },
        "max_overlay_clicks": {
          "ref": "inputs.最大结算点击次数"
        },
        "max_transitions": 10,
        "failure_frame_name": "recovery/recover-to-realm-failure.png",
        "post_action_delay": 0.35,
        "poll_interval_seconds": 0.1,
        "random_offset": 6,
        "random_interval": [
          0.15,
          0.35
        ]
      }
    }
  ],
  "_layout": {
    "recover": {
      "x": 0,
      "y": 208
    },
    "root": {
      "x": 0,
      "y": 0
    }
  },
  "_inputParams": {
    "recover": [
      "timeout_seconds",
      "max_return_attempts",
      "max_overlay_clicks"
    ]
  },
  "_variableCards": {
    "card_1": {
      "name": "页面恢复超时时间",
      "scope": "inputs",
      "x": -304,
      "y": 176
    },
    "card_2": {
      "name": "最大返回尝试次数",
      "scope": "inputs",
      "x": -360,
      "y": 272
    },
    "card_3": {
      "name": "最大结算点击次数",
      "scope": "inputs",
      "x": -208,
      "y": 408
    }
  }
}
