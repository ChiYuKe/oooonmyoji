{
  "schema_version": 4,
  "id": "realm_schedule_from_souls",
  "version": "2.0.0",
  "description": "奖励页已复核结界突破券达到阈值后，执行结界突破并恢复御魂。",
  "resolution": [
    1920,
    1080
  ],
  "root": "root",
  "limits": {
    "timeout_seconds": 7200,
    "max_steps": 3200
  },
  "inputs": {
    "通关状态识别区域": {
      "type": "rect",
      "default": [
        1450,
        0,
        470,
        180
      ]
    },
    "入口点击位置": {
      "type": "rect",
      "default": [
        450,
        1000,
        0,
        0
      ]
    },
    "结界突破地图入口模板": {
      "type": "asset",
      "default": "assets/templates/realm/map-entry.png"
    },
    "再次挑战点击位置": {
      "type": "rect",
      "default": [
        1300,
        760,
        0,
        0
      ]
    },
    "再次挑战确认文字列表": {
      "type": "array",
      "default": [
        "是否再次挑战",
        "再次挑战"
      ],
      "items": {
        "type": "string",
        "min_length": 1
      }
    },
    "再次挑战确认区域": {
      "type": "rect",
      "default": [
        600,
        350,
        720,
        380
      ]
    },
    "再次挑战确认位置": {
      "type": "rect",
      "default": [
        1135,
        650,
        0,
        0
      ]
    },
    "再次挑战复选框位置": {
      "type": "rect",
      "default": [
        810,
        540,
        0,
        0
      ]
    },
    "页面识别文字列表": {
      "type": "array",
      "default": [
        "结界突破"
      ],
      "items": {
        "type": "string",
        "min_length": 1
      }
    },
    "页面识别区域": {
      "type": "rect",
      "default": [
        0,
        0,
        1920,
        260
      ]
    },
    "战斗页面识别文字": {
      "type": "array",
      "default": [
        "战斗",
        "退出",
        "点击屏幕继续"
      ],
      "items": {
        "type": "string",
        "min_length": 1
      }
    },
    "胜利页面识别文字": {
      "type": "array",
      "default": [
        "胜利",
        "结算",
        "奖励",
        "点击屏幕继续"
      ],
      "items": {
        "type": "string",
        "min_length": 1
      }
    },
    "战斗识别区域": {
      "type": "rect",
      "default": [
        0,
        0,
        1920,
        1080
      ]
    },
    "目标点击位置列表": {
      "type": "array",
      "default": [
        [
          500,
          275,
          0,
          0
        ],
        [
          1000,
          275,
          0,
          0
        ],
        [
          1500,
          275,
          0,
          0
        ],
        [
          500,
          475,
          0,
          0
        ],
        [
          1000,
          475,
          0,
          0
        ],
        [
          1500,
          475,
          0,
          0
        ],
        [
          500,
          675,
          0,
          0
        ],
        [
          1000,
          675,
          0,
          0
        ],
        [
          1500,
          675,
          0,
          0
        ]
      ],
      "items": {
        "type": "rect"
      }
    },
    "攻击点击位置": {
      "type": "rect",
      "default": [
        1570,
        580,
        0,
        0
      ]
    },
    "目标识别区域列表": {
      "type": "array",
      "default": [
        [
          220,
          220,
          500,
          190
        ],
        [
          720,
          220,
          500,
          190
        ],
        [
          1220,
          220,
          500,
          190
        ],
        [
          220,
          420,
          500,
          190
        ],
        [
          720,
          420,
          500,
          190
        ],
        [
          1220,
          420,
          500,
          190
        ],
        [
          220,
          620,
          500,
          190
        ],
        [
          720,
          620,
          500,
          190
        ],
        [
          1220,
          620,
          500,
          190
        ]
      ],
      "items": {
        "type": "rect"
      }
    },
    "完成状态文字列表": {
      "type": "array",
      "default": [
        "已挑战",
        "已击败",
        "胜利",
        "占领"
      ],
      "items": {
        "type": "string",
        "min_length": 1
      }
    },
    "完成状态模板列表": {
      "type": "array",
      "default": [],
      "items": {
        "type": "asset",
        "min_length": 1
      }
    },
    "御魂庭院入口模板": {
      "type": "asset",
      "default": "assets/templates/souls/courtyard-explore/mumu-1.png"
    },
    "离开当前页面": {
      "type": "boolean",
      "default": true
    },
    "进入结界突破": {
      "type": "boolean",
      "default": false
    },
    "结算页面模板": {
      "type": "asset",
      "default": "assets/templates/souls/souls-victory-continue.png"
    },
    "结算识别区域": {
      "type": "rect",
      "default": [
        650,
        900,
        650,
        180
      ]
    }
  },
  "variables": {},
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "name": "御魂与结界突破调度",
      "children": [
        "route"
      ]
    },
    {
      "id": "route",
      "type": "switch",
      "name": "按奖励页复核结果调度",
      "expression": {
        "ref": "inputs.进入结界突破"
      },
      "cases": [
        {
          "value": true,
          "child": "run_realm"
        },
        {
          "value": false,
          "child": "continue_souls"
        }
      ],
      "children": [
        "run_realm",
        "continue_souls"
      ]
    },
    {
      "id": "run_realm",
      "type": "task",
      "name": "停止御魂并执行结界突破",
      "action": "workflow.run",
      "params": {
        "workflow": "realm/shared/realm_raid_loop.json",
        "inputs": {
          "入口点击位置": {
            "ref": "inputs.入口点击位置"
          },
          "结界突破地图入口模板": {
            "ref": "inputs.结界突破地图入口模板"
          },
          "通关状态识别区域": {
            "ref": "inputs.通关状态识别区域"
          },
          "最少通关次数": 1,
          "页面识别文字列表": {
            "ref": "inputs.页面识别文字列表"
          },
          "页面识别区域": {
            "ref": "inputs.页面识别区域"
          },
          "战斗页面识别文字": {
            "ref": "inputs.战斗页面识别文字"
          },
          "胜利页面识别文字": {
            "ref": "inputs.胜利页面识别文字"
          },
          "战斗识别区域": {
            "ref": "inputs.战斗识别区域"
          },
          "目标点击位置列表": {
            "ref": "inputs.目标点击位置列表"
          },
          "目标识别区域列表": {
            "ref": "inputs.目标识别区域列表"
          },
          "攻击点击位置": {
            "ref": "inputs.攻击点击位置"
          },
          "完成状态文字列表": {
            "ref": "inputs.完成状态文字列表"
          },
          "完成状态模板列表": {
            "ref": "inputs.完成状态模板列表"
          },
          "离开当前页面": {
            "ref": "inputs.离开当前页面"
          },
          "再次挑战点击位置": {
            "ref": "inputs.再次挑战点击位置"
          },
          "再次挑战确认文字列表": {
            "ref": "inputs.再次挑战确认文字列表"
          },
          "再次挑战确认区域": {
            "ref": "inputs.再次挑战确认区域"
          },
          "再次挑战确认位置": {
            "ref": "inputs.再次挑战确认位置"
          },
          "再次挑战复选框位置": {
            "ref": "inputs.再次挑战复选框位置"
          },
          "恢复御魂任务": true,
          "御魂庭院入口模板": {
            "ref": "inputs.御魂庭院入口模板"
          },
          "结算页面模板": {
            "ref": "inputs.结算页面模板"
          },
          "结算识别区域": {
            "ref": "inputs.结算识别区域"
          }
        }
      }
    },
    {
      "id": "continue_souls",
      "type": "task",
      "name": "券数尚未复核到阈值",
      "action": "core.log",
      "params": {
        "message": "奖励统计尚未确认结界突破券达到阈值，继续御魂"
      }
    }
  ]
}
