{
  "schema_version": 3,
  "id": "recover_to_souls",
  "version": "1.3.0",
  "description": "统一识别当前页面，有限清理结算或返回页面，并逐步确认恢复到御魂挑战页。",
  "resolution": [1920, 1080],
  "root": "root",
  "limits": { "timeout_seconds": 30, "max_steps": 10 },
  "blackboard": {
    "courtyard_template": { "type": "asset", "public": true, "required": true },
    "challenge_template": { "type": "asset", "public": true, "default": "assets/templates/souls/souls-challenge.png" },
    "souls_type_template": { "type": "asset", "public": true, "default": "assets/templates/souls/souls-type-title.png" },
    "souls_type_entry_point": { "type": "rect", "public": true, "default": [300, 400, 0, 0] },
    "map_souls_template": { "type": "asset", "public": true, "default": "assets/templates/souls/map-souls.png" },
    "settlement_template": { "type": "asset", "public": true, "default": "assets/templates/souls/souls-victory-continue.png" },
    "realm_template": { "type": "asset", "public": true, "default": "assets/templates/realm/realm-title.png" },
    "party_room_template": { "type": "asset", "public": true, "default": "assets/templates/souls/party/lobby-title.png" },
    "party_browser_template": { "type": "asset", "public": true, "default": "assets/templates/souls/party/create-team-button.png" },
    "invite_popup_template": { "type": "asset", "public": true, "default": "assets/templates/souls/party/accept-invite-button.png" },
    "bounty_reject_template": { "type": "asset", "public": true, "default": "assets/templates/shared/bounty-reject.png" },
    "treasure_template": { "type": "asset", "public": true, "default": "assets/templates/shared/treasure-title.png" },
    "treasure_close_point": { "type": "rect", "public": true, "default": [960, 1025, 0, 0] },
    "experience_template": { "type": "asset", "public": true, "default": "assets/templates/shared/experience-complete.png" },
    "buff_auto_disabled_template": { "type": "asset", "public": true, "default": "assets/templates/shared/buff-auto-disabled.png" },
    "cancel_button_template": { "type": "asset", "public": true, "default": "assets/templates/shared/buff-auto-disabled-cancel.png" },
    "continue_prompt_template": { "type": "asset", "public": true, "default": "assets/templates/souls/party/continue-invite-prompt.png" },
    "continue_cancel_template": { "type": "asset", "public": true, "default": "assets/templates/souls/party/continue-cancel-button.png" },
    "party_exit_confirm_template": { "type": "asset", "public": true, "default": "assets/templates/souls/party/exit-party-prompt.png" },
    "party_exit_button_template": { "type": "asset", "public": true, "default": "assets/templates/souls/party/continue-confirm-button.png" },
    "realm_close_point": { "type": "rect", "public": true, "default": [1815, 210, 0, 0] },
    "target_states": { "type": "array", "public": true, "default": ["souls_challenge"], "items": { "type": "string", "min_length": 1 } },
    "recovery_timeout": { "type": "number", "public": true, "default": 15, "min": 1, "max": 60 },
    "confirm_timeout": { "type": "number", "public": true, "default": 8, "min": 0.1, "max": 30 },
    "max_return_attempts": { "type": "integer", "public": true, "default": 3, "min": 1, "max": 3 },
    "max_settlement_clicks": { "type": "integer", "public": true, "default": 6, "min": 1, "max": 6 }
  },
  "nodes": [
    { "id": "root", "type": "root", "name": "统一恢复到御魂", "children": ["recover"] },
    {
      "id": "recover",
      "type": "task",
      "name": "识别、恢复并确认御魂挑战页",
      "action": "input.recover_state",
      "params": {
        "states": [
          { "name": "buff_auto_disabled", "template": { "ref": "blackboard.buff_auto_disabled_template" }, "roi": [620, 340, 680, 260], "threshold": 0.9 },
          { "name": "souls_challenge", "template": { "ref": "blackboard.challenge_template" }, "roi": [1550, 750, 370, 330], "threshold": 0.88 },
          { "name": "souls_type", "template": { "ref": "blackboard.souls_type_template" }, "roi": [100, 0, 320, 130], "threshold": 0.88 },
          { "name": "explore_map", "template": { "ref": "blackboard.map_souls_template" }, "roi": [150, 850, 250, 230], "threshold": 0.88 },
          { "name": "bounty_popup", "template": { "ref": "blackboard.bounty_reject_template" }, "roi": [1150, 680, 260, 190], "threshold": 0.9 },
          { "name": "treasure_popup", "template": { "ref": "blackboard.treasure_template" }, "roi": [650, 150, 620, 230], "threshold": 0.9 },
          { "name": "experience", "template": { "ref": "blackboard.experience_template" }, "roi": [300, 450, 1350, 450], "threshold": 0.88 },
          { "name": "settlement", "template": { "ref": "blackboard.settlement_template" }, "roi": [650, 900, 650, 180], "threshold": 0.86 },
          { "name": "realm_raid", "template": { "ref": "blackboard.realm_template" }, "roi": [700, 70, 520, 160], "threshold": 0.88, "texts": ["结界突破"], "text_roi": [700, 60, 520, 180], "min_confidence": 0.45 },
          { "name": "continue_prompt", "template": { "ref": "blackboard.continue_prompt_template" }, "roi": [690, 405, 540, 115], "threshold": 0.9 },
          { "name": "party_exit_confirm", "template": { "ref": "blackboard.party_exit_confirm_template" }, "roi": [690, 405, 540, 115], "threshold": 0.9 },
          { "name": "party_room", "template": { "ref": "blackboard.party_room_template" }, "roi": [80, 0, 350, 120], "threshold": 0.88 },
          { "name": "party_browser", "template": { "ref": "blackboard.party_browser_template" }, "roi": [1400, 840, 400, 180], "threshold": 0.88 },
          { "name": "invite_popup", "template": { "ref": "blackboard.invite_popup_template" }, "roi": [100, 280, 220, 220], "threshold": 0.9 },
          { "name": "courtyard", "template": { "ref": "blackboard.courtyard_template" }, "roi": [0, 0, 1920, 500], "threshold": 0.4 }
        ],
        "target_states": { "ref": "blackboard.target_states" },
        "overlay_states": ["settlement", "bounty_popup", "treasure_popup", "experience"],
        "transitions": [
          { "from": "buff_auto_disabled", "type": "tap_template", "template": { "ref": "blackboard.cancel_button_template" }, "roi": [620, 520, 350, 220], "threshold": 0.9, "expected_states": ["settlement", "experience", "bounty_popup", "treasure_popup", "realm_raid", "party_room", "souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "settlement", "type": "tap_match", "expected_states": ["buff_auto_disabled", "settlement", "experience", "bounty_popup", "treasure_popup", "continue_prompt", "realm_raid", "party_room", "souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "experience", "type": "tap", "x": 960, "y": 1025, "expected_states": ["buff_auto_disabled", "settlement", "bounty_popup", "treasure_popup", "continue_prompt", "realm_raid", "party_room", "souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "bounty_popup", "type": "tap_match", "expected_states": ["buff_auto_disabled", "continue_prompt", "realm_raid", "party_room", "souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "treasure_popup", "type": "tap", "x": { "ref": "blackboard.treasure_close_point.0" }, "y": { "ref": "blackboard.treasure_close_point.1" }, "expected_states": ["buff_auto_disabled", "settlement", "continue_prompt", "realm_raid", "party_room", "souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "realm_raid", "type": "tap", "x": { "ref": "blackboard.realm_close_point.0" }, "y": { "ref": "blackboard.realm_close_point.1" }, "return_action": true, "expected_states": ["bounty_popup", "souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "party_room", "type": "key", "keycode": "KEYCODE_BACK", "return_action": true, "expected_states": ["party_exit_confirm", "party_browser", "souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "continue_prompt", "type": "tap_template", "template": { "ref": "blackboard.continue_cancel_template" }, "roi": [600, 520, 400, 220], "threshold": 0.9, "return_action": true, "expected_states": ["party_room", "party_browser", "souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "party_exit_confirm", "type": "tap_template", "template": { "ref": "blackboard.party_exit_button_template" }, "roi": [950, 520, 400, 220], "threshold": 0.9, "return_action": true, "expected_states": ["party_browser", "souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "party_browser", "type": "key", "keycode": "KEYCODE_BACK", "return_action": true, "expected_states": ["souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "invite_popup", "type": "key", "keycode": "KEYCODE_BACK", "return_action": true, "expected_states": ["party_room", "souls_challenge", "souls_type", "explore_map", "courtyard"] },
          { "from": "courtyard", "type": "tap_match", "expected_states": ["explore_map"] },
          { "from": "explore_map", "type": "tap_match", "expected_states": ["souls_type"] },
          { "from": "souls_type", "type": "tap", "x": { "ref": "blackboard.souls_type_entry_point.0" }, "y": { "ref": "blackboard.souls_type_entry_point.1" }, "expected_states": ["souls_challenge"] }
        ],
        "allow_ocr": true,
        "timeout_seconds": { "ref": "blackboard.recovery_timeout" },
        "initial_state_timeout_seconds": 8,
        "confirm_timeout_seconds": { "ref": "blackboard.confirm_timeout" },
        "max_return_attempts": { "ref": "blackboard.max_return_attempts" },
        "max_overlay_clicks": { "ref": "blackboard.max_settlement_clicks" },
        "max_transitions": 12,
        "failure_frame_name": "recovery/recover-to-souls-failure.png",
        "post_action_delay": 0.35,
        "poll_interval_seconds": 0.1,
        "random_offset": 6,
        "random_interval": [0.15, 0.35]
      }
    }
  ]
}
