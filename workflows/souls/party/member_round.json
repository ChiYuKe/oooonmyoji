{
  "schema_version": 3,
  "id": "souls_party_member_round",
  "version": "3.0.3",
  "resolution": [
    1920,
    1080
  ],
  "root": "root",
  "limits": {
    "timeout_seconds": 600,
    "max_steps": 100
  },
  "blackboard": {
    "phase": {
      "type": "string",
      "public": true,
      "required": true,
      "default": "finish",
      "enum": [
        "finish",
        "setup_auto_ready",
        "auto_ready"
      ]
    }
  },
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "name": "队员单轮战斗入口",
      "children": [
        "round"
      ]
    },
    {
      "id": "round",
      "type": "sequence",
      "name": "接受邀请、参战并完成结算",
      "children": [
        "ensure_in_party",
        "detect_lineup_state",
        "prepare_lineup_if_needed",
        "await_victory",
        "settle_to_round_destination",
        "choose_after_battle_action"
      ]
    },
    {
      "id": "choose_after_battle_action",
      "type": "selector",
      "name": "按阶段完成自动准备设置或结束本轮",
      "children": [
        "setup_auto_ready",
        "finish_settled",
        "auto_ready_settled"
      ]
    },
    {
      "id": "setup_auto_ready",
      "type": "sequence",
      "name": "首轮接受限时邀请并启用自动准备",
      "children": [
        "prepare_auto_ready_setup"
      ],
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "eq": [
              {
                "ref": "blackboard.phase"
              },
              "setup_auto_ready"
            ]
          }
        }
      ]
    },
    {
      "id": "prepare_auto_ready_setup",
      "type": "selector",
      "name": "设置自动准备或确认设置已生效",
      "children": [
        "auto_ready_already_active",
        "configure_auto_ready"
      ]
    },
    {
      "id": "configure_auto_ready",
      "type": "sequence",
      "name": "点击限时自动准备邀请",
      "children": [
        "wait_auto_ready_invite",
        "tap_auto_ready_invite",
        "complete_auto_ready_setup"
      ]
    },
    {
      "id": "complete_auto_ready_setup",
      "type": "selector",
      "name": "处理首次确认或直接进入队伍",
      "children": [
        "wait_lobby_without_confirmation",
        "handle_auto_ready_confirmation"
      ]
    },
    {
      "id": "handle_auto_ready_confirmation",
      "type": "sequence",
      "name": "勾选不再提示并确认自动准备",
      "children": [
        "wait_auto_ready_confirmation",
        "wait_never_prompt_checkbox",
        "tap_never_prompt_checkbox",
        "tap_auto_ready_confirm",
        "wait_lobby_after_auto_ready_confirm"
      ]
    },
    {
      "id": "wait_lobby_without_confirmation",
      "type": "task",
      "name": "不再提示已生效并直接进入队伍",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/lobby-title.png",
        "timeout_seconds": 2,
        "roi": [
          80,
          0,
          350,
          120
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "auto_ready_already_active",
      "type": "task",
      "name": "自动接受邀请设置已经生效",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/lobby-title.png",
        "timeout_seconds": 1,
        "roi": [
          80,
          0,
          350,
          120
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "finish_settled",
      "type": "task",
      "name": "单轮验证已完成结算",
      "action": "core.log",
      "params": {
        "message": "单轮验证完成，不接受下一轮邀请"
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "eq": [
              {
                "ref": "blackboard.phase"
              },
              "finish"
            ]
          }
        }
      ]
    },
    {
      "id": "auto_ready_settled",
      "type": "task",
      "name": "自动准备轮已返回协战房间",
      "action": "core.log",
      "params": {
        "message": "不再提示已启用，本轮结算后已自动接受邀请"
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "eq": [
              {
                "ref": "blackboard.phase"
              },
              "auto_ready"
            ]
          }
        }
      ]
    },
    {
      "id": "wait_auto_ready_invite",
      "type": "task",
      "name": "等待连续邀请的自动准备按钮",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/auto-ready-invite-button.png",
        "timeout_seconds": 12,
        "roi": [
          0,
          304,
          867,
          168
        ],
        "threshold": 0.85,
        "scale_search": false
      }
    },
    {
      "id": "tap_auto_ready_invite",
      "type": "task",
      "name": "接受邀请并启用战前自动准备",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_auto_ready_invite.output.0"
        },
        "revalidate": false,
        "random_offset": 3,
        "random_interval": [
          0,
          0.05
        ]
      }
    },
    {
      "id": "wait_auto_ready_confirmation",
      "type": "task",
      "name": "等待自动准备确认弹窗",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/continue-confirm-button.png",
        "timeout_seconds": 10,
        "roi": [
          900,
          520,
          450,
          260
        ],
        "threshold": 0.9,
        "scale_search": false
      }
    },
    {
      "id": "wait_never_prompt_checkbox",
      "type": "task",
      "name": "定位不再提示复选框",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/never-prompt-checkbox.png",
        "timeout_seconds": 3,
        "roi": [
          780,
          460,
          250,
          180
        ],
        "threshold": 0.9,
        "scale_search": false
      }
    },
    {
      "id": "tap_never_prompt_checkbox",
      "type": "task",
      "name": "勾选不再提示",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_never_prompt_checkbox.output.0"
        },
        "revalidate": false,
        "random_offset": 3,
        "random_interval": [
          0,
          0.05
        ]
      }
    },
    {
      "id": "tap_auto_ready_confirm",
      "type": "task",
      "name": "确认战前自动准备",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_auto_ready_confirmation.output.0"
        },
        "revalidate": false,
        "random_offset": 3,
        "random_interval": [
          0,
          0.05
        ]
      }
    },
    {
      "id": "wait_lobby_after_auto_ready_confirm",
      "type": "task",
      "name": "等待自动准备邀请进入队伍",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/lobby-title.png",
        "timeout_seconds": 30,
        "roi": [
          80,
          0,
          350,
          120
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "ensure_in_party",
      "type": "selector",
      "name": "确认已在协战房间",
      "children": [
        "already_in_party",
        "accept_party_invite"
      ]
    },
    {
      "id": "already_in_party",
      "type": "sequence",
      "name": "已经加入协战房间",
      "children": [
        "detect_party_lobby"
      ]
    },
    {
      "id": "detect_party_lobby",
      "type": "task",
      "name": "检测协战房间",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/lobby-title.png",
        "timeout_seconds": 1,
        "roi": [
          80,
          0,
          350,
          120
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "accept_party_invite",
      "type": "sequence",
      "name": "等待并接受 mumu0 邀请",
      "children": [
        "wait_accept_invite",
        "tap_accept_invite",
        "wait_lobby_after_accept"
      ]
    },
    {
      "id": "wait_accept_invite",
      "type": "task",
      "name": "等待御魂悲鸣邀请",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/accept-invite-button.png",
        "timeout_seconds": 180,
        "roi": [
          100,
          280,
          220,
          220
        ],
        "threshold": 0.9,
        "scale_search": false
      }
    },
    {
      "id": "tap_accept_invite",
      "type": "task",
      "name": "接受组队邀请",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_accept_invite.output.0"
        },
        "revalidate": true,
        "random_offset": 4,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "wait_lobby_after_accept",
      "type": "task",
      "name": "等待进入协战房间",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/lobby-title.png",
        "timeout_seconds": 30,
        "roi": [
          80,
          0,
          350,
          120
        ],
        "threshold": 0.88,
        "scale_search": false
      }
    },
    {
      "id": "detect_lineup_state",
      "type": "selector",
      "name": "识别队员阵容锁定状态",
      "children": [
        "detect_locked_lineup",
        "detect_unlocked_lineup",
        "lineup_state_unknown"
      ]
    },
    {
      "id": "detect_unlocked_lineup",
      "type": "task",
      "name": "检测阵容未锁定",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/formation-unlocked.png",
        "timeout_seconds": 2,
        "roi": [
          130,
          930,
          140,
          100
        ],
        "threshold": 0.4,
        "scale_search": false
      }
    },
    {
      "id": "detect_locked_lineup",
      "type": "task",
      "name": "检测阵容已锁定",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/formation-locked.png",
        "timeout_seconds": 2,
        "roi": [
          130,
          930,
          140,
          100
        ],
        "threshold": 0.4,
        "scale_search": false
      }
    },
    {
      "id": "lineup_state_unknown",
      "type": "task",
      "name": "阵容锁定状态暂不明确",
      "action": "core.log",
      "params": {
        "message": "未识别到阵容锁定图标，开战后继续检查准备按钮"
      }
    },
    {
      "id": "prepare_lineup_if_needed",
      "type": "selector",
      "name": "未锁定阵容时点击准备",
      "children": [
        "lineup_already_locked",
        "prepare_unlocked_lineup",
        "lineup_started_without_ready"
      ]
    },
    {
      "id": "prepare_unlocked_lineup",
      "type": "task",
      "name": "准备未锁定阵容",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/shared/prepare_lineup.json",
        "inputs": {
          "timeout_seconds": 10
        }
      }
    },
    {
      "id": "lineup_already_locked",
      "type": "task",
      "name": "阵容已锁定自动开战",
      "action": "core.log",
      "params": {
        "message": "阵容已锁定，直接等待战斗"
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "exists": {
              "ref": "nodes.detect_locked_lineup.output.0"
            }
          }
        }
      ]
    },
    {
      "id": "lineup_started_without_ready",
      "type": "task",
      "name": "未出现准备按钮",
      "action": "core.log",
      "params": {
        "message": "未出现准备按钮，按已自动开战继续等待"
      }
    },
    {
      "id": "await_victory",
      "type": "task",
      "name": "等待组队战斗结束并继续",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/shared/await_victory.json",
        "inputs": {
          "timeout_seconds": 240
        }
      }
    },
    {
      "id": "settle_to_round_destination",
      "type": "selector",
      "name": "使用统一恢复层清理组队结算",
      "children": [
        "recover_round_destination",
        "legacy_settlement_disabled"
      ]
    },
    {
      "id": "legacy_settlement_disabled",
      "type": "selector",
      "name": "已停用的两次固定点击结算分支",
      "children": [
        "settled_direct",
        "settled_after_one_tap",
        "settled_after_two_taps"
      ],
      "decorators": [
        { "type": "condition", "expression": { "eq": [true, false] } }
      ]
    },
    {
      "id": "recover_round_destination",
      "type": "task",
      "name": "统一清理奖励并确认自动准备邀请或协战房间",
      "action": "input.recover_state",
      "params": {
        "states": [
          { "name": "auto_ready_invite", "template": "assets/templates/souls/party/auto-ready-invite-button.png", "roi": [0, 304, 867, 168], "threshold": 0.85 },
          { "name": "party_room", "template": "assets/templates/souls/party/lobby-title.png", "roi": [80, 0, 350, 120], "threshold": 0.88 },
          { "name": "settlement", "template": "assets/templates/souls/souls-victory-continue.png", "roi": [650, 900, 650, 180], "threshold": 0.86 },
          { "name": "experience", "template": "assets/templates/shared/experience-complete.png", "roi": [300, 450, 1350, 450], "threshold": 0.88 },
          { "name": "bounty_popup", "template": "assets/templates/shared/bounty-reject.png", "roi": [1150, 680, 260, 190], "threshold": 0.9 },
          { "name": "treasure_popup", "template": "assets/templates/shared/treasure-title.png", "roi": [650, 150, 620, 230], "threshold": 0.9 }
        ],
        "target_states": ["auto_ready_invite", "party_room"],
        "overlay_states": ["settlement", "experience", "bounty_popup", "treasure_popup"],
        "transitions": [
          { "from": "settlement", "type": "tap_match", "expected_states": ["settlement", "experience", "bounty_popup", "treasure_popup", "auto_ready_invite", "party_room"] },
          { "from": "experience", "type": "tap", "x": 960, "y": 1025, "expected_states": ["settlement", "bounty_popup", "treasure_popup", "auto_ready_invite", "party_room"] },
          { "from": "bounty_popup", "type": "tap_match", "expected_states": ["auto_ready_invite", "party_room"] },
          { "from": "treasure_popup", "type": "tap", "x": 960, "y": 1025, "expected_states": ["settlement", "auto_ready_invite", "party_room"] }
        ],
        "allow_ocr": false,
        "timeout_seconds": 30,
        "initial_state_timeout_seconds": 8,
        "confirm_timeout_seconds": 12,
        "max_return_attempts": 3,
        "max_overlay_clicks": 6,
        "max_transitions": 10,
        "failure_frame_name": "recovery/member-party-settlement-failure.png",
        "post_action_delay": 0.35,
        "poll_interval_seconds": 0.1,
        "random_offset": 8,
        "random_interval": [0.15, 0.35]
      }
    },
    {
      "id": "settled_direct",
      "type": "selector",
      "name": "已直接返回目标界面",
      "children": [
        "wait_map_direct",
        "wait_courtyard_direct",
        "wait_lobby_direct"
      ]
    },
    {
      "id": "wait_map_direct",
      "type": "task",
      "name": "短暂等待探索地图",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/map-souls.png",
        "timeout_seconds": 3,
        "roi": [
          150,
          850,
          250,
          230
        ],
        "threshold": 0.88,
        "scale_search": false
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "ne": [
              {
                "ref": "blackboard.phase"
              },
              "auto_ready"
            ]
          }
        }
      ]
    },
    {
      "id": "wait_courtyard_direct",
      "type": "task",
      "name": "短暂等待庭院",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/courtyard-explore/mumu-1.png",
        "timeout_seconds": 2,
        "roi": [
          0,
          0,
          1920,
          500
        ],
        "threshold": 0.4,
        "scale_search": false
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "ne": [
              {
                "ref": "blackboard.phase"
              },
              "auto_ready"
            ]
          }
        }
      ]
    },
    {
      "id": "wait_lobby_direct",
      "type": "task",
      "name": "短暂等待协战房间",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/lobby-title.png",
        "timeout_seconds": 3,
        "roi": [
          80,
          0,
          350,
          120
        ],
        "threshold": 0.88,
        "scale_search": false
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "ne": [
              {
                "ref": "blackboard.phase"
              },
              "finish"
            ]
          }
        }
      ]
    },
    {
      "id": "settled_after_one_tap",
      "type": "sequence",
      "name": "关闭一层奖励",
      "children": [
        "stats_reward_layer_1",
        "dismiss_reward_once",
        "pause_after_reward_once",
        "wait_reward_overlay_gone_after_one",
        "done_after_one"
      ]
    },
    {
      "id": "stats_reward_layer_1",
      "type": "task",
      "name": "后台统计第一层奖励",
      "action": "workflow.run",
      "params": {
        "workflow": "souls/shared/reward_statistics.json",
        "inputs": {
          "category": "souls",
          "layer": 1
        }
      }
    },
    {
      "id": "dismiss_reward_once",
      "type": "task",
      "name": "关闭第一层奖励",
      "action": "input.tap",
      "params": {
        "x": 1500,
        "y": 850,
        "random_offset": 12,
        "random_interval": [
          0.2,
          0.6
        ]
      }
    },
    {
      "id": "pause_after_reward_once",
      "type": "task",
      "name": "等待奖励页切换稳定",
      "action": "core.sleep",
      "params": {
        "seconds": 0.8
      }
    },
    {
      "id": "wait_reward_overlay_gone_after_one",
      "type": "task",
      "name": "确认第一层奖励已关闭",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-victory-continue.png",
        "timeout_seconds": 3,
        "present": false,
        "roi": [
          650,
          900,
          650,
          180
        ],
        "threshold": 0.86,
        "scale_search": false
      }
    },
    {
      "id": "done_after_one",
      "type": "selector",
      "name": "确认一次点击后已返回",
      "children": [
        "wait_map_after_one",
        "wait_courtyard_after_one",
        "wait_lobby_after_one"
      ]
    },
    {
      "id": "wait_map_after_one",
      "type": "task",
      "name": "等待探索地图",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/map-souls.png",
        "timeout_seconds": 6,
        "roi": [
          150,
          850,
          250,
          230
        ],
        "threshold": 0.88,
        "scale_search": false
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "ne": [
              {
                "ref": "blackboard.phase"
              },
              "auto_ready"
            ]
          }
        }
      ]
    },
    {
      "id": "wait_courtyard_after_one",
      "type": "task",
      "name": "等待庭院",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/courtyard-explore/mumu-1.png",
        "timeout_seconds": 2,
        "roi": [
          0,
          0,
          1920,
          500
        ],
        "threshold": 0.4,
        "scale_search": false
      },
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "ne": [
              {
                "ref": "blackboard.phase"
              },
              "auto_ready"
            ]
          }
        }
      ]
    },
    {
      "id": "wait_lobby_after_one",
      "type": "task",
      "name": "等待返回协战房间",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/party/lobby-title.png",
