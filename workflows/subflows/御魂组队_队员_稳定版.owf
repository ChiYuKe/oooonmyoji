workflow souls_party_member_stable
  version: 2.1.0
  description: 御魂队员：在庭院或队伍中等待，邀请、自动接受、准备、奖励同帧识别，立即分派。每次奖励结算并回房才计一轮；不主动开战。超时或未知画面停止，避免与队长无限错位。
  resolution: [1920, 1080]
  root: root_1
  limits:
    timeout_seconds: 21600
    max_steps: 200000
  inputs:
    运行轮数:
      type: integer
      default: 20
      min: 1
      display_name: 运行轮数
      description: 完整结算轮数；等待邀请、加载与补邀不消耗轮数。
  variables: {}
  node task_1 task 确认画面：accept
    at: [3060, 1440]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/invite-accept-button.png
      roi: [0, 296, 783, 186]
      threshold: 0.8
      present: true
      timeout_seconds: 2
  node task_2 task 点击并复核：accept_invite_tap
    at: [3400, 1440]
    action: input.tap_match
    params:
      revalidate: true
      verify_gone: true
      verify_timeout_seconds: 3
      random_offset: 6
      random_interval: [0.1, 0.2]
    decorator retry
      attempts: 3
      delay_seconds: 0.3
  node sequence_1 selector "响应 accept；已切页则继续"
    at: [3230, 1200]
  node task_3 task 确认画面：auto_accept
    at: [3740, 1440]
    action: vision.wait_template
    params:
      template: assets/templates/tap_empty_party_slot_1-disappeared_states.png
      roi: [6, 301, 863, 175]
      threshold: 0.8
      present: true
      timeout_seconds: 2
