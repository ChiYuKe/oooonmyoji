      random_offset: 6
      random_interval: [0.1, 0.2]
    decorator retry
      attempts: 3
      delay_seconds: 0.3
  node sequence_3 selector "响应 ready；已切页则继续"
    at: [4590, 1200]
  node state_machine_1 state_machine 响应邀请与准备，直到本场奖励出现
    at: [3910, 960]
    states:
      - name: accept
        template: assets/templates/souls/party/invite-accept-button.png
        roi: [0, 296, 783, 186]
        threshold: 0.8
      - name: auto_accept
        template: assets/templates/tap_empty_party_slot_1-disappeared_states.png
        roi: [6, 301, 863, 175]
        threshold: 0.8
      - name: ready
        template: assets/templates/wait_for_floor_team_button-template.png
        roi: [1609, 743, 311, 337]
        threshold: 0.8
      - name: reward
        roi: [602, 650, 806, 430]
        threshold: 0.8
        templates:
          - assets/templates/wait_for_empty_party_slot_1-templates.png
          - assets/templates/generated/souls-party-reward-continue-v2.png
          - assets/templates/generated/souls-party-reward-bag-v2.png
    terminal_states: [reward]
    allow_ocr: false
    state_timeout_seconds: 180
    decorator timeout
      seconds: 300
    max_iterations: 48
  node task_7 task 确认奖励文字或奖励袋
