  node state_machine_1 state_machine 恢复到协战房间
    at: [2592, 720]
    states:
      - name: reward
        roi: [602, 650, 806, 430]
        threshold: 0.8
        templates:
          - assets/templates/wait_for_empty_party_slot_1-templates.png
          - assets/templates/generated/souls-party-reward-continue-v2.png
          - assets/templates/generated/souls-party-reward-bag-v2.png
      - name: reinvite
        template: assets/templates/wait_for_empty_party_slot_4-template.png
        roi: [946, 561, 371, 164]
        threshold: 0.8
      - name: create_confirm
        template: assets/templates/souls/party/create-confirm-button.png
        roi: [1050, 700, 500, 350]
        threshold: 0.8
      - name: create_team
        template: assets/templates/souls/party/create-team-button.png
        roi: [1400, 800, 520, 280]
        threshold: 0.8
      - name: courtyard
        template: assets/templates/souls/party/courtyard-team-button.png
        roi: [430, 940, 350, 140]
        threshold: 0.8
      - name: room
        template: assets/templates/souls/party/floor-team-button.png
        roi: [0, 0, 500, 120]
        threshold: 0.8
    terminal_states: [room]
    allow_ocr: false
    state_timeout_seconds: 30
    decorator timeout
      seconds: 150
    max_iterations: 48
