workflow souls_party_captain_stable
  version: 2.1.0
  description: "御魂队长通用流程。通过房间空位判断是否已有队友。队友昵称留空时，手动组队后启动；填写完整昵称可自动补邀，需要启用 OCR。"
  resolution: [1920, 1080]
  root: root_1
  limits:
    timeout_seconds: 21600
    max_steps: 200000
  inputs:
    运行轮数:
      type: integer
      default: 20
      min: 1
      display_name: 运行轮数
      description: 完整结算轮数；等待邀请、加载与补邀不消耗轮数。
    队友昵称:
      type: string
      default: ""
      description: 填写邀请列表中的完整昵称以自动补邀。留空时手动组队，流程等待队友入队。
  variables: {}
  node task_1 task 确认奖励文字或奖励袋
    at: [0, 1440]
    action: vision.wait_any
    params:
      roi: [602, 650, 806, 430]
      threshold: 0.8
      templates:
        - assets/templates/wait_for_empty_party_slot_1-templates.png
        - assets/templates/generated/souls-party-reward-continue-v2.png
        - assets/templates/generated/souls-party-reward-bag-v2.png
      timeout_seconds: 2
  node task_2 task 点击并复核：startup_reward_page_tap
    at: [340, 1440]
    action: input.tap_match
    params:
      revalidate: true
      verify_gone: false
      verify_timeout_seconds: 3
      random_offset: 6
      random_interval: [0.1, 0.2]
    decorator retry
      attempts: 3
      delay_seconds: 0.3
  node sequence_1 sequence 识别后点击：reward
    at: [170, 1200]
  node task_3 task 等待奖励翻页
    at: [680, 1200]
    action: core.sleep
    params:
      seconds: 0.4
  node selector_1 selector 清奖励页；已切页则确认新画面继续
    at: [425, 960]
  node task_4 task 确认画面：checkbox
    at: [1020, 1680]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/reinvite-default-checkbox.png
      roi: [780, 480, 220, 120]
      threshold: 0.8
      present: true
      timeout_seconds: 0.2
  node task_5 task 点击并复核：startup_reinvite_check_tap
    at: [1360, 1680]
    action: input.tap_match
    params:
      revalidate: true
      verify_gone: true
      verify_timeout_seconds: 3
      random_offset: 6
      random_interval: [0.1, 0.2]
    decorator retry
      attempts: 3
      delay_seconds: 0.3
  node sequence_2 sequence 识别后点击：checkbox
    at: [1190, 1440]
