workflow awakening_party_captain
  version: 2.1.0
  description: "觉醒三人组队队长。先在游戏中选好觉醒副本和层数，手动建队并邀请两位队友。每轮等待两个队友位都没有空位标记，确认仍在协战房间后挑战，结算并处理续邀。 同时填写两个不同的完整好友昵称可按缺席情况补邀，需要启用 OCR。"
  resolution: [1920, 1080]
  root: root_1
  limits:
    timeout_seconds: 21600
    max_steps: 200000
  inputs:
    运行轮数:
      type: integer
      default: 20
      min: 1
      display_name: 运行轮数
      description: 完整结算轮数；等待邀请、加载与补邀不消耗轮数。
    队友一昵称:
      type: string
      default: ""
      description: "填写邀请列表里的完整好友昵称。两项都填写才启用 OCR 自动补邀。"
    队友二昵称:
      type: string
      default: ""
      description: "填写邀请列表里的完整好友昵称。两项都填写才启用 OCR 自动补邀。"
  variables: {}
  node task_1 task 确认奖励文字或奖励袋
    at: [0, 2422]
    action: vision.wait_any
    params:
      roi: [590, 50, 940, 1030]
      threshold: 0.8
      templates:
        - assets/templates/souls/party/awakening-rift-eye.png
        - assets/templates/wait_for_empty_party_slot_1-templates.png
        - assets/templates/generated/souls-party-reward-continue-v2.png
        - assets/templates/generated/souls-party-reward-bag-v2.png
        - assets/templates/souls/party/awakening-victory.png
      timeout_seconds: 2
  node task_2 task 点击并复核：startup_reward_page_tap
    at: [332, 2422]
    action: input.tap_match
    params:
      revalidate: true
      verify_gone: false
      verify_timeout_seconds: 3
      random_offset: 6
      random_interval: [0.1, 0.2]
    decorator retry
      attempts: 3
      delay_seconds: 0.3
  node sequence_1 sequence 识别后点击：reward
    at: [166, 2004]
