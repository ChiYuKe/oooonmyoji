workflow two_souls
  version: 5.0.0
  description: 多开
  resolution: [1920, 1080]
  root: root
  inputs: {}
  variables: {}
  node root root 入口
    at: [464, 8]
  node selector_1 instance_parallel
    at: [464, 192]
    runs:
      - instance: mumu-0
        workflow: 御魂副本.owf
        inputs:
          运行轮数: 120
      - instance: mumu-1
