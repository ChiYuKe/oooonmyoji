workflow souls_party_loop
  version: 5.2.0
  description: 御魂副本组队循环：恢复到御魂选层页后创建协战队伍并邀请好友，按运行轮数循环开战、结算与续邀，直到打满轮数。
  resolution: [1920, 1080]
  root: root
  inputs:
    运行轮数:
      type: integer
      default: 99
      min: 1
      description: 组队战斗循环轮数（安全上限）。
    邀请目标:
      type: asset
      editor: asset
      display_name: 邀请目标
      description: 好友列表里要邀请的好友条目模板图（默认鱼不鲤窝，可换成其他好友）。
      default: assets/templates/souls/party/member-invite-target.png
    队友标记:
      type: asset
      editor: asset
      display_name: 队友标记
      description: 协战房间里队友昵称条的模板图，用于确认队友在队。
      default: assets/templates/souls/party/member-present.png
    入队超时_秒:
      type: duration
      min: 1
      display_name: 入队超时（秒）
      description: "等待队友接受邀请进入房间的最长时间，超时后仍会尝试开战，默认 120 秒。"
      default: 120
    战斗超时_秒:
      type: duration
      min: 1
      display_name: 战斗超时（秒）
      description: "单场组队战斗等待结算的最长时间，默认 240 秒。"
      default: 240
  variables: {}
  _inputParams: {}
  node root root 御魂副本入口
    at: [10116, 0]
