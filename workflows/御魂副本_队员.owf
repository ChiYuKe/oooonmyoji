    at: [3238, 1506]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/lobby-title.png
      present: true
      timeout_seconds: 6
      roi: [80, 0, 350, 120]
      threshold: 0.88
  node two_taps sequence 再关闭一层奖励并等待
    at: [3571, 1086]
  node tap_reward_two task 再次关闭奖励层
    at: [3488, 1296]
    action: input.tap
    params:
      x: 1500
      y: 850
      random_offset: 12
      random_interval: [0.2, 0.5]
  node wait_destination_two selector 等待地图庭院或房间
    at: [3654, 1296]
  node wait_map_two task 等待探索地图
    at: [3571, 1506]
    action: vision.wait_template
    params:
      template: assets/templates/souls/map-souls.png
      present: true
      timeout_seconds: 8
      roi: [150, 850, 250, 230]
      threshold: 0.88
  node wait_courtyard_two task 等待庭院
    at: [3737, 1506]
    action: vision.wait_template
    params:
      template: assets/templates/souls/courtyard-explore/mumu-1.png
      present: true
      timeout_seconds: 8
      roi: [650, 80, 300, 300]
      threshold: 0.88
  node wait_lobby_two task 等待协战房间
    at: [3903, 1506]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/lobby-title.png
      present: true
      timeout_seconds: 8
      roi: [80, 0, 350, 120]
      threshold: 0.88
  var inputs.运行轮数
    at: [0, 2826]
  var inputs.邀请等待_秒
    at: [112, 2826]
  var inputs.战斗超时_秒
    at: [224, 2826]
  edges:
    root -> main
    main -> rounds
    main:then.1 -> log_finished
    rounds -> round
    round -> ensure_in_party
    round:then.1 -> prepare_lineup
    round:then.2 -> wait_settlement
    round:then.3 -> tap_settlement
    round:then.4 -> settle_after_battle
    ensure_in_party -> already_in_party
    ensure_in_party:then.1 -> accept_invite
    already_in_party -> detect_lobby
    accept_invite -> wait_invite
    accept_invite:then.1 -> accept_route
    accept_route -> accept_auto_ready
    accept_route:then.1 -> accept_plain
    wait_invite -> wait_auto_ready_invite
    wait_invite:then.1 -> wait_accept_invite
    accept_auto_ready:true -> accept_auto_ready_seq
    accept_auto_ready_seq -> wait_auto_ready_recheck
    accept_auto_ready_seq:then.1 -> tap_auto_ready_invite
    accept_auto_ready_seq:then.2 -> after_auto_ready
    after_auto_ready -> lobby_direct
    after_auto_ready:then.1 -> confirm_auto_ready
    lobby_direct -> wait_lobby_quick
    confirm_auto_ready -> wait_auto_ready_confirmation
    confirm_auto_ready:then.1 -> wait_never_prompt_checkbox
    confirm_auto_ready:then.2 -> tap_never_prompt_checkbox
    confirm_auto_ready:then.3 -> tap_auto_ready_confirm
    confirm_auto_ready:then.4 -> wait_lobby_after_confirm
    accept_plain:true -> accept_plain_seq
    accept_plain_seq -> wait_accept_recheck
    accept_plain_seq:then.1 -> tap_accept_invite
    accept_plain_seq:then.2 -> wait_lobby_after_accept
    prepare_lineup -> lineup_locked
    prepare_lineup:then.1 -> do_prepare
    prepare_lineup:then.2 -> assume_auto_started
    do_prepare -> wait_ready
    do_prepare:then.1 -> tap_ready
    settle_after_battle -> wait_destination_direct
    settle_after_battle:then.1 -> one_tap
    settle_after_battle:then.2 -> two_taps
    wait_destination_direct -> wait_map_direct
    wait_destination_direct:then.1 -> wait_courtyard_direct
    wait_destination_direct:then.2 -> wait_lobby_direct
    one_tap -> tap_reward_one
    one_tap:then.1 -> wait_destination_one
    wait_destination_one -> wait_map_one
    wait_destination_one:then.1 -> wait_courtyard_one
    wait_destination_one:then.2 -> wait_lobby_one
    two_taps -> tap_reward_two
    two_taps:then.1 -> wait_destination_two
    wait_destination_two -> wait_map_two
    wait_destination_two:then.1 -> wait_courtyard_two
    wait_destination_two:then.2 -> wait_lobby_two
    var__inputs__运行轮数:out -> rounds:decorators.0.count
    var__inputs__邀请等待_秒:out -> wait_accept_invite:timeout_seconds
    var__inputs__战斗超时_秒:out -> wait_settlement:timeout_seconds
    wait_auto_ready_recheck:out.0 -> tap_auto_ready_invite:match
    wait_never_prompt_checkbox:out.0 -> tap_never_prompt_checkbox:match
    wait_auto_ready_confirmation:out.0 -> tap_auto_ready_confirm:match
    wait_accept_recheck:out.0 -> tap_accept_invite:match
    wait_ready:out.0 -> tap_ready:match
    wait_settlement:out.0 -> tap_settlement:match
