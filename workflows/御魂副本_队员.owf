workflow souls_party_member_loop
  version: 5.1.0
  description: 御魂副本组队队员循环：待机接受队长的组队邀请（首次可勾选不再提示启用自动准备），进入协战房间后点准备参战并完成结算，按运行轮数循环。
  resolution: [1920, 1080]
  root: root
  inputs:
    运行轮数:
      type: integer
      default: 99
      min: 1
      description: 接受邀请并参战的循环轮数（安全上限），与队长工作流的运行轮数保持一致。
    邀请等待_秒:
      type: duration
      min: 1
      display_name: 邀请等待（秒）
      description: "等待队长发出组队邀请弹窗的最长时间，默认 170 秒。"
      default: 170
    战斗超时_秒:
      type: duration
      min: 1
      display_name: 战斗超时（秒）
      description: "单场组队战斗等待结算的最长时间，默认 240 秒。"
      default: 240
  variables: {}
  _inputParams: {}
  node root root 御魂副本队员入口
    at: [498, 0]
  node main sequence 御魂组队队员循环主流程
    at: [498, 208]
  node rounds sequence 按运行轮数循环
    at: [498, 438]
    decorator repeat
  node round sequence 单轮：接受邀请并参战
    at: [498, 666]
  node log_finished task 记录已完成全部轮数
    at: [996, 438]
    action: core.log
    params:
      message: 御魂副本队员：已按运行轮数完成全部参战
  node ensure_in_party selector 确认已在协战房间或接受邀请
    at: [166, 854]
  node already_in_party sequence 已在协战房间
    at: [0, 1086]
  node detect_lobby task 快速检测协战房间
    at: [0, 1296]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/lobby-title.png
      present: true
      timeout_seconds: 1
      roi: [80, 0, 350, 120]
      threshold: 0.88
  node accept_invite sequence 等待并接受组队邀请
    at: [332, 1086]
  node wait_invite selector 等待邀请弹窗
    at: [332, 1296]
  node wait_auto_ready_invite task 等待自动准备邀请按钮
    at: [249, 1506]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/auto-ready-invite-button.png
      present: true
      timeout_seconds: 15
      roi: [250, 300, 220, 180]
      threshold: 0.9
  node wait_accept_invite task 等待普通组队邀请
    at: [415, 1506]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/accept-invite-button.png
      present: true
      roi: [100, 280, 220, 220]
      threshold: 0.9
  node accept_route selector 按邀请类型接受
    at: [332, 1726]
  node accept_auto_ready condition 自动准备邀请已出现
    at: [249, 1946]
    expression: exists nodes.wait_auto_ready_invite.output.0
  node accept_auto_ready_seq sequence 接受自动准备邀请
    at: [83, 1946]
  node wait_auto_ready_recheck task 复查自动准备邀请按钮
    at: [0, 2166]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/auto-ready-invite-button.png
      present: true
      timeout_seconds: 3
      roi: [250, 300, 220, 180]
      threshold: 0.9
  node tap_auto_ready_invite task 点击自动准备接受邀请
    at: [166, 2166]
    action: input.tap_match
    params:
      revalidate: false
      random_offset: 3
      random_interval: [0.0, 0.15]
  node after_auto_ready selector 首次确认或直接入队
    at: [332, 2166]
  node lobby_direct sequence 已直接进入队伍
    at: [249, 2386]
  node wait_lobby_quick task 短暂等待协战房间
    at: [249, 2606]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/lobby-title.png
      present: true
      timeout_seconds: 3
      roi: [80, 0, 350, 120]
      threshold: 0.88
  node confirm_auto_ready sequence 勾选不再提示并确认
    at: [415, 2386]
  node wait_auto_ready_confirmation task 等待自动准备确认弹窗
    at: [332, 2606]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/continue-confirm-button.png
      present: true
      timeout_seconds: 10
      roi: [900, 520, 450, 260]
      threshold: 0.9
  node wait_never_prompt_checkbox task 定位不再提示勾选框
    at: [498, 2606]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/never-prompt-checkbox.png
      present: true
      timeout_seconds: 3
      roi: [780, 460, 250, 180]
      threshold: 0.9
  node tap_never_prompt_checkbox task 勾选不再提示
    at: [664, 2606]
    action: input.tap_match
    params:
      revalidate: false
      random_offset: 3
      random_interval: [0.0, 0.15]
  node tap_auto_ready_confirm task 确认战前自动准备
    at: [830, 2606]
    action: input.tap_match
    params:
      revalidate: false
      random_offset: 3
      random_interval: [0.0, 0.15]
  node wait_lobby_after_confirm task 等待自动准备入队
    at: [996, 2606]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/lobby-title.png
      present: true
      timeout_seconds: 30
      roi: [80, 0, 350, 120]
      threshold: 0.88
  node accept_plain condition 普通邀请已出现
    at: [620, 1946]
    expression: exists nodes.wait_accept_invite.output.0
  node accept_plain_seq sequence 接受组队邀请
    at: [581, 1946]
  node wait_accept_recheck task 复查普通邀请按钮
    at: [581, 2166]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/accept-invite-button.png
      present: true
      timeout_seconds: 3
      roi: [100, 280, 220, 220]
      threshold: 0.9
  node tap_accept_invite task 接受组队邀请
    at: [747, 2166]
    action: input.tap_match
    params:
      revalidate: true
      random_offset: 4
      random_interval: [0.2, 0.6]
  node wait_lobby_after_accept task 等待进入协战房间
    at: [913, 2166]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/lobby-title.png
      present: true
      timeout_seconds: 30
      roi: [80, 0, 350, 120]
      threshold: 0.88
  node prepare_lineup selector 未锁定阵容时点击准备
    at: [1494, 854]
  node lineup_locked task 检测阵容已锁定
    at: [1411, 1086]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/formation-locked.png
      present: true
      timeout_seconds: 2
      roi: [130, 930, 140, 100]
      threshold: 0.4
  node do_prepare sequence 等待并点击准备
    at: [1577, 1086]
  node wait_ready task 等待准备按钮
    at: [1494, 1296]
    action: vision.wait_template
    params:
      template: assets/templates/souls/souls-ready.png
      present: true
      timeout_seconds: 150
      roi: [1500, 700, 420, 380]
      threshold: 0.88
  node tap_ready task 点击准备开始战斗
    at: [1660, 1296]
    action: input.tap_match
    params:
      revalidate: true
      random_offset: 5
      random_interval: [0.2, 0.6]
  node assume_auto_started task 记录按已开战处理
    at: [1743, 1086]
    action: core.log
    params:
      message: 未识别到阵容锁定或准备按钮，按已自动开战继续等待结算
  node wait_settlement task 等待战斗结算
    at: [1826, 854]
    action: vision.wait_template
    params:
      template: assets/templates/souls/souls-victory-continue.png
      present: true
      roi: [650, 900, 650, 180]
      threshold: 0.86
  node tap_settlement task 点击结算页继续
    at: [2158, 854]
    action: input.tap_match
    params:
      revalidate: true
      random_offset: 8
      random_interval: [0.2, 0.6]
    decorator retry
      attempts: 5
      delay_seconds: 1
  node settle_after_battle selector 关闭奖励并回到待命界面
    at: [2490, 854]
  node wait_destination_direct selector 等待地图庭院或房间
    at: [2324, 1086]
  node wait_map_direct task 等待探索地图
    at: [2241, 1296]
    action: vision.wait_template
    params:
      template: assets/templates/souls/map-souls.png
      present: true
      timeout_seconds: 4
      roi: [150, 850, 250, 230]
      threshold: 0.88
  node wait_courtyard_direct task 等待庭院
    at: [2407, 1296]
    action: vision.wait_template
    params:
      template: assets/templates/souls/courtyard-explore/mumu-1.png
      present: true
      timeout_seconds: 4
      roi: [650, 80, 300, 300]
      threshold: 0.88
  node wait_lobby_direct task 等待协战房间
    at: [2573, 1296]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/lobby-title.png
      present: true
      timeout_seconds: 4
      roi: [80, 0, 350, 120]
      threshold: 0.88
  node one_tap sequence 关闭一层奖励后等待
    at: [2906, 1086]
  node tap_reward_one task 关闭奖励层
    at: [2823, 1296]
    action: input.tap
    params:
      x: 1500
      y: 850
      random_offset: 12
      random_interval: [0.2, 0.5]
  node wait_destination_one selector 等待地图庭院或房间
    at: [2989, 1296]
  node wait_map_one task 等待探索地图
    at: [2906, 1506]
    action: vision.wait_template
    params:
      template: assets/templates/souls/map-souls.png
      present: true
      timeout_seconds: 6
      roi: [150, 850, 250, 230]
      threshold: 0.88
