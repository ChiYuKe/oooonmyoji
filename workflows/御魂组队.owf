workflow souls_party_create
  version: 1.0.0
  description: "御魂组队：选层页点组队 → 组队面板点创建队伍 → 弹窗选不公开（仅邀请）并点创建 → 进协战房间。就这 4 步。"
  resolution: [1920, 1080]
  root: root
  inputs: {}
  variables: {}

  node root root 组队入口
    at: [0, 0]
  node steps sequence 组队四步
    at: [200, 0]

  node s1_wait_party task 等待组队按钮
    at: [400, 0]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/floor-party-button.png
      present: true
      timeout_seconds: 10
      roi: [1350, 820, 300, 240]
      threshold: 0.9
  node s1_tap_party task 点组队
    at: [400, 160]
    action: input.tap_match
    params:
      revalidate: true
      random_offset: 4

  node s2_wait_create_team task 等待创建队伍
    at: [400, 320]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/create-team-button.png
      present: true
      timeout_seconds: 20
      roi: [1400, 840, 400, 180]
      threshold: 0.9
  node s2_tap_create_team task 点创建队伍
    at: [400, 480]
    action: input.tap_match
    params:
      revalidate: true
      random_offset: 4

  node s3_tap_private task 选不公开（仅邀请）
    at: [400, 640]
    action: input.tap
    params:
      x: 1148
      y: 765
      random_offset: 3
  node s3_wait_confirm task 等待创建按钮
    at: [400, 800]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/create-confirm-button.png
      present: true
      timeout_seconds: 5
      roi: [1150, 780, 350, 220]
      threshold: 0.9
  node s3_tap_confirm task 点创建
    at: [400, 960]
    action: input.tap_match
    params:
      revalidate: true
      random_offset: 4

  node s4_wait_lobby task 等待协战队伍
    at: [400, 1120]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/lobby-title.png
      present: true
      timeout_seconds: 30
      roi: [80, 0, 350, 120]
      threshold: 0.88

  edges:
    s1_wait_party:out.matches.0 -> s1_tap_party:match
    s2_wait_create_team:out.matches.0 -> s2_tap_create_team:match
    s3_wait_confirm:out.matches.0 -> s3_tap_confirm:match
    root -> steps
    steps:then.0 -> s1_wait_party
    steps:then.1 -> s1_tap_party
    steps:then.2 -> s2_wait_create_team
    steps:then.3 -> s2_tap_create_team
    steps:then.4 -> s3_tap_private
    steps:then.5 -> s3_wait_confirm
    steps:then.6 -> s3_tap_confirm
    steps:then.7 -> s4_wait_lobby
