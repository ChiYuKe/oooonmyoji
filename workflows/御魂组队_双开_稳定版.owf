workflow souls_party_duo_stable
  version: 2.1.0
  description: "双开御魂：mumu-0 队长、mumu-1 队员。队长建议停在已选御魂悲鸣的协战房间，队员停在庭院；也支持队长从庭院或创建队伍页恢复，沿用游戏记忆目标。双方完成相同结算轮数，任一侧失败会停止另一侧。"
  resolution: [1920, 1080]
  root: root_1
  limits:
    timeout_seconds: 21600
    max_steps: 200000
  inputs:
    运行轮数:
      type: integer
      default: 120
      min: 1
      display_name: 运行轮数
      description: 完整结算轮数；等待邀请、加载与补邀不消耗轮数。
  variables: {}
  node root_1 root 双开入口
    at: [0, 0]
  node instance_parallel_1 instance_parallel 同时启动队长和队员
    at: [0, 240]
    runs:
      - instance: mumu-0
        workflow: 御魂组队_队长_稳定版.owf
        inputs: {}
      - instance: mumu-1
        workflow: 御魂组队_队员_稳定版.owf
        inputs: {}
    wait_for: all
    cancel_on_failure: true
  var inputs.运行轮数
    at: [-312, 552]
  edges:
    var__inputs__运行轮数:out -> instance_parallel_1:runs.0.inputs.运行轮数
    var__inputs__运行轮数:out -> instance_parallel_1:runs.1.inputs.运行轮数
    root_1 -> instance_parallel_1
