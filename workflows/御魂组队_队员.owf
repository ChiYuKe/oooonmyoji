workflow souls_party_member
  version: 1.0.0
  description: |
    御魂组队循环（队员 / 吃鱼侧）：待机等队长的协战邀请弹窗（可先收到一条
    instance 信号做提示），点绿勾接受入队，然后等队长开战、打完把奖励页点掉并
    确认续邀，再回到待机等下一次邀请。

    队员侧不主动开战：开战由队长在协战房间里点挑战触发。自动准备/自动挑战由
    游戏本身负责，这里只处理「接受邀请」和「结算推进」两件事。
  resolution: [1920, 1080]
  root: member_entry
  limits:
    timeout_seconds: 21600
    max_steps: 200000
  inputs:
    运行轮数:
      type: integer
      default: 20
      min: 1
      display_name: 运行轮数
      description: |
        状态机的轮数预算，建议与队长工作流保持一致。一轮 = 一次「识别当前画面 + 处理」，
        被邀请、参战、结算各会吃掉若干轮。
  variables: {}
  node member_entry root 御魂组队队员入口
    at: [160, -528]
  node member_main_flow sequence 队员主流程
    at: [144, -256]
  node wait_for_invite_accept_button task 等待协战邀请弹窗
    at: [-1216, 168]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/invite-accept-button.png
      present: true
      allow_timeout: true
      timeout_seconds: 100
      roi: [0, 296, 783, 186]
      threshold: 0.8
  node floor_page_detected condition 已回到御魂选层页
    at: [840, 136]
  node floor_page_detected_after_battle condition 已回到御魂选层页
    at: [1184, 744]
  node wait_for_floor_page_return sequence 确认御魂选层页状态
    at: [752, 448]
  node wait_for_floor_team_button task 等待御魂选层页组队按钮
    at: [304, 720]
    action: vision.wait_template
    params:
      template: assets/templates/wait_for_floor_team_button-template.png
      present: true
      allow_timeout: true
      timeout_seconds: 300
      roi: [1609, 743, 309, 337]
      threshold: 0.8
  node floor_button_wait_timeout break 选层页按钮等待超时
    at: [640, 808]
  node accept_party_invite task 接受协战邀请
    at: [-872, 144]
    action: input.tap_match
    params:
      verify_gone: true
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
  node wait_for_floor_page task 等待御魂选层页
    at: [88, 192]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/floor-team-button.png
      present: true
      allow_timeout: true
      timeout_seconds: 300
      roi: [0, 0, 419, 139]
      threshold: 0.8
  node floor_page_wait_timeout break 选层页按钮等待超时
    at: [440, 176]
  node accept_invitation_sequence sequence 等待并接受组队邀请
    at: [-840, -72]
  node wait_for_next_party_round sequence 等待下一轮协战
    at: [456, -48]
  node accept_party_invite_1 task 接受协战邀请
    at: [1232, 1080]
    action: input.tap_match
    params:
      verify_gone: true
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
    decorator retry
      attempts: 3
      delay_seconds: 0.1
  node sequence_1 sequence
    at: [1032, 912]
  node accept_party_invite_2 task 接受协战邀请
    at: [920, 1088]
    action: core.sleep
    params:
      seconds: 1
    decorators: []
  edges:
    floor_page_wait_timeout:out.found -> floor_page_detected:condition
    floor_button_wait_timeout:out.found -> floor_page_detected_after_battle:condition
    wait_for_floor_team_button:out -> floor_button_wait_timeout:ref
    wait_for_invite_accept_button:out.matches.0 -> accept_party_invite:match
    wait_for_floor_page:out -> floor_page_wait_timeout:ref
    wait_for_floor_team_button:out.matches.0 -> accept_party_invite_1:match
    member_entry -> member_main_flow
    member_main_flow -> accept_invitation_sequence
    member_main_flow:then.1 -> wait_for_next_party_round
    floor_page_detected:true -> wait_for_floor_page_return
    floor_page_detected_after_battle:true -> sequence_1
    wait_for_floor_page_return -> wait_for_floor_team_button
    wait_for_floor_page_return:then.1 -> floor_page_detected_after_battle
    accept_invitation_sequence -> wait_for_invite_accept_button
    accept_invitation_sequence:then.1 -> accept_party_invite
    wait_for_next_party_round -> wait_for_floor_page
    wait_for_next_party_round:then.1 -> floor_page_detected
    sequence_1 -> accept_party_invite_2
    sequence_1:then.1 -> accept_party_invite_1
