workflow souls_party_member
  version: 1.0.0
  description: |
    御魂组队循环（队员 / 吃鱼侧）：待机等队长的协战邀请弹窗（可先收到一条
    instance 信号做提示），点绿勾接受入队，然后等队长开战、打完把奖励页点掉并
    确认续邀，再回到待机等下一次邀请。

    队员侧不主动开战：开战由队长在协战房间里点挑战触发。自动准备/自动挑战由
    游戏本身负责，这里只处理「接受邀请」和「结算推进」两件事。
  resolution: [1920, 1080]
  root: root_1
  limits:
    timeout_seconds: 21600
    max_steps: 200000
  inputs:
    运行轮数:
      type: integer
      default: 20
      min: 1
      display_name: 运行轮数
      description: |
        状态机的轮数预算，建议与队长工作流保持一致。一轮 = 一次「识别当前画面 + 处理」，
        被邀请、参战、结算各会吃掉若干轮。
  variables: {}
  _inputParams: {}
  node root_1 root 御魂组队队员入口
    at: [200, -664]
  node sequence_4 sequence 首轮：等邀请并入队
    at: [144, -256]
    decorator do_once
      reset_on_failure: false
  node task_1 task 等待协战邀请弹窗（绿勾）
    at: [-1216, 168]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/invite-accept-button.png
      present: true
      allow_timeout: true
      timeout_seconds: 100
      roi: [0, 296, 783, 186]
      threshold: 0.8
  node condition_1 condition 已回到协战队伍房间
    at: [840, 136]
  node condition_2 condition 「准备」按钮已出现
    at: [1184, 744]
  node sequence_5 sequence 等房间内「准备」按钮
    at: [752, 448]
  node task_2 task 等待右下角「准备」按钮
    at: [304, 720]
    action: vision.wait_template
    params:
      template: assets/templates/wait_for_floor_team_button-template.png
      present: true
      allow_timeout: true
      timeout_seconds: 300
      roi: [1609, 743, 309, 337]
      threshold: 0.8
  node break_1 break 取等待结果（准备按钮）
    at: [640, 808]
  node task_3 task 点击绿勾接受入队
    at: [-872, 144]
    action: input.tap_match
    params:
      verify_gone: true
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
      disappeared_states:
        - name: "12"
          template: assets/templates/souls/party/floor-team-button.png
          roi: [0, 0, 476, 156]
    decorator retry
      attempts: 5
      delay_seconds: 0.2
  node task_4 task 等待回到「协战队伍」房间
    at: [88, 192]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/floor-team-button.png
      present: true
      allow_timeout: true
      timeout_seconds: 300
      roi: [0, 0, 419, 139]
      threshold: 0.8
  node break_2 break 取等待结果（房间标题）
    at: [440, 176]
  node sequence_6 sequence 等待邀请弹窗并接受
    at: [-840, -72]
  node sequence_7 sequence 每轮：认画面·点准备
    at: [456, -48]
  node task_5 task 点击「准备」按钮
    at: [1064, 1216]
    action: input.tap_match
    params:
      verify_gone: true
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
    decorator retry
      attempts: 3
      delay_seconds: 0.1
  node sequence_1 sequence 点「准备」参战
    at: [864, 1048]
  node task_6 task 点击前稍等一秒
    at: [752, 1224]
    action: core.sleep
    params:
      seconds: 1
    decorators: []
  node task_7 task 等待「点击屏幕继续」
    at: [1640, 720]
    action: vision.wait_any
    params:
      templates:
        - assets/templates/wait_for_empty_party_slot_1-templates.png
        - assets/templates/wait_for_empty_party_slot_1-templates.png
      roi: [602, 778, 806, 302]
      timeout_seconds: 60
  node task_8 task 点击「点击屏幕继续」
    at: [1984, 720]
    action: input.tap_match
    params:
      verify_gone: true
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
      disappeared_states:
        - name: "11"
          template: assets/templates/tap_empty_party_slot_1-disappeared_states.png
          roi: [0, 298, 868, 159]
          threshold: 0.85
      verify_timeout_seconds: 20
    decorator retry
      attempts: 5
      delay_seconds: 0.2
  node sequence_2 sequence 战斗结束：结算收尾
    at: [2240, 392]
  node task_9 task 等待齿轮绿勾图标
    at: [2328, 680]
    action: vision.wait_template
    params:
      template: assets/templates/tap_empty_party_slot_1-disappeared_states.png
      present: true
      timeout_seconds: 10
      roi: [6, 301, 863, 175]
  node task_10 task 点击齿轮绿勾图标
    at: [2672, 680]
    action: input.tap_match
    params:
      verify_gone: true
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
      disappeared_states:
        - name: "11"
          template: assets/templates/souls/party/floor-team-button.png
          roi: [0, 298, 868, 159]
          threshold: 0.85
    decorator retry
      attempts: 5
      delay_seconds: 0.2
  node sequence_3 sequence 主循环（按运行轮数重复）
    at: [168, -464]
    decorator repeat
  var inputs.运行轮数
  edges:
    break_2:out.found -> condition_1:condition
    break_1:out.found -> condition_2:condition
    task_2:out -> break_1:ref
    task_1:out.matches.0 -> task_3:match
    task_4:out -> break_2:ref
    task_2:out.matches.0 -> task_5:match
    task_7:out.match -> task_8:match
    task_9:out.matches.0 -> task_10:match
    var__inputs__运行轮数:out -> sequence_3:decorators.0.count
    root_1 -> sequence_3
    sequence_4 -> sequence_6
    sequence_4:then.1 -> sequence_7
    condition_1:true -> sequence_5
    condition_2:true -> sequence_1
    sequence_5 -> task_2
    sequence_5:then.1 -> condition_2
    sequence_6 -> task_1
    sequence_6:then.1 -> task_3
    sequence_7 -> task_4
    sequence_7:then.1 -> condition_1
    sequence_7:then.2 -> sequence_2
    sequence_1 -> task_6
    sequence_1:then.1 -> task_5
    sequence_2 -> task_7
    sequence_2:then.1 -> task_8
    sequence_2:then.2 -> task_9
    sequence_2:then.3 -> task_10
    sequence_3 -> sequence_4
