workflow souls_party_member
  version: 1.0.0
  description: |
    御魂组队循环（队员 / 吃鱼侧）：每轮先点掉残留的结算奖励页，再等队长的邀请／
    续邀弹窗（绿勾，含自动接受横幅），等到就点绿勾接受入队；随后等右下角「准备」
    按钮出现并点击参战——「准备」按钮就是在队长队伍里的可靠信号（自己的等待房
    也叫「协战队伍」，不能用房间标题判断）；按钮一直没出现（已自动开战或还没轮
    到自己）就记日志继续。战斗结束后把结算奖励页点掉（可能有多页，点完为止），
    若出现齿轮绿勾（自动接受邀请）就顺手点掉，回到待机等下一轮邀请。

    首轮与后续轮次共用同一套循环体，循环往复直到运行轮数用完。若整轮既没有邀请
    也没有开战（等待结算超时），记日志跳过本轮，下一轮继续等邀请。队员侧不主动
    开战：开战由队长在协战房间里点挑战触发。
  resolution: [1920, 1080]
  root: root_1
  limits:
    timeout_seconds: 21600
    max_steps: 200000
  inputs:
    运行轮数:
      type: integer
      default: 20
      min: 1
      display_name: 运行轮数
      description: |
        循环轮数预算，建议与队长工作流保持一致。一轮 = 一次完整的
        「等邀请 → 入队 → 准备 → 结算 → 续邀」，默认 20 即最多参战 20 场。
  variables: {}
  _inputParams: {}
  node root_1 root 御魂组队队员入口
    at: [0, 0]
  node sequence_3 sequence 主循环（按运行轮数重复）
    at: [420, 0]
    decorator repeat
  node sequence_4 sequence 每轮：清残留·等邀请入队·准备参战·结算续邀
    at: [840, 0]
  node sequence_11 sequence 清理残留奖励页（点完为止）
    at: [1260, -240]
    decorator repeat
      count: 16
    decorator force_success
  node task_19 task 等待「点击屏幕继续」
    at: [1260, 0]
    action: vision.wait_template
    params:
      template: assets/templates/wait_for_empty_party_slot_1-templates.png
      present: true
      allow_timeout: true
      timeout_seconds: 8
      roi: [602, 778, 806, 302]
      threshold: 0.8
  node break_6 break 取等待结果（残留奖励页）
    at: [1072, 0]
  node condition_8 condition 残留奖励页仍在
    at: [1260, 240]
  node task_20 task 点击「点击屏幕继续」
    at: [1450, 240]
    action: input.tap_match
    params:
      verify_gone: false
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
  node sequence_6 sequence 等待邀请弹窗并接受
    at: [1260, 480]
  node task_1 task 等待协战邀请弹窗（绿勾）
    at: [1260, 720]
    action: vision.wait_template
    params:
      template: assets/templates/souls/party/invite-accept-button.png
      present: true
      allow_timeout: true
      timeout_seconds: 90
      roi: [0, 296, 783, 186]
      threshold: 0.8
  node break_3 break 取等待结果（邀请弹窗）
    at: [1640, 480]
  node condition_6 condition 收到邀请弹窗
    at: [2040, 480]
  node task_13 task 日志：未等到邀请弹窗
    at: [2440, 720]
    action: core.log
    params:
      message: 未等到邀请弹窗（可能已在队伍中），直接等待「准备」参战
  node task_3 task 点击绿勾接受入队
    at: [2440, 480]
    action: input.tap_match
    params:
      verify_gone: true
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
      disappeared_states:
        - name: "12"
          template: assets/templates/souls/party/floor-team-button.png
          roi: [0, 0, 476, 156]
    decorator retry
      attempts: 5
      delay_seconds: 0.2
    decorator force_success
  node sequence_7 sequence 等「准备」·参战·结算
    at: [2860, 240]
  node sequence_5 sequence 等房间内「准备」按钮
    at: [2860, 480]
  node task_2 task 等待右下角「准备」按钮
    at: [2860, 720]
    action: vision.wait_template
    params:
      template: assets/templates/wait_for_floor_team_button-template.png
      present: true
      allow_timeout: true
      timeout_seconds: 15
      roi: [1609, 743, 309, 337]
      threshold: 0.8
  node break_1 break 取等待结果（准备按钮）
    at: [3240, 720]
  node condition_2 condition 「准备」按钮已出现
    at: [3640, 720]
  node task_14 task 日志：未出现「准备」按钮
    at: [4040, 960]
    action: core.log
    params:
      message: 「准备」按钮未出现（已自动开战或尚未开战），直接等待结算
  node sequence_1 sequence 点「准备」参战
    at: [4040, 720]
  node task_6 task 点击前稍等一秒
    at: [4040, 960]
    action: core.sleep
    params:
      seconds: 1
    decorators: []
  node task_5 task 点击「准备」按钮
    at: [4360, 960]
    action: input.tap_match
    params:
      verify_gone: true
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
    decorator retry
      attempts: 3
      delay_seconds: 0.1
  node sequence_2 sequence 战斗结束：结算收尾
    at: [4680, 480]
  node task_7 task 等待战斗结束（奖励页出现）
    at: [4680, 720]
    action: vision.wait_template
    params:
      template: assets/templates/wait_for_empty_party_slot_1-templates.png
      present: true
      allow_timeout: true
      timeout_seconds: 120
      roi: [602, 778, 806, 302]
      threshold: 0.8
  node break_8 break 取等待结果（本局是否开战）
    at: [5040, 720]
  node condition_13 condition 本局已开战（结算页出现）
    at: [5340, 720]
  node task_24 task 日志：本局未开战（等待下一轮邀请）
    at: [5640, 960]
    action: core.log
    params:
      message: 等待结算超时，本局未开战，回到待机等下一次邀请弹窗
  node sequence_21 sequence 奖励与续邀确认
    at: [5640, 720]
  node sequence_10 sequence 结算监视：点页·接邀请·直到回房
    at: [5640, 960]
    decorator repeat
      count: 16
    decorator force_success
  node task_18 task 等待奖励页·邀请横幅·回房
    at: [5640, 1200]
    action: vision.wait_any
    params:
      templates:
        - assets/templates/wait_for_empty_party_slot_1-templates.png
        - assets/templates/tap_empty_party_slot_1-disappeared_states.png
        - assets/templates/souls/party/invite-accept-button.png
        - assets/templates/souls/party/floor-team-button.png
      roi: [0, 0, 1408, 1080]
      timeout_seconds: 15
    decorator force_success
  node task_8 task 点击「点击屏幕继续」
    at: [5960, 1200]
    action: input.tap_match
    params:
      verify_gone: false
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
    decorator retry
      attempts: 5
      delay_seconds: 0.2
  node task_9 task 等待齿轮绿勾图标（自动接受邀请）
    at: [6280, 960]
    action: vision.wait_template
    params:
      template: assets/templates/tap_empty_party_slot_1-disappeared_states.png
      present: true
      allow_timeout: true
      timeout_seconds: 15
      roi: [6, 301, 863, 175]
  node break_4 break 取等待结果（齿轮绿勾）
    at: [6280, 1180]
  node condition_7 condition 齿轮绿勾已出现
    at: [6280, 1360]
  node task_16 task 日志：无齿轮绿勾（直接等下一轮邀请）
    at: [6600, 1360]
    action: core.log
    params:
      message: 结算后未出现齿轮绿勾，跳过，回到待机等下一次邀请弹窗
  node task_10 task 点击齿轮绿勾图标（自动接受下一次邀请）
    at: [6600, 960]
    action: input.tap_match
    params:
      verify_gone: true
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
    decorator retry
      attempts: 5
      delay_seconds: 0.2
  var inputs.运行轮数
    at: [-480, 240]
  node task_38b task 点击绿勾立即接受入队
    at: [7580, 2140]
    action: input.tap_match
    params:
      verify_gone: true
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
      disappeared_states:
        - name: "12"
          template: assets/templates/souls/party/floor-team-button.png
          roi: [0, 0, 476, 156]
    decorator force_success
  node task_64 task 日志：无横幅未回房（继续等延迟页）
    at: [7580, 2400]
    action: core.log
    params:
      message: 暂未回房也无邀请横幅，继续等待延迟奖励页
  node condition_24 condition 出现的是奖励页
    at: [5960, 1400]
    expression: nodes.task_18.output.template == assets/templates/wait_for_empty_party_slot_1-templates.png
  node condition_25 condition 出现的是邀请横幅
    at: [6280, 1400]
    expression: nodes.task_18.output.template == assets/templates/souls/party/invite-accept-button.png
  node condition_26 condition 已回到房间（结算完成）
    at: [6600, 1400]
    expression: nodes.task_18.output.template == assets/templates/souls/party/floor-team-button.png
  node condition_27 condition 出现的是齿轮勾（自动接受）
    at: [6280, 1180]
    expression: nodes.task_18.output.template == assets/templates/tap_empty_party_slot_1-disappeared_states.png
  node task_65 task 点齿轮勾接受并注册自动接受
    at: [6600, 1180]
    action: input.tap_match
    params:
      verify_gone: true
      random_interval: [0.2, 0.5]
      random_offset: 20
      disappeared_state_timeout_seconds: 1
    decorator force_success
  edges:
    var__inputs__运行轮数:out -> sequence_3:decorators.0.count
    task_1:out -> break_3:ref
    break_3:out.found -> condition_6:condition
    task_1:out.matches.0 -> task_3:match
    task_2:out -> break_1:ref
    break_1:out.found -> condition_2:condition
    task_2:out.matches.0 -> task_5:match
    task_19:out -> break_6:ref
    break_6:out.found -> condition_8:condition
    task_19:out.matches.0 -> task_20:match
    task_9:out -> break_4:ref
    break_4:out.found -> condition_7:condition
    task_9:out.matches.0 -> task_10:match
    task_7:out -> break_8:ref
    break_8:out.found -> condition_13:condition
    root_1 -> sequence_3
    sequence_3 -> sequence_4
    sequence_4 -> sequence_11
    sequence_4:then.1 -> sequence_6
    sequence_4:then.2 -> sequence_7
    sequence_11 -> task_19
    sequence_11:then.1 -> condition_8
    condition_8:true -> task_20
    sequence_6 -> task_1
    sequence_6:then.1 -> condition_6
    condition_6:true -> task_3
    condition_6:false -> task_13
    sequence_7 -> sequence_5
    sequence_7:then.1 -> sequence_2
    sequence_5 -> task_2
    sequence_5:then.1 -> condition_2
    condition_2:true -> sequence_1
    condition_2:false -> task_14
    sequence_1 -> task_6
    sequence_1:then.1 -> task_5
    sequence_2 -> task_7
    sequence_2:then.1 -> condition_13
    condition_13:true -> sequence_21
    condition_13:false -> task_24
    sequence_21 -> sequence_10
    sequence_21:then.1 -> task_9
    sequence_21:then.2 -> condition_7
    condition_7:true -> task_10
    condition_7:false -> task_16
    sequence_10 -> task_18
    sequence_10:then.1 -> condition_24
    condition_24:true -> task_8
    condition_25:true -> task_38b
    condition_25:false -> condition_26
    condition_26:false -> task_64
    task_18:out.match -> task_8:match
    task_18:out.match -> task_38b:match
    condition_24:false -> condition_27
    condition_27:true -> task_65
    condition_27:false -> condition_25
    task_18:out.match -> task_65:match
