workflow souls_party_captain
  version: 2.1.0
  description: 御魂队长：从协战房间、庭院或创建队伍页启动。按画面恢复、邀请指定好友、确认队友后开战，逐页结算并续邀。等待与补邀不扣轮数；未知页面超时停止。默认沿用游戏记忆的队伍目标，请先确认御魂悲鸣。
  resolution: [1920, 1080]
  root: root
  limits:
    timeout_seconds: 21600
    max_steps: 200000
  inputs:
    运行轮数:
      type: integer
      default: 20
      min: 1
      display_name: 运行轮数
      description: 完整结算轮数；等待邀请、加载与补邀不消耗轮数。
  variables: {}
  node startup_reward_page_find task 确认奖励文字或奖励袋
    at: [0, 1440]
    action: vision.wait_any
    params:
      roi: [602, 650, 806, 430]
      threshold: 0.8
      templates:
        - assets/templates/wait_for_empty_party_slot_1-templates.png
        - assets/templates/generated/souls-party-reward-continue-v2.png
        - assets/templates/generated/souls-party-reward-bag-v2.png
      timeout_seconds: 2
  node startup_reward_page_tap task 点击并复核：startup_reward_page_tap
    at: [340, 1440]
    action: input.tap_match
    params:
      revalidate: true
      verify_gone: false
      verify_timeout_seconds: 3
      random_offset: 6
      random_interval: [0.1, 0.2]
    decorator retry
      attempts: 3
      delay_seconds: 0.3
  node startup_reward_page sequence 识别后点击：reward
    at: [170, 1200]
  node startup_reward_pause task 等待奖励翻页
    at: [680, 1200]
    action: core.sleep
    params:
      seconds: 0.4
  node startup_reward selector 清奖励页；已切页则确认新画面继续
    at: [425, 960]
