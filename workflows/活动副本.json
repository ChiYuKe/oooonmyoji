{
  "schema_version": 4,
  "id": "activity_loop",
  "version": "4.4.0",
  "description": "活动副本循环：按页面状态处理挑战页和结算页，点击后确认返回挑战页；运行轮数由输入参数控制。",
  "resolution": [
    1920,
    1080
  ],
  "root": "root",
  "inputs": {
    "v_3a3d58354dbf4aeb8a85bf05bc703c2c": {
      "type": "integer",
      "default": 760,
      "min": 1,
      "description": "循环执行次数。",
      "display_name": "运行轮数",
      "_autoPublished": true
    },
    "v_d6d7ea0c8a134da684e6b392be2825a6": {
      "type": "boolean",
      "description": "点击前重新截图验证匹配是否仍在，默认 true",
      "display_name": "重新校验",
      "default": true,
      "_autoPublished": true
    }
  },
  "variables": {
    "v_10a5b9e6f0724cae9fddae2b177a86af": {
      "type": "integer",
      "default": 760,
      "min": 1,
      "description": "循环执行次数。",
      "display_name": "运行轮数",
      "initial_from": "v_3a3d58354dbf4aeb8a85bf05bc703c2c"
    },
    "v_b8337c03141146eda766b65ef80e0243": {
      "type": "boolean",
      "description": "点击前重新截图验证匹配是否仍在，默认 true",
      "display_name": "重新校验",
      "default": true,
      "initial_from": "v_d6d7ea0c8a134da684e6b392be2825a6"
    }
  },
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "children": [
        "repeat_rounds"
      ],
      "name": "活动副本循环入口"
    },
    {
      "id": "repeat_rounds",
      "type": "sequence",
      "children": [
        "round"
      ],
      "decorators": [
        {
          "type": "repeat",
          "count": {
            "ref": "variables.v_10a5b9e6f0724cae9fddae2b177a86af"
          }
        }
      ],
      "name": "按运行轮数循环"
    },
    {
      "id": "round",
      "type": "sequence",
      "children": [
        "wait_round_state",
        "round_state_selector"
      ],
      "name": "单轮活动副本"
    },
    {
      "id": "wait_round_state",
      "type": "task",
      "action": "vision.detect_state",
      "params": {
        "states": [
          {
            "name": "challenge",
            "template": "assets/templates/souls/souls-challenge.png",
            "roi": [
              1621,
              791,
              299,
              289
            ],
            "threshold": 0.88
          },
          {
            "name": "settlement",
            "template": "assets/templates/task_3-template.png",
            "roi": [
              700,
              950,
              520,
              130
            ],
            "threshold": 0.88
          }
        ],
        "allow_ocr": false
      },
      "decorators": [
        {
          "type": "retry",
          "attempts": 180,
          "delay_seconds": 0.5
        }
      ],
      "name": "识别当前页面状态"
    },
    {
      "id": "round_state_selector",
      "type": "selector",
      "children": [
        "start_round",
        "continue_round"
      ],
      "name": "按当前页面选择动作"
    },
    {
      "id": "start_round",
      "type": "sequence",
      "children": [
        "tap_challenge",
        "wait_battle_end",
        "finish_started_round"
      ],
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "eq": [
              {
                "ref": "nodes.wait_round_state.output.state"
              },
              "challenge"
            ]
          }
        }
      ],
      "name": "处理挑战页"
    },
    {
      "id": "tap_challenge",
      "type": "task",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_round_state.output.match"
        },
        "revalidate": true,
        "verify_gone": true,
        "verify_timeout_seconds": 8,
        "random_offset": 25,
        "disappeared_states": [
          {
            "name": "settlement",
            "template": "assets/templates/task_3-template.png",
            "roi": [
              700,
              950,
              520,
              130
            ],
            "threshold": 0.88
          }
        ],
        "disappeared_state_timeout_seconds": 3,
        "random_interval": [
          0.2,
          0.5
        ]
      },
      "name": "点击挑战按钮"
    },
    {
      "id": "wait_battle_end",
      "type": "task",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/task_3-template.png",
        "present": true,
        "timeout_seconds": 60,
        "roi": [
          700,
          950,
          520,
          130
        ],
        "threshold": 0.88
      },
      "name": "等待挑战结束"
    },
    {
      "id": "finish_started_round",
      "type": "sequence",
      "children": [
        "tap_exit_after_battle",
        "wait_challenge_after_battle"
      ],
      "decorators": [
        {
          "type": "retry",
          "attempts": 5,
          "delay_seconds": 0.8
        }
      ],
      "name": "退出结算页并确认返回"
    },
    {
      "id": "tap_exit_after_battle",
      "type": "task",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_battle_end.output.0"
        },
        "revalidate": {
          "ref": "variables.v_b8337c03141146eda766b65ef80e0243"
        },
        "verify_gone": true,
        "verify_timeout_seconds": 8,
        "random_offset": 25,
        "disappeared_states": [
          {
            "name": "challenge",
            "template": "assets/templates/souls/souls-challenge.png",
            "roi": [
              1621,
              791,
              299,
              289
            ],
            "threshold": 0.88
          }
        ],
        "disappeared_state_timeout_seconds": 3,
        "random_interval": [
          0.2,
          0.7
        ]
      },
      "name": "点击结算页继续"
    },
    {
      "id": "wait_challenge_after_battle",
      "type": "task",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-challenge.png",
        "present": true,
        "timeout_seconds": 15,
        "roi": [
          1621,
          791,
          299,
          289
        ],
        "threshold": 0.88
      },
      "name": "确认已返回挑战页"
    },
    {
      "id": "continue_round",
      "type": "sequence",
      "children": [
        "tap_exit_from_settlement",
        "wait_challenge_after_settlement"
      ],
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "eq": [
              {
                "ref": "nodes.wait_round_state.output.state"
              },
              "settlement"
            ]
          }
        },
        {
          "type": "retry",
          "attempts": 5,
          "delay_seconds": 0.8
        }
      ],
      "name": "处理已停留的结算页"
    },
    {
      "id": "tap_exit_from_settlement",
      "type": "task",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_round_state.output.match"
        },
        "revalidate": true,
        "verify_gone": true,
        "verify_timeout_seconds": 8,
        "random_offset": 25,
        "random_interval": [
          0.2,
          0.7
        ],
        "disappeared_states": [
          {
            "name": "challenge",
            "template": "assets/templates/souls/souls-challenge.png",
            "roi": [
              1621,
              791,
              299,
              289
            ],
            "threshold": 0.88
          }
        ],
        "disappeared_state_timeout_seconds": 3
      },
      "name": "点击停留的结算页继续"
    },
    {
      "id": "wait_challenge_after_settlement",
      "type": "task",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/souls/souls-challenge.png",
        "present": true,
        "timeout_seconds": 15,
        "roi": [
          1621,
          791,
          299,
          289
        ],
        "threshold": 0.88
      },
      "name": "确认结算页已退出"
    }
  ],
