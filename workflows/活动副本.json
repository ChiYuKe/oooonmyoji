{
  "schema_version": 4,
  "id": "activity_loop",
  "version": "4.3.0",
  "description": "活动副本循环：按页面状态处理挑战页和结算页，点击后确认返回挑战页；运行轮数由输入参数控制。",
  "resolution": [
    1920,
    1080
  ],
  "root": "root",
  "inputs": {
    "运行轮数": {
      "type": "integer",
      "default": 9999,
      "min": 1,
      "description": "循环执行次数。"
    }
  },
  "variables": {},
  "nodes": [
    {
      "id": "root",
      "type": "root",
      "children": [
        "repeat_rounds"
      ],
      "name": "活动副本循环入口"
    },
    {
      "id": "repeat_rounds",
      "type": "sequence",
      "children": [
        "round"
      ],
      "decorators": [
        {
          "type": "repeat",
          "count": {
            "ref": "inputs.运行轮数"
          }
        }
      ],
      "name": "按运行轮数循环"
    },
    {
      "id": "round",
      "type": "sequence",
      "children": [
        "wait_round_state",
        "round_state_selector"
      ],
      "name": "单轮活动副本"
    },
    {
      "id": "wait_round_state",
      "type": "task",
      "action": "vision.detect_state",
      "params": {
        "states": [
          {
            "name": "challenge",
            "template": "assets/templates/task_1-template.png",
            "roi": [
              1482,
              731,
              438,
              349
            ],
            "threshold": 0.88
          },
          {
            "name": "settlement",
            "template": "assets/templates/task_3-template.png",
            "roi": [
              700,
              950,
              520,
              130
            ],
            "threshold": 0.88
          }
        ],
        "allow_ocr": false
      },
      "decorators": [
        {
          "type": "retry",
          "attempts": 180,
          "delay_seconds": 0.5
        }
      ],
      "name": "识别当前页面状态"
    },
    {
      "id": "round_state_selector",
      "type": "selector",
      "children": [
        "start_round",
        "continue_round"
      ],
      "name": "按当前页面选择动作"
    },
    {
      "id": "start_round",
      "type": "sequence",
      "children": [
        "tap_challenge",
        "wait_battle_end",
        "finish_started_round"
      ],
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "eq": [
              {
                "ref": "nodes.wait_round_state.output.state"
              },
              "challenge"
            ]
          }
        }
      ],
      "name": "处理挑战页"
    },
    {
      "id": "tap_challenge",
      "type": "task",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_round_state.output.match"
        },
        "revalidate": true,
        "verify_gone": true,
        "verify_timeout_seconds": 8,
        "random_offset": 25,
        "random_interval": [
          0.2,
          0.5
        ]
      },
      "name": "点击挑战按钮"
    },
    {
      "id": "wait_battle_end",
      "type": "task",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/task_3-template.png",
        "present": true,
        "timeout_seconds": 300,
        "roi": [
          700,
          950,
          520,
          130
        ],
        "threshold": 0.88
      },
      "name": "等待挑战结束"
    },
    {
      "id": "finish_started_round",
      "type": "sequence",
      "children": [
        "tap_exit_after_battle",
        "wait_challenge_after_battle"
      ],
      "decorators": [
        {
          "type": "retry",
          "attempts": 5,
          "delay_seconds": 0.8
        }
      ],
      "name": "退出结算页并确认返回"
    },
    {
      "id": "tap_exit_after_battle",
      "type": "task",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_battle_end.output.0"
        },
        "revalidate": true,
        "verify_gone": true,
        "verify_timeout_seconds": 8,
        "random_offset": 25,
        "random_interval": [
          0.2,
          0.7
        ],
        "disappeared_states": [
          {
            "name": "challenge",
            "template": "assets/templates/task_1-template.png",
            "roi": [
              1482,
              731,
              438,
              349
            ],
            "threshold": 0.88
          }
        ],
        "disappeared_state_timeout_seconds": 3
      },
      "name": "点击结算页继续"
    },
    {
      "id": "wait_challenge_after_battle",
      "type": "task",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/task_1-template.png",
        "present": true,
        "timeout_seconds": 15,
        "roi": [
          1482,
          731,
          438,
          349
        ],
        "threshold": 0.88
      },
      "name": "确认已返回挑战页"
    },
    {
      "id": "continue_round",
      "type": "sequence",
      "children": [
        "tap_exit_from_settlement",
        "wait_challenge_after_settlement"
      ],
      "decorators": [
        {
          "type": "condition",
          "expression": {
            "eq": [
              {
                "ref": "nodes.wait_round_state.output.state"
              },
              "settlement"
            ]
          }
        },
        {
          "type": "retry",
          "attempts": 5,
          "delay_seconds": 0.8
        }
      ],
      "name": "处理已停留的结算页"
    },
    {
      "id": "tap_exit_from_settlement",
      "type": "task",
      "action": "input.tap_match",
      "params": {
        "match": {
          "ref": "nodes.wait_round_state.output.match"
        },
        "revalidate": true,
        "verify_gone": true,
        "verify_timeout_seconds": 8,
        "random_offset": 25,
        "random_interval": [
          0.2,
          0.7
        ],
        "disappeared_states": [
          {
            "name": "challenge",
            "template": "assets/templates/task_1-template.png",
            "roi": [
              1482,
              731,
              438,
              349
            ],
            "threshold": 0.88
          }
        ],
        "disappeared_state_timeout_seconds": 3
      },
      "name": "点击停留的结算页继续"
    },
    {
      "id": "wait_challenge_after_settlement",
      "type": "task",
      "action": "vision.wait_template",
      "params": {
        "template": "assets/templates/task_1-template.png",
        "present": true,
        "timeout_seconds": 15,
        "roi": [
          1482,
          731,
          438,
          349
        ],
        "threshold": 0.88
      },
      "name": "确认结算页已退出"
    }
  ],
  "_layout": {
    "root": {
      "x": 643,
      "y": 0
    },
    "repeat_rounds": {
      "x": 643,
      "y": 208
    },
    "round": {
      "x": 643,
      "y": 416
    },
    "wait_round_state": {
      "x": 0,
      "y": 624
    },
    "round_state_selector": {
      "x": 1287,
      "y": 624
    },
    "start_round": {
      "x": 747,
      "y": 832
    },
    "continue_round": {
      "x": 1826,
      "y": 832
    },
    "tap_challenge": {
      "x": 332,
      "y": 1040
    },
    "wait_battle_end": {
      "x": 664,
      "y": 1040
    },
    "finish_started_round": {
      "x": 1162,
      "y": 1040
    },
    "tap_exit_after_battle": {
      "x": 996,
      "y": 1248
    },
    "wait_challenge_after_battle": {
      "x": 1328,
      "y": 1248
    },
    "tap_exit_from_settlement": {
      "x": 1660,
      "y": 1040
    },
    "wait_challenge_after_settlement": {
      "x": 1992,
      "y": 1040
    }
  },
  "_inputParams": {},
  "_variableLinks": {},
  "_variableCards": {}
}
